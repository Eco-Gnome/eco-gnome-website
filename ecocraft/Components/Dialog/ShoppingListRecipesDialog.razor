@using ecocraft.Models
@using ecocraft.Services
@using ecocraft.Components.Utils
@inject LocalizationService LocalizationService

@* Recettes d'un métier ou d'une table de la shopping list (bandeau, fenêtre « Métiers & tables ») : la coche ronde
   ajoute la recette à la liste, verte si elle y est déjà en racine (un clic l'en retire). La fenêtre reste ouverte. *@
<MudDialog Style="min-height: 500px;">
    <TitleContent>
        <MudStack Row AlignItems="AlignItems.Center" Spacing="1">
            <EcoIcon Item="@Item" Size="64" />
            <MudText Typo="Typo.h6">@LocalizationService.GetTranslation(Item as IHasLocalizedName)</MudText>
        </MudStack>
    </TitleContent>
    <DialogContent>
        <MudStack>
            <MudText>@LocalizationService.GetTranslation("RelatedRecipes")</MudText>
            <RecipeList Recipes="@Recipes">
                <RowAction>
                    <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.FlexEnd" Spacing="2">
                        @if (IsOutsideContext(context))
                        {
                            @OutsideTag
                        }
                        @{ var isInList = IsInList(context); }
                        <MudTooltip Text="@LocalizationService.GetTranslation(isInList ? "ShoppingList.RemoveRecipeFromList" : "ShoppingList.AddRecipeToList")">
                            <MudIconButton Icon="@MDIIcons.Filled.CheckCircle"
                                           Color="@(isInList ? Color.Success : Color.Default)"
                                           Size="Size.Small"
                                           Class="pa-0"
                                           Style="@(isInList ? null : "opacity: 0.35")"
                                           OnClick="@(() => ToggleRecipe(context, isInList))"/>
                        </MudTooltip>
                    </MudStack>
                </RowAction>
            </RecipeList>
        </MudStack>
    </DialogContent>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;

    // Un Skill ou un CraftingTable.
    [Parameter, EditorRequired] public required IHasIconName Item { get; set; }
    [Parameter, EditorRequired] public required List<Recipe> Recipes { get; set; }
    [Parameter, EditorRequired] public required Func<Recipe, Task> OnAddRecipe { get; set; }
    [Parameter, EditorRequired] public required Func<Recipe, Task> OnRemoveRecipe { get; set; }
    [Parameter, EditorRequired] public required Func<Recipe, bool> IsInList { get; set; }
    [Parameter, EditorRequired] public required Func<Recipe, bool> IsOutsideContext { get; set; }
    [Parameter, EditorRequired] public required RenderFragment OutsideTag { get; set; }

    // La fenêtre n'est pas dans l'arbre de rendu de la page : elle se redessine elle-même après le changement.
    private async Task ToggleRecipe(Recipe recipe, bool isInList)
    {
        await (isInList ? OnRemoveRecipe(recipe) : OnAddRecipe(recipe));
        StateHasChanged();
    }
}
