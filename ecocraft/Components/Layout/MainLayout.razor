@implements IDisposable
@inherits LayoutComponentBase
@using ecocraft.Services
@inject ContextService ContextService
@inject LocalizationService LocalizationService
@inject NavigationManager Navigation
@inject IDialogService DialogService

<MudThemeProvider Theme="_myDarkTheme" @bind-IsDarkMode="@_isDarkMode"/>
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<title>Eco Gnome - @LocalizationService.GetTranslation("MainLayout.SiteTitle")</title>

<MudLayout>
    <MudAppBar Elevation="2" Class="app-bar">
        <MudIconButton Icon="@MDIIcons.Filled.Menu" Size="Size.Medium" OnClick="() => ToggleMenu()" />

        <Header IsLoadingUserAndServer="_isLoadingUserAndServer" @bind-isDarkMode="_isDarkMode"></Header>
    </MudAppBar>

    <MudDrawer @bind-Open="@_menuOpened" Variant="@DrawerVariant.Mini" OpenMiniOnHover="false" ClipMode="DrawerClipMode.Docked" Elevation="4">
        <NavMenu IsLoadingUserAndServer="_isLoadingUserAndServer" Opened="_menuOpened"/>
    </MudDrawer>

    <MudMainContent Class="mt-16 pa-6">
        @if (!_isLoadingUserAndServer)
        {
            if (ContextService.CurrentUserServer is not null || IsStandalonePage)
            {
                @Body
            }
            else
            {
                <MudText>@LocalizationService.GetTranslation("MainLayout.PleaseJoin")</MudText>
            }
        }
        else
        {
            <MudItem sm="12" class="d-flex justify-center">
                <MudProgressCircular Size="Size.Large" Color="Color.Primary" Indeterminate="true" />
            </MudItem>
        }
    </MudMainContent>
</MudLayout>

@code {
    private bool _isLoadingUserAndServer = true;
    private bool _menuOpened;
    private bool _isDarkMode = true;

    // La page de liaison du mod doit s'afficher même pour un compte qui n'a encore rejoint aucun serveur.
    private bool IsStandalonePage => Navigation.ToBaseRelativePath(Navigation.Uri).StartsWith("link/", StringComparison.OrdinalIgnoreCase);

    private void ToggleMenu()
    {
        _menuOpened = !_menuOpened;
    }

    private readonly MudTheme _myDarkTheme = new()
        {
            // Dark theme, celui utilisé actuellement
            PaletteDark = new PaletteDark()
            {
                Primary = Colors.Blue.Lighten1,
                Secondary = Colors.Orange.Lighten1,
                TextPrimary = "rgba(255,255,255,0.8)",
                TextSecondary = "rgba(255,255,255,0.8)",
                TextDisabled = "rgba(255,255,255,0.8)",
            },

            // Theme troll vert
            PaletteLight = new PaletteLight()
            {
                Black = "#212121",
                Background = "#5a9046",
                Primary = "#f4ffa1",
                Surface = "#304e24",
                DrawerBackground = "#298684",
                DrawerIcon = "#ffffff",
                DrawerText = "#ffffff",
                AppbarBackground = "#298684",
                TableLines = "#ffffff",
                TextPrimary = "#ffffff",
                TextSecondary = "#d0d0d0",
                ActionDefault = "#adadb1",
                ActionDisabled = "rgba(255,255,255, 0.26)",
                ActionDisabledBackground = "rgba(255,255,255, 0.12)",
            },
        };

    protected override void OnInitialized()
    {
        ContextService.OnContextChanged += StateHasChanged;
    }

    public void Dispose()
    {
        ContextService.OnContextChanged -= StateHasChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        await ContextService.InitializeUserContext();
        await ContextService.InitializeServerContext();
        _isLoadingUserAndServer = false;
        StateHasChanged();
        // No idea why, very strange, but without this double StateHasChanged, PriceCalculator load fast, but Server-Management page does not, and requires a new StateHasChanged to update the header
        // Definitively linked to MudSelect not updating directly
        StateHasChanged();

        if (ContextService.PendingDiscordSwitch is { } pending) await AskDiscordSwitch(pending);
    }

    // Le Discord est déjà rattaché à un autre compte : basculer rend le compte de ce navigateur inaccessible d'ici.
    private async Task AskDiscordSwitch(DiscordSwitch pending)
    {
        var linked = System.Net.WebUtility.HtmlEncode(pending.LinkedPseudo);
        var current = System.Net.WebUtility.HtmlEncode(pending.CurrentPseudo);
        // Placeholders are filled in order: {linked} appears twice before {current}.
        var message = new MarkupString(LocalizationService.GetTranslation("Discord.SwitchWarning", linked, linked, current));
        var switchAccount = await DialogService.ShowMessageBoxAsync(
            LocalizationService.GetTranslation("Discord.SwitchTitle"),
            message,
            yesText: LocalizationService.GetTranslation("Discord.SwitchConfirm"),
            noText: LocalizationService.GetTranslation("Discord.SwitchCancel"),
            options: new DialogOptions { BackdropClick = false, CloseOnEscapeKey = false });

        var here = "/" + Navigation.ToBaseRelativePath(Navigation.Uri);
        if (switchAccount == true)
        {
            await ContextService.ConfirmDiscordSwitch();
            Navigation.NavigateTo(here, forceLoad: true);
        }
        else
        {
            // Rester : on ferme la session Discord, sinon la question reviendrait à chaque visite.
            Navigation.NavigateTo($"/auth/logout?returnUrl={Uri.EscapeDataString(here)}", forceLoad: true);
        }
    }
}
