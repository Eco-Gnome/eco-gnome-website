    private void ToggleGroup(string key)
    {
        if (!string.IsNullOrWhiteSpace(_objectSearch)) return; // pendant une recherche, tout est déplié d'office
        if (!_expandedGroups.Add(key)) _expandedGroups.Remove(key);
    }

    private sealed record ObjectGroup(string Key, string Label, string? Color, bool HasHeader, List<ClientObject> Items, List<ObjectGroup>? Children = null);

    // Regroupement de la palette : portes par tier, sinon par catégorie housing ; les items sans catégorie vont
    // dans « Divers ». Les en-têtes n'apparaissent que si la liste a au moins un vrai groupe.
    private IEnumerable<ObjectGroup> GroupObjects(string group, bool byTier, List<ClientObject> objects)
    {
        var misc = LocalizationService.GetTranslation("BuildingPlanner.Catalog.Misc");
        if (byTier)
        {
            return objects.GroupBy(o => o.Tier).OrderBy(g => g.Key ?? int.MaxValue)
                .Select(g => new ObjectGroup($"{group}-T{g.Key}", g.Key is { } t ? $"T{t}" : misc, null, true, g.OrderBy(o => o.Label).ToList()));
        }
        var showHeaders = objects.Any(o => o.HousingCategory is not null);
        return objects.GroupBy(o => o.HousingCategory ?? "").OrderBy(g => g.Key.Length == 0 ? 1 : 0).ThenBy(g => g.Key)
            .Select(g => new ObjectGroup($"{group}-{g.Key}", g.Key.Length > 0 ? g.Key : misc,
                g.Key.Length > 0 ? _clientCatalog!.Categories.FirstOrDefault(c => c.Name == g.Key)?.Color ?? "aaaaaa" : null,
                showHeaders, g.OrderBy(o => o.Label).ToList()));
    }

    // Liste du catalogue : les types de pièce (catégories housing : Cultural, Decoration, Lighting…) d'abord,
    // puis Tables, Portes (sous-groupes par tier) et Autres.
    private IEnumerable<ObjectGroup> GroupAllObjects(List<ClientObject> objects)
    {
        foreach (var g in GroupObjects("all-housing", false, objects.Where(o => o.Group == "housing").ToList()))
            yield return g with { HasHeader = true };
        var tables = objects.Where(o => o.Group == "table").OrderBy(o => o.Label).ToList();
        if (tables.Count > 0) yield return new ObjectGroup("all-table", LocalizationService.GetTranslation("BuildingPlanner.Catalog.Tables"), null, true, tables);
        var doors = objects.Where(o => o.Group == "door").ToList();
        if (doors.Count > 0) yield return new ObjectGroup("all-door", LocalizationService.GetTranslation("BuildingPlanner.Catalog.Doors"), null, true, [],
            GroupObjects("all-door", true, doors).ToList());
        var others = objects.Where(o => o.Group == "other").OrderBy(o => o.Label).ToList();
        if (others.Count > 0) yield return new ObjectGroup("all-other", LocalizationService.GetTranslation("BuildingPlanner.Catalog.Others"), null, true, others);
    }

    private RenderFragment RenderObjectList() => __builder =>
    {
        var searching = !string.IsNullOrWhiteSpace(_objectSearch);
        var filtered = _clientCatalog!.Objects.Where(o => !searching || o.Label.Contains(_objectSearch, StringComparison.OrdinalIgnoreCase) || o.Name.Contains(_objectSearch, StringComparison.OrdinalIgnoreCase)).ToList();
        <MudTextField T="string" Value="@_objectSearch" ValueChanged="@(v => _objectSearch = v)" Immediate="true" Clearable="true" Dense="true" Margin="Margin.Dense" Variant="Variant.Outlined"
                      Placeholder="@LocalizationService.GetTranslation("Search")" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Class="mb-1"/>
        <div class="bp-object-list">
            @foreach (var g in GroupAllObjects(filtered))
            {
                @RenderGroup(g, searching)
            }
            @if (filtered.Count == 0)
            {
                <MudText Typo="Typo.caption" Class="pa-2">@LocalizationService.GetTranslation("BuildingPlanner.Catalog.Empty")</MudText>
            }
        </div>
    };

    private RenderFragment RenderGroup(ObjectGroup g, bool searching) => __builder =>
    {
        var expanded = !g.HasHeader || searching || _expandedGroups.Contains(g.Key);
        @if (g.HasHeader)
        {
            <div class="bp-group-title" style="@(g.Color is null ? null : $"color: #{g.Color}")" @onclick="@(() => ToggleGroup(g.Key))">
                <MudIcon Icon="@(expanded ? Icons.Material.Filled.ExpandMore : Icons.Material.Filled.ChevronRight)" Size="Size.Small"/>
                <span>@g.Label</span>
                <span class="bp-group-count">@(g.Children?.Sum(c => c.Items.Count) ?? g.Items.Count)</span>
            </div>
        }
        @if (expanded)
        {
            @foreach (var o in g.Items)
            {
                <div class="@("bp-object-item" + (_objectType == o.Name ? " selected" : ""))" @onclick="@(() => SelectObjectType(o))" title="@o.Name">
                    <MudImage Src="@IconUrl(o.Name)" FallbackSrc="/assets/eco-icons/EmptyIcon.png" Width="28" Height="28"/>
                    <div class="bp-object-text">
                        <div class="bp-object-label">@o.Label</div>
                        <div class="bp-object-meta">
                            <span title="@LocalizationService.GetTranslation("BuildingPlanner.Catalog.SizeHint")">@o.Size[0]×@o.Size[1]×@o.Size[2]</span>
                            @if (o.RequiredTier is { } rt) { <span title="@LocalizationService.GetTranslation("BuildingPlanner.Catalog.RequiredTierHint")">T≥@rt.ToString("0.#")</span> }
                            @if (o.RequiredVolume > 0) { <span title="@LocalizationService.GetTranslation("BuildingPlanner.Catalog.RequiredVolumeHint")">@(o.RequiredVolume) m³</span> }
                            @if (o.HousingValue is { } hv && hv > 0) { <span title="@LocalizationService.GetTranslation("BuildingPlanner.Catalog.HousingValueHint")">+@hv.ToString("0.#")</span> }
                            @if (o.Tier is { } t) { <span title="@LocalizationService.GetTranslation("BuildingPlanner.Catalog.TierHint")">T@(t)</span> }
                            @if (o.HasTableSurface) { <span title="@LocalizationService.GetTranslation("BuildingPlanner.Catalog.SurfaceHint")">▭</span> }
                            @if (o.CanBeOnSurface) { <span title="@LocalizationService.GetTranslation("BuildingPlanner.Catalog.OnSurfaceHint")">▴</span> }
                        </div>
                    </div>
                </div>
            }
            @if (g.Children is not null)
            {
                <div class="bp-group-children">
                    @foreach (var child in g.Children)
                    {
                        @RenderGroup(child, searching)
                    }
                </div>
            }
        }
    };

    // ---- Plans ----------------------------------------------------------------------------------------------

    private async Task NewPlanAsync()
    {
        if (_dirty && !await ConfirmDiscardAsync()) return;
        _savedPlan = null;
        await RememberLastPlanAsync(null);
        await Js("clearDraft");
        await JS.InvokeAsync<bool>("ecoBuildingPlanner.setPlan", _containerId, PlanDocumentJson.Serialize(PlanDocument.Empty()), true);
        _backgroundImage = null;
        await Js("setBackgroundImage", (string?)null);
        Navigation.NavigateTo("/building-planner", replace: true);
    }

    private async Task ImportJsonAsync()
    {
        if (_dirty && !await ConfirmDiscardAsync()) return;
        await Js("pickPlanFile");
    }

    private async Task OpenPlanAsync()
    {
        var plans = await BuildingPlannerService.ListPlansAsync();
        var parameters = new DialogParameters<BuildingPlanListDialog> { { d => d.Plans, plans } };
        var dialog = await DialogService.ShowAsync<BuildingPlanListDialog>(LocalizationService.GetTranslation("BuildingPlanner.Plan.Open"), parameters, new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true });
        var result = await dialog.Result;
        if (_savedPlan is not null && plans.All(p => p.Id != _savedPlan.Id))
        {
            // Le plan courant a été supprimé depuis le dialogue : il redevient un brouillon non sauvegardé.
            _savedPlan = null;
            await RememberLastPlanAsync(null);
            Navigation.NavigateTo("/building-planner", replace: true);
            await Js("markDirty");
        }
        if (result is null || result.Canceled || result.Data is not BuildingPlan chosen) return;
        if (_dirty && !await ConfirmDiscardAsync()) return;

        var full = await BuildingPlannerService.LoadPlanAsync(chosen.Id);
        if (full is null) return;
        _savedPlan = full;
        await RememberLastPlanAsync(full.Id);
        await JS.InvokeAsync<bool>("ecoBuildingPlanner.setPlan", _containerId, full.Document, true);
        _backgroundImage = full.BackgroundImage;
        await Js("setBackgroundImage", _backgroundImage);
        Navigation.NavigateTo($"/building-planner?id={full.Id}", replace: true);
    }

    // Dernier plan ouvert, mémorisé par serveur pour le rouvrir quand on revient sur la page sans ?id=.
    private string LastPlanKey => $"BuildingPlanner.LastPlanId.{ContextService.CurrentServer?.Id}";

    private Task RememberLastPlanAsync(Guid? id) => id is { } planId ? LocalStorageService.AddItem(LastPlanKey, planId.ToString()) : LocalStorageService.RemoveItem(LastPlanKey);

    private string PlanMenuLabel => (string.IsNullOrWhiteSpace(_document.Name) ? LocalizationService.GetTranslation("BuildingPlanner.Plan.Untitled") : _document.Name) + (_dirty ? " *" : "");

    private async Task RenameAsync()
    {
        var parameters = new DialogParameters<BuildingPlanSaveDialog> { { d => d.Name, _document.Name } };
        var dialog = await DialogService.ShowAsync<BuildingPlanSaveDialog>(LocalizationService.GetTranslation("BuildingPlanner.Plan.Rename"), parameters, new DialogOptions { MaxWidth = MaxWidth.ExtraSmall, FullWidth = true });
        var result = await dialog.Result;
        if (result is null || result.Canceled || result.Data is not string newName || string.IsNullOrWhiteSpace(newName)) return;
        newName = newName.Trim();
        _document.Name = newName;
        await Js("setName", newName);

        // Plan deja sauvegarde : on persiste le nouveau nom (et l'etat courant) immediatement.
        if (_savedPlan is not null && BuildingPlannerService.OwnsPlan(_savedPlan))
        {
            var latest = await JS.InvokeAsync<string?>("ecoBuildingPlanner.getPlan", _containerId);
            var doc = PlanDocumentJson.TryParse(latest) ?? _document;
            doc.Name = newName;
            _savedPlan = await BuildingPlannerService.SavePlanAsync(_savedPlan, newName, doc, _backgroundImage);
            _document = doc;
            await Js("markSaved");
        }
    }

    private async Task SaveAsync(bool saveAs)
    {
        var name = _document.Name;
        if (saveAs || _savedPlan is null || string.IsNullOrWhiteSpace(name))
        {
            var proposed = string.IsNullOrWhiteSpace(name) ? LocalizationService.GetTranslation("BuildingPlanner.Plan.Untitled") : name;
            if (saveAs) proposed += LocalizationService.GetTranslation("DataContext.CopySuffix");
            var parameters = new DialogParameters<BuildingPlanSaveDialog> { { d => d.Name, proposed } };
            var dialog = await DialogService.ShowAsync<BuildingPlanSaveDialog>(LocalizationService.GetTranslation(saveAs ? "BuildingPlanner.Plan.Duplicate" : "BuildingPlanner.Plan.Save"), parameters, new DialogOptions { MaxWidth = MaxWidth.ExtraSmall, FullWidth = true });
            var result = await dialog.Result;
            if (result is null || result.Canceled || result.Data is not string chosenName || string.IsNullOrWhiteSpace(chosenName)) return;
            name = chosenName.Trim();
        }

        var latest = await JS.InvokeAsync<string?>("ecoBuildingPlanner.getPlan", _containerId);
        var doc = PlanDocumentJson.TryParse(latest) ?? _document;
        _savedPlan = await BuildingPlannerService.SavePlanAsync(saveAs ? null : _savedPlan, name, doc, _backgroundImage);
        await RememberLastPlanAsync(_savedPlan.Id);
        _document = doc;
        await Js("setName", name);
        await Js("markSaved");
        Snackbar.Add(LocalizationService.GetTranslation("BuildingPlanner.Snackbar.Saved", name), Severity.Success);
        Navigation.NavigateTo($"/building-planner?id={_savedPlan.Id}", replace: true);
    }

    private async Task ShareAsync()
    {
        var latest = await JS.InvokeAsync<string?>("ecoBuildingPlanner.getPlan", _containerId);
        var doc = PlanDocumentJson.TryParse(latest) ?? _document;
        var (url, needsSave) = BuildingPlannerService.BuildShareUrl(Navigation.BaseUri, doc, _savedPlan?.Id);
        if (needsSave)
        {
            Snackbar.Add(LocalizationService.GetTranslation("BuildingPlanner.Snackbar.ShareNeedsSave"), Severity.Info);
            await SaveAsync(false);
            if (_savedPlan is null) return;
            (url, _) = BuildingPlannerService.BuildShareUrl(Navigation.BaseUri, doc, _savedPlan.Id);
        }
        if (url is null) return;
        var parameters = new DialogParameters<BuildingPlanShareDialog> { { d => d.Url, url } };
        await DialogService.ShowAsync<BuildingPlanShareDialog>(LocalizationService.GetTranslation("BuildingPlanner.Plan.Share"), parameters, new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true });
    }

    private async Task ResizeAsync()
    {
        var parameters = new DialogParameters<BuildingPlanResizeDialog> { { d => d.Width, _document.Grid.Width }, { d => d.Depth, _document.Grid.Depth } };
        var dialog = await DialogService.ShowAsync<BuildingPlanResizeDialog>(LocalizationService.GetTranslation("BuildingPlanner.Plan.Resize"), parameters, new DialogOptions { MaxWidth = MaxWidth.ExtraSmall, FullWidth = true });
        var result = await dialog.Result;
        if (result is null || result.Canceled || result.Data is not (int width, int depth)) return;
        await Js("resizePlan", width, depth);
    }

    private async Task<bool> ConfirmDiscardAsync()
    {
        try { return await JS.InvokeAsync<bool>("confirm", LocalizationService.GetTranslation("BuildingPlanner.ConfirmDiscard")); }
        catch (JSDisconnectedException) { return true; }
    }

    private async ValueTask OnLocationChanging(LocationChangingContext context)
    {
        if (!_dirty) return;
        if (context.TargetLocation.Contains("/building-planner", StringComparison.OrdinalIgnoreCase)) return;
        if (!await ConfirmDiscardAsync()) context.PreventNavigation();
    }

    private void OnContextChanged()
    {
        _ = InvokeAsync(async () =>
        {
            if (_jsInitialized)
            {
                try { await JS.InvokeVoidAsync("ecoBuildingPlanner.dispose", _containerId); } catch (JSDisconnectedException) { }
                _jsInitialized = false;
            }
            _analysis = null;
            _savedPlan = null;
            await LoadAsync();
        });
    }

    public async ValueTask DisposeAsync()
    {
        ContextService.OnContextChanged -= OnContextChanged;
        _locationChangingRegistration?.Dispose();
        _analyzeCts?.Cancel();
        _analyzeCts?.Dispose();
        if (_jsInitialized)
        {
            try { await JS.InvokeVoidAsync("ecoBuildingPlanner.dispose", _containerId); }
            catch (JSDisconnectedException) { }
        }
        _selfRef?.Dispose();
    }
}
