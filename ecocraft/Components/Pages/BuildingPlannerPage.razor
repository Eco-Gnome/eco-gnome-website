@page "/building-planner"
@implements IAsyncDisposable
@using System.Text.Json
@using ecocraft.BuildingPlanner
@using ecocraft.BuildingPlanner.Model
@using ecocraft.Components.Dialog
@using ecocraft.Components.Utils
@using ecocraft.Models
@using ecocraft.Services
@using ecocraft.Services.DbServices
@using Microsoft.AspNetCore.Components.Routing
@using Microsoft.AspNetCore.WebUtilities
@inject ContextService ContextService
@inject LocalizationService LocalizationService
@inject BuildingPlannerService BuildingPlannerService
@inject EconomyViewerService EconomyViewerService
@inject ServerDbService ServerDbService
@inject DataContextDbService DataContextDbService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject LocalStorageService LocalStorageService

<PageTitle>@LocalizationService.GetTranslation("BuildingPlanner.Title") - Eco Gnome</PageTitle>

@if (!BuildingPlannerService.HasBuildingData)
{
    <MudAlert Severity="Severity.Warning"><MudMarkdown Value="@LocalizationService.GetTranslation("BuildingPlanner.NoData")" /></MudAlert>
}
else if (_loading)
{
    <MudStack AlignItems="AlignItems.Center" Class="pa-8">
        <MudProgressCircular Indeterminate="true" Color="Color.Primary"/>
    </MudStack>
}
else
{
    <div class="bp-page">
        <MudPaper Class="bp-toolbar pa-1" Elevation="1">
            <MudStack Row AlignItems="AlignItems.Center" Spacing="1" Wrap="Wrap.Wrap">
                <MudMenu Label="@PlanMenuLabel" Variant="Variant.Outlined" Size="Size.Small" EndIcon="@Icons.Material.Filled.KeyboardArrowDown" Dense="true">
                    <MudMenuItem Icon="@Icons.Material.Filled.Add" OnClick="NewPlanAsync">@LocalizationService.GetTranslation("BuildingPlanner.Plan.New")</MudMenuItem>
                    <MudMenuItem Icon="@MDIIcons.Filled.FolderOpen" OnClick="OpenPlanAsync">@LocalizationService.GetTranslation("BuildingPlanner.Plan.Open")</MudMenuItem>
                    <MudMenuItem Icon="@MDIIcons.Filled.ContentSave" OnClick="@(() => SaveAsync(false))">@LocalizationService.GetTranslation("BuildingPlanner.Plan.Save")</MudMenuItem>
                    @if (_savedPlan is not null)
                    {
                        <MudMenuItem Icon="@MDIIcons.Filled.ContentDuplicate" OnClick="@(() => SaveAsync(true))">@LocalizationService.GetTranslation("BuildingPlanner.Plan.Duplicate")</MudMenuItem>
                    }
                    <MudMenuItem Icon="@MDIIcons.Filled.RenameBox" OnClick="RenameAsync">@LocalizationService.GetTranslation("BuildingPlanner.Plan.Rename")</MudMenuItem>
                    <MudMenuItem Icon="@MDIIcons.Filled.ShareVariant" OnClick="ShareAsync">@LocalizationService.GetTranslation("BuildingPlanner.Plan.Share")</MudMenuItem>
                    <MudMenuItem Icon="@MDIIcons.Filled.Image" OnClick="@(() => Js("exportPng", string.IsNullOrWhiteSpace(_document.Name) ? "building-plan" : _document.Name))">@LocalizationService.GetTranslation("BuildingPlanner.Plan.ExportPng")</MudMenuItem>
                    <MudMenuItem Icon="@MDIIcons.Filled.FileExport" OnClick="@(() => Js("exportJson", string.IsNullOrWhiteSpace(_document.Name) ? "building-plan" : _document.Name))">@LocalizationService.GetTranslation("BuildingPlanner.Plan.ExportJson")</MudMenuItem>
                    <MudMenuItem Icon="@MDIIcons.Filled.FileImport" OnClick="ImportJsonAsync">@LocalizationService.GetTranslation("BuildingPlanner.Plan.ImportJson")</MudMenuItem>
                    <MudMenuItem Icon="@MDIIcons.Filled.Resize" OnClick="ResizeAsync">@LocalizationService.GetTranslation("BuildingPlanner.Plan.Resize")</MudMenuItem>
                </MudMenu>

                <MudDivider Vertical="true" FlexItem="true"/>

                @* Mode : maison (pièces, housing) ou architecture (formes 3D, nomenclature) — stocké dans le document — ou rendu 3D
                   (état de vue, lecture seule : le document garde son mode en dessous). *@
                <MudToggleGroup T="string" Value="@(_view3d ? View3d : _document.Mode)" ValueChanged="SetModeAsync" SelectionMode="SelectionMode.SingleSelection" Color="Color.Primary" Size="Size.Small" Outlined="true" CheckMark="false" Class="bp-mode">
                    <MudToggleItem T="string" Value="@PlanMode.House"><MudTooltip Text="@LocalizationService.GetTranslation("BuildingPlanner.Mode.house")"><MudIcon Icon="@Icons.Material.Filled.Home" Size="Size.Small"/></MudTooltip></MudToggleItem>
                    <MudToggleItem T="string" Value="@PlanMode.Architecture"><MudTooltip Text="@LocalizationService.GetTranslation("BuildingPlanner.Mode.architecture")"><MudIcon Icon="@MDIIcons.Filled.OfficeBuilding" Size="Size.Small"/></MudTooltip></MudToggleItem>
                    <MudToggleItem T="string" Value="@View3d"><MudTooltip Text="@LocalizationService.GetTranslation("BuildingPlanner.Mode.view3d")"><MudIcon Icon="@Icons.Material.Filled.ViewInAr" Size="Size.Small"/></MudTooltip></MudToggleItem>
                </MudToggleGroup>

                @if (!_view3d)
                {
                <MudToggleGroup T="string" Value="@_tool" ValueChanged="SetTool" SelectionMode="SelectionMode.SingleSelection" Color="Color.Primary" Size="Size.Small" Outlined="true" CheckMark="false" Class="bp-tools">
                    @foreach (var tool in Tools)
                    {
                        @* L'ouverture au rez-de-chaussée n'est pas réellement Disabled (un bouton disabled ne reçoit
                           plus d'événements souris, donc plus de tooltip) : on la grise et SetTool ignore le clic. *@
                        var disabled = tool.Key == "hole" && _level == 0;
                        <MudToggleItem T="string" Value="@tool.Key" Class="@(disabled ? "bp-tool-off" : null)">
                            <MudTooltip Text="@LocalizationService.GetTranslation(disabled ? "BuildingPlanner.Tool.holeDisabled" : $"BuildingPlanner.Tool.{tool.Key}")">
                                <MudIcon Icon="@tool.Icon" Size="Size.Small"/>
                            </MudTooltip>
                        </MudToggleItem>
                    }
                </MudToggleGroup>

                <MudSelect T="string" Value="@_material" ValueChanged="OnMaterialChanged" Dense="true" Margin="Margin.Dense" Variant="Variant.Outlined"
                           Label="@LocalizationService.GetTranslation("BuildingPlanner.Material")" Style="min-width: 220px; max-width: 260px;">
                    @foreach (var m in _clientCatalog!.Materials)
                    {
                        <MudSelectItem T="string" Value="@m.Name">@MaterialItem(m)</MudSelectItem>
                    }
                </MudSelect>
                }

                @if (IsArch || _view3d)
                {
                    <MudDivider Vertical="true" FlexItem="true"/>
                    @* Couche z affichée / éditée (le curseur de la bande d'élévation fait la même chose). *@
                    <div class="bp-layer-chip">
                        <MudIcon Icon="@MDIIcons.Filled.Layers" Size="Size.Small"/>
                        <span>@LocalizationService.GetTranslation("BuildingPlanner.Layer.Label", _layer.ToString(), _layerCount.ToString())</span>
                        <MudIconButton Icon="@Icons.Material.Filled.KeyboardArrowUp" Size="Size.Small" Title="@LocalizationService.GetTranslation("BuildingPlanner.Layer.Up")" OnClick="@(() => Js("setLayer", _layer + 1))"/>
                        <MudIconButton Icon="@Icons.Material.Filled.KeyboardArrowDown" Size="Size.Small" Title="@LocalizationService.GetTranslation("BuildingPlanner.Layer.Down")" OnClick="@(() => Js("setLayer", _layer - 1))"/>
                        @if (_view3d)
                        {
                            @* Rendu 3D : masquer tout ce qui est au-dessus de la couche pour voir l'intérieur. *@
                            <MudIconButton Icon="@MDIIcons.Filled.ArrowCollapseDown" Size="Size.Small" Class="@(_cap ? "bp-on" : null)" Title="@LocalizationService.GetTranslation("BuildingPlanner.View3d.Cap")" OnClick="@(() => Js("setView3dCap", !_cap))"/>
                        }
                    </div>
                }
                else
                {
                <MudTooltip Text="@LocalizationService.GetTranslation("BuildingPlanner.Rotate")">
                    <MudButton Size="Size.Small" Variant="Variant.Outlined" StartIcon="@MDIIcons.Filled.RotateRight" OnClick="RotateAsync">r@(_rotation)</MudButton>
                </MudTooltip>

                <MudDivider Vertical="true" FlexItem="true"/>

                <MudMenu Label="@LevelLabel(_level)" Variant="Variant.Outlined" Size="Size.Small" StartIcon="@MDIIcons.Filled.Layers" EndIcon="@Icons.Material.Filled.KeyboardArrowDown" Dense="true">
                    @for (var i = _document.Levels.Count - 1; i >= 0; i--)
                    {
                        var k = i;
                        <MudMenuItem Icon="@(k == _level ? Icons.Material.Filled.RadioButtonChecked : Icons.Material.Filled.RadioButtonUnchecked)" OnClick="@(() => Js("setLevel", k))">
                            <div class="d-flex align-center" style="min-width: 240px; gap: 2px;">
                                <span class="mr-auto">@LevelLabel(k) (h@(_document.LevelHeight(k)))</span>
                                @* stopPropagation : les icônes n'activent pas l'item (pas de changement de niveau) et laissent le menu ouvert *@
                                <span @onclick:stopPropagation="true" class="d-flex">
                                    <MudIconButton Icon="@Icons.Material.Filled.ArrowUpward" Size="Size.Small" Title="@LocalizationService.GetTranslation("BuildingPlanner.Level.MoveUp")" Disabled="@(k == _document.Levels.Count - 1)" OnClick="@(() => Js("moveLevel", k, k + 1))"/>
                                    <MudIconButton Icon="@Icons.Material.Filled.ArrowDownward" Size="Size.Small" Title="@LocalizationService.GetTranslation("BuildingPlanner.Level.MoveDown")" Disabled="@(k == 0)" OnClick="@(() => Js("moveLevel", k, k - 1))"/>
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Title="@LocalizationService.GetTranslation("BuildingPlanner.Level.Remove")" Disabled="@(_document.Levels.Count <= 1)" OnClick="@(() => Js("removeLevel", k))"/>
                                </span>
                            </div>
                        </MudMenuItem>
                    }
                    <MudDivider/>
                    <MudMenuItem Icon="@Icons.Material.Filled.Add" Disabled="@(_document.Levels.Count >= PlanValidator.MaxLevels)" OnClick="@(() => Js("addLevel"))">@LocalizationService.GetTranslation("BuildingPlanner.Level.Add")</MudMenuItem>
                    <MudMenuItem Icon="@Icons.Material.Filled.Add" Disabled="@(_document.Levels.Count >= PlanValidator.MaxLevels)" OnClick="@(() => Js("addBasement"))">@LocalizationService.GetTranslation("BuildingPlanner.Level.AddBasement")</MudMenuItem>
                    <MudMenuItem Icon="@MDIIcons.Filled.ContentCopy" Disabled="@(_level == 0)" OnClick="@(() => Js("copyWallsFromBelow"))">@LocalizationService.GetTranslation("BuildingPlanner.Level.CopyWallsFromBelow")</MudMenuItem>
                    <MudMenuItem Icon="@MDIIcons.Filled.ContentCopy" Disabled="@(_level >= _document.Levels.Count - 1)" OnClick="@(() => Js("copyWallsFromAbove"))">@LocalizationService.GetTranslation("BuildingPlanner.Level.CopyWallsFromAbove")</MudMenuItem>
                    <MudMenuItem Icon="@MDIIcons.Filled.Pencil" OnClick="EditLevelAsync">@LocalizationService.GetTranslation("BuildingPlanner.Level.Edit")</MudMenuItem>
                    <MudMenuItem Icon="@Icons.Material.Filled.AutoFixHigh" OnClick="@(() => DetectLevelsAsync(false))">@LocalizationService.GetTranslation("BuildingPlanner.Level.Detect")</MudMenuItem>
                </MudMenu>
                @if (_level > 0 || _level + 1 < _document.Levels.Count)
                {
                    <MudTooltip Placement="Placement.Bottom">
                        <ChildContent>
                            <MudIcon Icon="@MDIIcons.Outline.Information" Color="Color.Info" Size="Size.Small" Class="d-flex align-center"/>
                        </ChildContent>
                        <TooltipContent>
                            <div class="bp-legend">
                                @if (_level > 0)
                                {
                                    <span><i class="bp-swatch bp-swatch-slab"></i>@LocalizationService.GetTranslation("BuildingPlanner.Legend.Slab")</span>
                                    <span><i class="bp-swatch bp-swatch-low"></i>@LocalizationService.GetTranslation("BuildingPlanner.Legend.LowCeiling")</span>
                                    <span><i class="bp-swatch bp-swatch-missing"></i>@LocalizationService.GetTranslation("BuildingPlanner.Legend.Missing")</span>
                                    <span><i class="bp-swatch bp-swatch-hole"></i>@LocalizationService.GetTranslation("BuildingPlanner.Legend.Hole")</span>
                                    <span><i class="bp-swatch bp-swatch-watermark"></i>@LocalizationService.GetTranslation("BuildingPlanner.Legend.Watermark")</span>
                                }
                                @if (_level + 1 < _document.Levels.Count)
                                {
                                    <span><i class="bp-swatch bp-swatch-hole-above"></i>@LocalizationService.GetTranslation("BuildingPlanner.Legend.HoleAbove")</span>
                                }
                            </div>
                        </TooltipContent>
                    </MudTooltip>
                }
                }

                <MudTooltip Text="@LocalizationService.GetTranslation("BuildingPlanner.WipTooltip")" Placement="Placement.Bottom">
                    <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Text" Icon="@Icons.Material.Filled.Construction">@LocalizationService.GetTranslation("BuildingPlanner.Wip")</MudChip>
                </MudTooltip>

                <MudSpacer/>

                @* Bandeau housing + état des avertissements, toujours visibles ; un clic ouvre le volet correspondant. *@
                <div class="bp-housing-block">
                    @if (!IsArch)
                    {
                        <div class="bp-housing-score" @onclick="@(() => SetRightPanelAsync("housing"))">
                            <MudIcon Icon="@Icons.Material.Filled.Home" Class="bp-housing-icon"/>
                            <span class="bp-housing-value">@((_analysis?.Housing?.Total ?? 0f).ToString("0.00"))</span>
                            <span class="bp-housing-label">@PerDayLines.First<br/>@PerDayLines.Second · ×@((_analysis?.Housing?.OccupancyMultiplier ?? 1f).ToString("0.##"))</span>
                        </div>
                        <i class="bp-vsep"></i>
                    }
                    <div class="@("bp-status-chip " + StatusClass)" @onclick="@(() => SetRightPanelAsync("issues"))">
                        <MudIcon Icon="@(ErrorCount > 0 ? Icons.Material.Filled.Error : WarningCount > 0 ? Icons.Material.Filled.Warning : Icons.Material.Filled.Check)"/>
                        <span>@StatusText</span>
                    </div>
                </div>

                @* Réglages du plan : les champs écrivent dans le document via JS comme avant (setDefaults / setAnalysisOptions). *@
                <div class="bp-settings-anchor">
                    @* Plafond par défaut vide = toutes les pièces fuient : le bouton passe en état « à faire » jusqu'au choix. *@
                    <div class="@("bp-settings-btn" + (CeilingMissing ? " todo" : ""))" @onclick="@(() => _settingsOpen = !_settingsOpen)">
                        <MudIcon Icon="@Icons.Material.Filled.Settings" Class="bp-settings-icon"/>
                        @if (CeilingMissing)
                        {
                            <i class="bp-settings-dot"></i>
                        }
                        <span class="bp-settings-title">@LocalizationService.GetTranslation("BuildingPlanner.Settings.Title")</span>
                        <i class="bp-vsep bp-vsep-sm"></i>
                        <span class="bp-settings-summary">@(IsArch ? LocalizationService.GetTranslation("BuildingPlanner.Settings.ArchSummary", _document.Architecture.Height.ToString()) : CeilingMissing ? LocalizationService.GetTranslation("BuildingPlanner.Settings.CeilingTodo") : LocalizationService.GetTranslation("BuildingPlanner.Settings.Summary", _document.Defaults.WallHeight.ToString(), _document.Analysis.Residents.ToString()))</span>
                        <MudIcon Icon="@Icons.Material.Filled.ArrowDropDown" Class="bp-settings-caret"/>
                    </div>
                    <MudOverlay Visible="_settingsOpen" VisibleChanged="@(v => _settingsOpen = v)" AutoClose="true" LockScroll="false"/>
                    @* Le Class d'un MudPopover téléporté n'est pas atteignable par le CSS scoped : largeur/fond en Style, le reste sur le div intérieur. *@
                    <MudPopover Open="_settingsOpen" AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight" Elevation="8" Style="width: 640px; background: #3a3b46; border-radius: 6px;">
                        <div class="bp-settings">
                            <div class="bp-settings-head">
                                <span class="bp-settings-heading">@LocalizationService.GetTranslation("BuildingPlanner.Settings.Title")</span>
                                <span class="bp-settings-help">@LocalizationService.GetTranslation("BuildingPlanner.Settings.Help")</span>
                            </div>
                            @if (IsArch)
                            {
                                <div class="bp-settings-section">@LocalizationService.GetTranslation("BuildingPlanner.Settings.Building")</div>
                                <div class="bp-settings-grid bp-settings-grid-3">
                                    <MudNumericField T="int" Value="@_document.Architecture.Height" ValueChanged="OnArchHeightChanged" Min="1" Max="@PlanValidator.MaxArchitectureHeight" Dense="true" Margin="Margin.Dense" Variant="Variant.Outlined"
                                                     Label="@LocalizationService.GetTranslation("BuildingPlanner.Settings.Height")"/>
                                </div>
                                @* Fond de plan : image importée (réduite côté client, stockée avec le plan), placement dans le document. *@
                                <div class="bp-settings-section">@LocalizationService.GetTranslation("BuildingPlanner.Settings.Background")</div>
                                <div class="bp-settings-grid bp-settings-grid-img">
                                    <MudButton Size="Size.Small" Variant="Variant.Outlined" StartIcon="@MDIIcons.Filled.Image" OnClick="@(() => Js("pickBackgroundImage"))">@LocalizationService.GetTranslation("BuildingPlanner.Background.Import")</MudButton>
                                    <MudIconButton Icon="@Icons.Material.Filled.Visibility" Size="Size.Small" Title="@LocalizationService.GetTranslation("BuildingPlanner.Background.Show")" Class="@(_backgroundImage is null ? "bp-off" : null)" OnClick="@(() => Js("toggleBackgroundVisible"))"/>
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" Title="@LocalizationService.GetTranslation("BuildingPlanner.Background.Remove")" Class="@(_backgroundImage is null ? "bp-off" : null)" OnClick="@(() => Js("clearBackgroundImage"))"/>
                                    @if (_document.Architecture.Image is null)
                                    {
                                        <span class="bp-settings-help">@LocalizationService.GetTranslation("BuildingPlanner.Background.None")</span>
                                    }
                                </div>
                                @if (_document.Architecture.Image is { } img)
                                {
                                    <div class="bp-settings-grid bp-settings-grid-3">
                                        <MudNumericField T="double" Value="@img.X" ValueChanged="@(v => Js("updateBackgroundImage", new { x = v }))" Step="0.5" Dense="true" Margin="Margin.Dense" Variant="Variant.Outlined" Label="@LocalizationService.GetTranslation("BuildingPlanner.Background.X")"/>
                                        <MudNumericField T="double" Value="@img.Y" ValueChanged="@(v => Js("updateBackgroundImage", new { y = v }))" Step="0.5" Dense="true" Margin="Margin.Dense" Variant="Variant.Outlined" Label="@LocalizationService.GetTranslation("BuildingPlanner.Background.Y")"/>
                                        <MudNumericField T="double" Value="@img.Width" ValueChanged="@(v => Js("updateBackgroundImage", new { width = Math.Clamp(v, 1, PlanValidator.MaxGridSide) }))" Min="1" Max="@PlanValidator.MaxGridSide" Step="1" Dense="true" Margin="Margin.Dense" Variant="Variant.Outlined" Label="@LocalizationService.GetTranslation("BuildingPlanner.Background.Width")"/>
                                    </div>
                                    <div class="bp-settings-grid bp-settings-grid-img">
                                        <MudButton Size="Size.Small" Variant="Variant.Outlined" StartIcon="@MDIIcons.Filled.FitToScreen" OnClick="@(() => Js("fitBackgroundImage"))">@LocalizationService.GetTranslation("BuildingPlanner.Background.FitGrid")</MudButton>
                                        <span class="bp-settings-help">@LocalizationService.GetTranslation("BuildingPlanner.Background.Opacity")</span>
                                        <MudSlider T="double" Value="@img.Opacity" ValueChanged="@(v => Js("updateBackgroundImage", new { opacity = v }))" Min="0" Max="1" Step="0.05" Size="Size.Small" Class="bp-bg-opacity"/>
                                    </div>
                                }
                            }
                            else
                            {
                            <div class="bp-settings-section">@LocalizationService.GetTranslation("BuildingPlanner.Settings.Construction")</div>
                            <div class="bp-settings-grid bp-settings-grid-3">
                                <MudNumericField T="int" Value="@_document.Defaults.WallHeight" ValueChanged="OnWallHeightChanged" Min="1" Max="50" Dense="true" Margin="Margin.Dense" Variant="Variant.Outlined"
                                                 Label="@LocalizationService.GetTranslation("BuildingPlanner.Defaults.WallHeight")"/>
                                <MudSelect T="string" Value="@(_document.Defaults.FloorMaterial ?? "")" ValueChanged="OnFloorMaterialChanged" Dense="true" Margin="Margin.Dense" Variant="Variant.Outlined" Clearable="true"
                                           Label="@LocalizationService.GetTranslation("BuildingPlanner.Defaults.Floor")"
                                           HelperText="@(string.IsNullOrEmpty(_document.Defaults.FloorMaterial) ? LocalizationService.GetTranslation("BuildingPlanner.Defaults.TerrainHelp") : null)">
                                    <MudSelectItem T="string" Value="@("")">@LocalizationService.GetTranslation("BuildingPlanner.Defaults.Terrain")</MudSelectItem>
                                    @foreach (var m in _clientCatalog!.Materials)
                                    {
                                        <MudSelectItem T="string" Value="@m.Name">@MaterialItem(m)</MudSelectItem>
                                    }
                                </MudSelect>
                                <MudSelect T="string" Value="@(_document.Defaults.CeilingMaterial ?? "")" ValueChanged="OnCeilingMaterialChanged" Dense="true" Margin="Margin.Dense" Variant="Variant.Outlined" Clearable="true"
                                           Label="@LocalizationService.GetTranslation("BuildingPlanner.Defaults.Ceiling")"
                                           Error="CeilingMissing" ErrorText="@LocalizationService.GetTranslation("BuildingPlanner.Defaults.CeilingRequired")">
                                    <MudSelectItem T="string" Value="@("")">@LocalizationService.GetTranslation("BuildingPlanner.Defaults.None")</MudSelectItem>
                                    @foreach (var m in _clientCatalog!.Materials)
                                    {
                                        <MudSelectItem T="string" Value="@m.Name">@MaterialItem(m)</MudSelectItem>
                                    }
                                </MudSelect>
                            </div>
                            <div class="bp-settings-section">@LocalizationService.GetTranslation("BuildingPlanner.Settings.Housing")</div>
                            <div class="bp-settings-grid bp-settings-grid-2">
                                <MudNumericField T="int" Value="@_document.Analysis.Residents" ValueChanged="OnResidentsChanged" Min="1" Max="50" Dense="true" Margin="Margin.Dense" Variant="Variant.Outlined"
                                                 Label="@LocalizationService.GetTranslation("BuildingPlanner.Residents")"/>
                                <div class="bp-settings-help">@LocalizationService.GetTranslation("BuildingPlanner.Settings.ResidentsHelp", _document.Analysis.Residents.ToString(), (_analysis?.Housing?.OccupancyMultiplier ?? 1f).ToString("0.##"))</div>
                            </div>
                            }
                            <div class="bp-settings-foot">
                                <span>@LocalizationService.GetTranslation("BuildingPlanner.Settings.Grid", _document.Grid.Width.ToString(), _document.Grid.Depth.ToString(), _document.Levels.Count.ToString())</span>
                                <span class="bp-link" @onclick="OpenResizeAsync">@LocalizationService.GetTranslation("BuildingPlanner.Plan.Resize")</span>
                            </div>
                        </div>
                    </MudPopover>
                </div>
            </MudStack>
        </MudPaper>

        <div class="@("bp-body" + (_view3d ? " bp-body-3d" : ""))">
            @if (!_view3d)
            {
            <MudPaper Class="bp-side bp-left" Elevation="1">
                @if (IsArch)
                {
                    @* Options des outils de forme (état de la page, comme le matériau) puis la liste des formes posées, dernière en haut. *@
                    <div class="bp-catalog">
                        <div class="bp-arch-opts">
                            <MudToggleGroup T="bool" Value="@_shape.Subtract" ValueChanged="@(v => SetShapeAsync(_shape with { Subtract = v }))" SelectionMode="SelectionMode.SingleSelection" Color="Color.Primary" Size="Size.Small" Outlined="true" CheckMark="false" Class="bp-arch-mode">
                                <MudToggleItem T="bool" Value="false"><MudTooltip Text="@LocalizationService.GetTranslation("BuildingPlanner.Shape.Add")"><MudIcon Icon="@Icons.Material.Filled.Add" Size="Size.Small"/></MudTooltip></MudToggleItem>
                                <MudToggleItem T="bool" Value="true"><MudTooltip Text="@LocalizationService.GetTranslation("BuildingPlanner.Shape.Subtract")"><MudIcon Icon="@Icons.Material.Filled.Remove" Size="Size.Small"/></MudTooltip></MudToggleItem>
                            </MudToggleGroup>
                            <MudCheckBox T="bool" Value="@_shape.Hollow" ValueChanged="@(v => SetShapeAsync(_shape with { Hollow = v }))" Dense="true" Size="Size.Small" Label="@LocalizationService.GetTranslation("BuildingPlanner.Shape.Hollow")"/>
                            <MudNumericField T="int" Value="@_shape.Thickness" ValueChanged="@(v => SetShapeAsync(_shape with { Thickness = Math.Clamp(v, 1, 10) }))" Min="1" Max="10" Disabled="!_shape.Hollow" Dense="true" Margin="Margin.Dense" Variant="Variant.Outlined"
                                             Label="@LocalizationService.GetTranslation("BuildingPlanner.Shape.Thickness")"/>
                            <MudNumericField T="int" Value="@_shape.Height" ValueChanged="@(v => SetShapeAsync(_shape with { Height = Math.Clamp(v, 1, PlanValidator.MaxArchitectureHeight) }))" Min="1" Max="@PlanValidator.MaxArchitectureHeight" Dense="true" Margin="Margin.Dense" Variant="Variant.Outlined"
                                             Label="@LocalizationService.GetTranslation("BuildingPlanner.Shape.Height")"/>
                        </div>
                        <div class="bp-arch-ops">
                            @if (_document.Architecture.Ops.Count == 0)
                            {
                                <MudText Typo="Typo.caption" Class="pa-2 d-block">@LocalizationService.GetTranslation("BuildingPlanner.Shape.None")</MudText>
                            }
                            @for (var i = _document.Architecture.Ops.Count - 1; i >= 0; i--)
                            {
                                var op = _document.Architecture.Ops[i];
                                <div class="@("bp-object-item bp-op-row" + (_selectionKind == "op" && _selectionId == op.Id ? " selected" : ""))" @onclick="@(() => Js("selectOp", op.Id))">
                                    <MudIcon Icon="@KindIcon(op.Kind)" Size="Size.Small"/>
                                    <span class="@("bp-op-mode" + (op.Subtract ? " sub" : ""))">@(op.Subtract ? "−" : "+")</span>
                                    <span class="bp-ellipsis">@(op.Subtract ? LocalizationService.GetTranslation($"BuildingPlanner.Shape.Kind.{op.Kind}") : MaterialLabel(op.Material))</span>
                                    <span class="bp-op-dims">@OpDims(op)</span>
                                </div>
                            }
                        </div>
                    </div>
                }
                else
                {
                @* Catalogue : recherche + liste unique groupée (catégories housing, Tables, Portes par tier, Autres). *@
                <div class="bp-catalog">
                    @RenderObjectList()
                </div>
                }
                @* Zone Sélection : fiche de la pièce / de l'objet / de la forme sélectionnée, tiers bas du panneau, scroll interne. *@
                <div class="bp-selection">
                    <BuildingPlannerInspector Document="_document" Analysis="_analysis" Catalog="_clientCatalog" SelectionKind="@_selectionKind" SelectionId="@_selectionId"
                                              OnRoomChanged="UpdateRoomAsync" OnObjectChanged="UpdateObjectAsync" OnOpChanged="UpdateOpAsync" OnDeleteSelection="@(() => Js("deleteSelection"))"/>
                </div>
            </MudPaper>
            }

            <div class="bp-canvas-wrap">
                <div id="@_containerId" class="bp-canvas"></div>
                <div class="bp-canvas-actions">
                    <MudTooltip Text="@LocalizationService.GetTranslation("BuildingPlanner.Undo")"><MudIconButton Icon="@MDIIcons.Filled.Undo" Size="Size.Small" Disabled="!_canUndo" OnClick="@(() => Js("undo"))"/></MudTooltip>
                    <MudTooltip Text="@LocalizationService.GetTranslation("BuildingPlanner.Redo")"><MudIconButton Icon="@MDIIcons.Filled.Redo" Size="Size.Small" Disabled="!_canRedo" OnClick="@(() => Js("redo"))"/></MudTooltip>
                    <MudTooltip Text="@LocalizationService.GetTranslation("BuildingPlanner.ZoomIn")"><MudIconButton Icon="@Icons.Material.Filled.ZoomIn" Size="Size.Small" OnClick="@(() => Js("zoomIn"))"/></MudTooltip>
                    <MudTooltip Text="@LocalizationService.GetTranslation("BuildingPlanner.ZoomOut")"><MudIconButton Icon="@Icons.Material.Filled.ZoomOut" Size="Size.Small" OnClick="@(() => Js("zoomOut"))"/></MudTooltip>
                    <MudTooltip Text="@LocalizationService.GetTranslation("BuildingPlanner.Fit")"><MudIconButton Icon="@MDIIcons.Filled.FitToScreen" Size="Size.Small" OnClick="@(() => Js("fit"))"/></MudTooltip>
                    <MudTooltip Placement="Placement.Top">
                        <ChildContent>
                            <MudIcon Icon="@MDIIcons.Outline.Information" Color="Color.Info" Size="Size.Small" Class="d-flex align-center"/>
                        </ChildContent>
                        <TooltipContent>
                            <div class="bp-hint-lines">
                                <MudText Typo="Typo.subtitle2">@LocalizationService.GetTranslation("BuildingPlanner.Shortcuts")</MudText>
                                @foreach (var line in LocalizationService.GetTranslation(_view3d ? "BuildingPlanner.Hint3d" : IsArch ? "BuildingPlanner.HintArch" : "BuildingPlanner.Hint").Split(" · "))
                                {
                                    <div>@line</div>
                                }
                            </div>
                        </TooltipContent>
                    </MudTooltip>
                </div>
            </div>

            @* Colonne droite : volet à la demande (un seul à la fois) + rail d'icônes toujours présent. *@
            <div class="bp-right-col">
                @if (_rightPanel is { } panel)
                {
                    <MudPaper Class="bp-side bp-panel" Elevation="1">
                        <div class="bp-panel-head">
                            <MudIcon Icon="@PanelIcon(panel)" Size="Size.Small"/>
                            <span class="bp-panel-title">@PanelTitle(panel)</span>
                            @if (panel == "issues" && IssueCount > 0)
                            {
                                <span class="@("bp-count-badge" + (ErrorCount > 0 ? " error" : ""))">@IssueCount</span>
                            }
                            <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" Class="ml-auto" OnClick="@(() => SetRightPanelAsync(null))"/>
                        </div>
                        <div class="bp-panel-body">
                            <BuildingPlannerResults Panel="@panel" Document="_document" Analysis="_analysis" Catalog="_clientCatalog" SelectionKind="@_selectionKind" SelectionId="@_selectionId"
                                                    OnFocusIssue="FocusIssueAsync" OnFocusRoom="@(id => Js("selectRoom", id))"
                                                    DefaultPrices="_defaultPrices" OnPriceChanged="@(p => Js("setPrice", p.Name, p.Price))"/>
                        </div>
                    </MudPaper>
                }
                <MudPaper Class="bp-side bp-rail" Elevation="1">
                    @if (!IsArch) { @RailButton("housing", Icons.Material.Filled.Home, "BuildingPlanner.Results.HousingByRoom") }
                    @RailButton("issues", Icons.Material.Filled.Warning, "BuildingPlanner.Results.Issues", IssueCount > 0 ? IssueBadge : null)
                    @if (!IsArch) { @RailButton("objects", Icons.Material.Filled.Chair, "BuildingPlanner.Results.Objects") }
                    @RailButton("materials", Icons.Material.Filled.GridView, "BuildingPlanner.Results.Materials")
                    @if (!IsArch)
                    {
                        <div class="bp-rail-spacer"></div>
                        @RailButton("assumptions", MDIIcons.Outline.Information, "BuildingPlanner.Assumptions.Title")
                    }
                </MudPaper>
            </div>
        </div>
    </div>
}

@code {
    private sealed record ToolDef(string Key, string Icon);

    private static readonly ToolDef[] HouseTools =
    [
        new("select", MDIIcons.Filled.CursorDefault),
        new("pan", MDIIcons.Filled.HandBackRight),
        new("wall", MDIIcons.Filled.Wall),
        new("hole", MDIIcons.Filled.Stairs),
    ];

    private static readonly ToolDef[] ArchTools =
    [
        new("select", MDIIcons.Filled.CursorDefault),
        new("pan", MDIIcons.Filled.HandBackRight),
        new("box", MDIIcons.Filled.Cube),
        new("sphere", MDIIcons.Filled.Sphere),
        new("cylinder", MDIIcons.Filled.Cylinder),
        new("disc", MDIIcons.Filled.Circle),
        new("line", MDIIcons.Filled.VectorLine),
        new("curve", MDIIcons.Filled.VectorCurve),
        new("pencil", MDIIcons.Filled.Pencil),
        new("eraser", MDIIcons.Filled.Eraser),
        new("cut", MDIIcons.Filled.ContentCut),
    ];

    private ToolDef[] Tools => IsArch ? ArchTools : HouseTools;
    private bool IsArch => _document.IsArchitecture;
    private const string View3d = "3d";   // valeur du toggle de mode pour le rendu 3D (état de vue, hors document)
    private bool _view3d, _cap;

    // Options des outils de forme (état de la page, pas du document, comme le matériau courant).
    private sealed record ShapeOptions(bool Subtract = false, bool Hollow = false, int Thickness = 1, int Height = 3);
    private ShapeOptions _shape = new();
    private int _layer, _layerCount = 20;
    private string? _backgroundImage;   // fond de plan (data URL), colonne BuildingPlan.BackgroundImage ; le placement est dans le document

    private const int AnalyzeDebounceMs = 150;

    private readonly string _containerId = "bp-canvas-" + Guid.NewGuid().ToString("N");
    private DotNetObjectReference<BuildingPlannerPage>? _selfRef;
    private IDisposable? _locationChangingRegistration;
    private CancellationTokenSource? _analyzeCts;

    private bool _loading = true;
    private bool _jsInitialized;
    private Catalog? _catalog;
    private ClientCatalog? _clientCatalog;
    private PlanDocument _document = PlanDocument.Empty();
    private AnalysisResult? _analysis;
    private BuildingPlan? _savedPlan;
    private Dictionary<string, decimal> _defaultPrices = new();   // moyenne des prix joueurs du serveur par Name : défaut des champs prix des volets

    private string _tool = "select";
    private string? _material;
    private string? _objectType;
    private int _rotation;
    private int _level;
    private bool _canUndo, _canRedo, _dirty;
    private string? _selectionKind, _selectionId;
    private string _objectSearch = "";
    private readonly HashSet<string> _expandedGroups = [];
    private string? _rightPanel;      // volet ouvert : housing | issues | objects | materials | assumptions, null = fermé
    private bool _settingsOpen;

    private const string RightPanelKey = "BuildingPlanner.RightPanel";
    private static readonly string[] RightPanels = ["housing", "issues", "objects", "materials", "assumptions"];

    protected override void OnInitialized()
    {
        ContextService.OnContextChanged += OnContextChanged;
        _locationChangingRegistration = Navigation.RegisterLocationChangingHandler(OnLocationChanging);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadAsync();
            return;
        }

        if (!_loading && !_jsInitialized && _clientCatalog is not null)
        {
            await InitializeJsAsync();
        }
    }

    private async Task LoadAsync()
    {
        _loading = true;
        StateHasChanged();

        if (!BuildingPlannerService.HasBuildingData || ContextService.CurrentServer is null || ContextService.CurrentUserServer is null)
        {
            _loading = false;
            StateHasChanged();
            return;
        }

        ContextService.CurrentServerData ??= await ServerDbService.GetServerWithData(ContextService.CurrentServer.Id);
        var serverData = ContextService.CurrentServerData;

        // Bumps de tier des modules : ceux installés dans le contexte de données par défaut du joueur.
        DataContext? dataContext = null;
        var defaultContext = ContextService.CurrentUserServer.DataContexts.FirstOrDefault(d => d.IsDefault && !d.IsShoppingList) ?? ContextService.CurrentUserServer.DataContexts.FirstOrDefault(d => !d.IsShoppingList);
        if (defaultContext is not null)
        {
            try { dataContext = await DataContextDbService.GetDataContextWithData(defaultContext.Id, serverData); }
            catch (Exception) { dataContext = null; }
        }

        _catalog = BuildingPlannerService.GetCatalog(serverData, dataContext);
        _clientCatalog = BuildingPlannerService.GetClientCatalog(_catalog, serverData);
        _defaultPrices = await EconomyViewerService.GetAveragePricesByItemNameAsync(ContextService.CurrentServer.Id);
        _material ??= _clientCatalog.Materials.FirstOrDefault(m => m.IsRoomMaterialOption)?.Name ?? _clientCatalog.Materials.FirstOrDefault()?.Name;

        _loading = false;
        StateHasChanged();
    }

    private async Task InitializeJsAsync()
    {
        _selfRef ??= DotNetObjectReference.Create(this);
        var ok = await JS.InvokeAsync<bool>("ecoBuildingPlanner.init", _containerId, _selfRef, new
        {
            roomLabel = LocalizationService.GetTranslation("BuildingPlanner.RoomDefaultName"),
            // Libellés dessinés dans le canvas (bandes d'élévation et de coupe du mode architecture).
            labels = new
            {
                elevation = LocalizationService.GetTranslation("BuildingPlanner.Elevation.Title"),
                section = LocalizationService.GetTranslation("BuildingPlanner.Section.Title"),
                tooManyBlocks = LocalizationService.GetTranslation("BuildingPlanner.View3d.TooManyBlocks"),
                sides = new
                {
                    s = LocalizationService.GetTranslation("BuildingPlanner.Elevation.South"),
                    e = LocalizationService.GetTranslation("BuildingPlanner.Elevation.East"),
                    n = LocalizationService.GetTranslation("BuildingPlanner.Elevation.North"),
                    w = LocalizationService.GetTranslation("BuildingPlanner.Elevation.West"),
                },
            },
        });
        if (!ok) return;
        _jsInitialized = true;

        var savedPanel = await LocalStorageService.GetItem(RightPanelKey);
        if (RightPanels.Contains(savedPanel)) _rightPanel = savedPanel;

        await JS.InvokeVoidAsync("ecoBuildingPlanner.setCatalog", _containerId, _clientCatalog);
        await JS.InvokeVoidAsync("ecoBuildingPlanner.setMaterial", _containerId, _material);
        await JS.InvokeVoidAsync("ecoBuildingPlanner.setBeforeUnloadGuard", _containerId, true);

        // Chargement : ?plan= (URL) > ?id= (sauvegardé) > dernier plan ouvert (sous le brouillon local s'il existe) > brouillon local > vide.
        string? initialJson = null;
        BuildingPlan? plan = null;
        var query = QueryHelpers.ParseQuery(new Uri(Navigation.Uri).Query);
        var hasLink = query.TryGetValue("plan", out var encoded);
        var fromUrl = hasLink ? PlanUrlCodec.TryDecode(encoded.ToString()) : null;
        if (hasLink && fromUrl is null) Snackbar.Add(LocalizationService.GetTranslation("BuildingPlanner.Snackbar.LinkInvalid"), Severity.Warning);
        var linkedId = query.TryGetValue("id", out var idValue) && Guid.TryParse(idValue.ToString(), out var parsedId) ? parsedId : (Guid?)null;

        // Un lien alors qu'un brouillon non sauvegardé existe sur ce serveur : demander avant de l'écraser ; refus → flux sans lien.
        if ((fromUrl is not null || linkedId is not null) && await JS.InvokeAsync<bool>("ecoBuildingPlanner.hasDraft", _containerId) && !await ConfirmDiscardAsync())
        {
            fromUrl = null;
            linkedId = null;
            Navigation.NavigateTo("/building-planner", replace: true);
        }

        if (fromUrl is not null)
        {
            initialJson = PlanDocumentJson.Serialize(fromUrl);
        }
        else if (linkedId is { } id)
        {
            plan = await BuildingPlannerService.LoadPlanAsync(id);
            if (plan is not null) initialJson = plan.Document;
            else Snackbar.Add(LocalizationService.GetTranslation("BuildingPlanner.Snackbar.PlanNotFound"), Severity.Warning);
        }
        else if (Guid.TryParse(await LocalStorageService.GetItem(LastPlanKey), out var lastId))
        {
            plan = await BuildingPlannerService.LoadPlanAsync(lastId);
            if (plan is null) await LocalStorageService.RemoveItem(LastPlanKey);
            else
            {
                // Le brouillon local prime (modifications en cours), _savedPlan reste renseigné pour que Enregistrer mette à jour le bon plan.
                if (!await JS.InvokeAsync<bool>("ecoBuildingPlanner.hasDraft", _containerId)) initialJson = plan.Document;
                Navigation.NavigateTo($"/building-planner?id={plan.Id}", replace: true);
            }
        }
        // Un plan d'un autre joueur n'est pas mémorisé : il ne doit pas se rouvrir d'office aux visites suivantes.
        if (plan is not null && BuildingPlannerService.OwnsPlan(plan))
        {
            _savedPlan = plan;
            await RememberLastPlanAsync(plan.Id);
        }

        var fromDraft = await JS.InvokeAsync<bool>("ecoBuildingPlanner.setPlan", _containerId, initialJson, true);
        if (fromDraft) Snackbar.Add(LocalizationService.GetTranslation("BuildingPlanner.Snackbar.DraftRestored"), Severity.Info);
        // Les pixels du fond de plan ne sont pas dans le brouillon : ceux du plan sauvegardé (s'il y en a un) sont repris.
        _backgroundImage = plan?.BackgroundImage;
        await Js("setBackgroundImage", _backgroundImage);
    }

    // ---- Callbacks JS ---------------------------------------------------------------------------------

    [JSInvokable]
    public void OnPlanChanged(string json, bool canUndo, bool canRedo, bool dirty)
    {
        _canUndo = canUndo;
        _canRedo = canRedo;
        _dirty = dirty;
        var parsed = PlanDocumentJson.TryParse(json);
        if (parsed is not null) _document = parsed;
        if (IsArch && _rightPanel is "housing" or "objects" or "assumptions") _rightPanel = null;   // volets sans objet en architecture (dont un volet restauré)
        ScheduleAnalysis();
        StateHasChanged();
    }

    [JSInvokable]
    public void OnView3dChanged(bool on, bool cap)
    {
        _view3d = on;
        _cap = cap;
        StateHasChanged();
    }

    [JSInvokable]
    public void OnLayerChanged(int layer, int layerCount)
    {
        _layer = layer;
        _layerCount = layerCount;   // hauteur effective : couches des formes + maison (calculée par le canvas)
        StateHasChanged();
    }

    // Fichier JSON choisi par l'utilisateur (null = trop grand) : le plan importé remplace le plan courant comme un
    // brouillon non sauvegardé, sans fond de plan (les pixels ne sont pas dans le document).
    [JSInvokable]
    public async Task OnPlanFileImported(string? json)
    {
        var doc = PlanDocumentJson.TryParse(json);
        if (doc is null) { Snackbar.Add(LocalizationService.GetTranslation("BuildingPlanner.Snackbar.ImportInvalid"), Severity.Warning); return; }
        _savedPlan = null;
        await RememberLastPlanAsync(null);
        await Js("clearDraft");
        await JS.InvokeAsync<bool>("ecoBuildingPlanner.setPlan", _containerId, PlanDocumentJson.Serialize(doc), false);
        _backgroundImage = null;
        await Js("setBackgroundImage", (string?)null);
        Navigation.NavigateTo("/building-planner", replace: true);
        if (!doc.IsArchitecture) await DetectLevelsAsync(auto: true);
    }

    [JSInvokable]
    public async Task OnBackgroundImageChanged(string? dataUrl)
    {
        _backgroundImage = BuildingPlannerService.IsValidBackgroundImage(dataUrl) ? dataUrl : null;
        await Js("markDirty");
        StateHasChanged();
    }

    [JSInvokable]
    public void OnSelectionChanged(string? kind, string? id)
    {
        _selectionKind = kind;
        _selectionId = id;
        StateHasChanged();
    }

    [JSInvokable]
    public void OnToolChanged(string tool)
    {
        _tool = tool;
        StateHasChanged();
    }

    [JSInvokable]
    public void OnObjectTypeChanged(string? objectType)
    {
        _objectType = objectType;
        StateHasChanged();
    }

    [JSInvokable]
    public void OnMaterialPicked(string material)
    {
        _material = material;
        StateHasChanged();
    }

    [JSInvokable]
    public void OnRotationChanged(int rotation)
    {
        _rotation = rotation;
        StateHasChanged();
    }

    [JSInvokable]
    public void OnLevelChanged(int level)
    {
        _level = level;
        StateHasChanged();
    }

    [JSInvokable]
    public async Task OnEscape()
    {
        if (_rightPanel is null) return;
        await SetRightPanelAsync(null);
        StateHasChanged();
    }

    [JSInvokable]
    public async Task OnSaveRequested() => await SaveAsync(false);

    // ---- Analyse ------------------------------------------------------------------------------------------

    private void ScheduleAnalysis()
    {
        _analyzeCts?.Cancel();
        _analyzeCts?.Dispose();
        var cts = new CancellationTokenSource();
        _analyzeCts = cts;
        _ = RunAnalysisAsync(cts.Token);
    }

    private async Task RunAnalysisAsync(CancellationToken token)
    {
        try
        {
            await Task.Delay(AnalyzeDebounceMs, token);
            if (_catalog is null) return;
            var doc = _document;
            var result = await Task.Run(() => PlanAnalyzer.Analyze(doc, _catalog), token);
            if (token.IsCancellationRequested) return;
            _analysis = result;
            await InvokeAsync(async () =>
            {
                if (_jsInitialized) await JS.InvokeVoidAsync("ecoBuildingPlanner.setAnalysis", _containerId, result);
                StateHasChanged();
            });
        }
        catch (OperationCanceledException) { }
        catch (JSDisconnectedException) { }
        catch (Exception e)
        {
            Console.WriteLine($"BuildingPlanner analysis failed: {e}");
        }
    }

    // ---- Outils / catalogue -----------------------------------------------------------------------------------

    private async Task Js(string method, params object?[] args)
    {
        if (!_jsInitialized) return;
        var all = new object?[args.Length + 1];
        all[0] = _containerId;
        Array.Copy(args, 0, all, 1, args.Length);
        try { await JS.InvokeVoidAsync($"ecoBuildingPlanner.{method}", all); }
        catch (JSDisconnectedException) { }
    }

    private async Task SetTool(string tool)
    {
        if (tool == "hole" && _level == 0) return;
        _tool = tool;
        await Js("setTool", tool);
    }

    private async Task OnMaterialChanged(string material)
    {
        _material = material;
        await Js("setMaterial", material);
        if (!IsArch && _tool != "wall") await SetTool("wall");
    }

    private async Task SetModeAsync(string mode)
    {
        if (mode == View3d) { await Js("setView3d", true); return; }
        if (_view3d) await Js("setView3d", false);
        if (mode == _document.Mode) return;
        await Js("setMode", mode);
        if (mode == PlanMode.House) await DetectLevelsAsync(auto: true);
    }

    private async Task SetShapeAsync(ShapeOptions shape)
    {
        _shape = shape;
        await Js("setShapeOptions", new { subtract = shape.Subtract, hollow = shape.Hollow, thickness = shape.Thickness, height = shape.Height });
    }

    private async Task OnArchHeightChanged(int value) => await Js("setArchitecture", new { height = Math.Clamp(value, 1, PlanValidator.MaxArchitectureHeight) });
    private async Task UpdateOpAsync(ArchOp op) => await Js("updateOp", PlanDocumentJson.SerializePart(op));

    private static string KindIcon(string kind) => kind switch
    {
        "sphere" => MDIIcons.Filled.Sphere,
        "cylinder" => MDIIcons.Filled.Cylinder,
        "line" => MDIIcons.Filled.VectorLine,
        "curve" => MDIIcons.Filled.VectorCurve,
        "cells" => MDIIcons.Filled.Pencil,
        _ => MDIIcons.Filled.Cube,
    };

    private string MaterialLabel(string? name) => _clientCatalog?.Materials.FirstOrDefault(m => m.Name == name)?.Label ?? name ?? "";

    // Dimensions d'une forme : « 12×8 h3 », « Ø7 h4 », « L9 », « C9 » (boîte englobante, point de contrôle compris), « 24 cases ».
    private string OpDims(ArchOp op)
    {
        if (op.Kind == "cells") return LocalizationService.GetTranslation("BuildingPlanner.Shape.Cells", ((op.Cells?.Length ?? 0) / 3).ToString());
        if (op.A is not { Length: 3 } || op.B is not { Length: 3 }) return "";
        var c = op.Kind == "curve" && op.C is { Length: 3 } ? op.C : op.A;
        int Extent(int i) => Math.Max(op.A[i], Math.Max(op.B[i], c[i])) - Math.Min(op.A[i], Math.Min(op.B[i], c[i])) + 1;
        int w = Extent(0), d = Extent(1), h = Extent(2);
        return op.Kind switch
        {
            "box" => $"{w}×{d} h{h}",
            "line" => $"L{Math.Max(w, Math.Max(d, h))}",
            "curve" => $"C{Math.Max(w, Math.Max(d, h))}",
            "sphere" => $"Ø{Math.Max(w, d)}",
            _ => CylinderDims(op.Axis, w, d, h),
        };
    }

    // Cylindre : diamètre sur les axes radiaux, longueur sur l'axe (h debout, L couché).
    private static string CylinderDims(string? axis, int w, int d, int h)
    {
        var (dia, len) = axis == "x" ? (Math.Max(d, h), w) : axis == "y" ? (Math.Max(w, h), d) : (Math.Max(w, d), h);
        return $"Ø{dia}" + (len > 1 ? $" {(axis is "x" or "y" ? "L" : "h")}{len}" : "");
    }

    private async Task SelectObjectType(ClientObject obj)
    {
        _objectType = obj.Name;
        _tool = "object";
        await Js("setObject", obj.Name);
    }

    private async Task RotateAsync()
    {
        _rotation = (_rotation + 1) & 3;
        await Js("setRotation", _rotation);
    }

    private async Task OnWallHeightChanged(int value) => await Js("setDefaults", new { wallHeight = Math.Clamp(value, 1, 50) });
    private async Task OnFloorMaterialChanged(string value) => await Js("setDefaults", new { floorMaterial = string.IsNullOrEmpty(value) ? null : value });
    private async Task OnCeilingMaterialChanged(string value) => await Js("setDefaults", new { ceilingMaterial = string.IsNullOrEmpty(value) ? null : value });
    private async Task OnResidentsChanged(int value) => await Js("setAnalysisOptions", new { residents = Math.Clamp(value, 1, 50) });

    private async Task UpdateRoomAsync(PlanRoom room) => await Js("updateRoom", PlanDocumentJson.SerializePart(room));
    private async Task UpdateObjectAsync(PlanObject obj) => await Js("updateObject", PlanDocumentJson.SerializePart(obj));

    private string LevelLabel(int level)
    {
        var name = level < _document.Levels.Count ? _document.Levels[level].Name : "";
        return string.IsNullOrWhiteSpace(name) ? LocalizationService.GetTranslation("BuildingPlanner.Level.Default", _document.DisplayNumber(level).ToString()) : name;
    }

    private async Task EditLevelAsync()
    {
        if (_level >= _document.Levels.Count) return;
        var level = _document.Levels[_level];
        var parameters = new DialogParameters<BuildingPlanLevelDialog>
        {
            { d => d.Name, level.Name }, { d => d.Height, level.Height },
            { d => d.DefaultName, LocalizationService.GetTranslation("BuildingPlanner.Level.Default", _document.DisplayNumber(_level).ToString()) }, { d => d.DefaultHeight, _document.Defaults.WallHeight },
        };
        var dialog = await DialogService.ShowAsync<BuildingPlanLevelDialog>(LocalizationService.GetTranslation("BuildingPlanner.Level.Edit"), parameters, new DialogOptions { MaxWidth = MaxWidth.ExtraSmall, FullWidth = true });
        var result = await dialog.Result;
        if (result is null || result.Canceled || result.Data is not (string name, int height)) return;
        // height 0 = hauteur par défaut (évite de dépendre de la sérialisation des null vers le JS).
        await Js("updateLevel", _level, new { name, height });
    }

    // Niveaux déduits des dalles du bâtiment (formes + maison). Automatique au passage en mode maison et après un import
    // quand aucun niveau ne porte encore de contenu et que la pile ne correspond pas déjà ; à la demande depuis le menu.
    private async Task DetectLevelsAsync(bool auto)
    {
        var proposal = await JS.InvokeAsync<BuildingPlanDetectLevelsDialog.LevelProposal?>("ecoBuildingPlanner.detectLevels", _containerId);
        if (proposal is null || proposal.Levels.Count == 0)
        {
            if (!auto) Snackbar.Add(LocalizationService.GetTranslation("BuildingPlanner.Level.DetectNone"), Severity.Info);
            return;
        }
        if (auto && (!proposal.Empty || proposal.Matches)) return;
        var parameters = new DialogParameters<BuildingPlanDetectLevelsDialog> { { d => d.Proposal, proposal } };
        var dialog = await DialogService.ShowAsync<BuildingPlanDetectLevelsDialog>(LocalizationService.GetTranslation("BuildingPlanner.Level.Detect"), parameters, new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        var result = await dialog.Result;
        if (result is null || result.Canceled || result.Data is not (List<int> heights, int groundIndex)) return;
        await Js("applyLevels", heights, groundIndex);
    }

    // ---- Rail / volet droit / bandeau -------------------------------------------------------------

    private async Task SetRightPanelAsync(string? key)
    {
        _rightPanel = key;
        if (key is null) await LocalStorageService.RemoveItem(RightPanelKey);
        else await LocalStorageService.AddItem(RightPanelKey, key);
    }

    private Task ToggleRightPanelAsync(string key) => SetRightPanelAsync(_rightPanel == key ? null : key);

    private async Task OpenResizeAsync()
    {
        _settingsOpen = false;
        await ResizeAsync();
    }

    private bool CeilingMissing => !IsArch && string.IsNullOrEmpty(_document.Defaults.CeilingMaterial);
    private int ErrorCount => _analysis?.Issues.Count(i => i.Severity == IssueSeverity.Error) ?? 0;
    private int WarningCount => _analysis?.Issues.Count(i => i.Severity == IssueSeverity.Warning) ?? 0;
    private int IssueCount => ErrorCount + WarningCount;   // les Info ne sont pas comptées (décision Romain)
    private string StatusClass => ErrorCount > 0 ? "error" : WarningCount > 0 ? "warn" : "ok";
    private string IssueTone => ErrorCount > 0 ? " error" : WarningCount > 0 ? " warn" : "";   // icône du rail : grise quand tout va bien

    private string StatusText
    {
        get
        {
            if (ErrorCount > 0)
            {
                var errors = LocalizationService.GetTranslation("BuildingPlanner.Results.ErrorsCount", ErrorCount.ToString());
                return WarningCount > 0 ? $"{errors}, {LocalizationService.GetTranslation("BuildingPlanner.Results.IssuesCount", WarningCount.ToString())}" : errors;
            }
            return WarningCount > 0
                ? LocalizationService.GetTranslation("BuildingPlanner.Results.IssuesCount", WarningCount.ToString())
                : LocalizationService.GetTranslation("BuildingPlanner.Results.NoIssue");
        }
    }

    // « XP housing / jour » → deux lignes : « XP housing » / « / jour · ×m ».
    private (string First, string Second) PerDayLines
    {
        get
        {
            var text = LocalizationService.GetTranslation("BuildingPlanner.Housing.PerDay");
            var i = text.IndexOf(" / ", StringComparison.Ordinal);
            return i < 0 ? (text, "") : (text[..i], text[(i + 1)..]);
        }
    }

