    // Il faut la clé du fournisseur IA actif du serveur (posée par un admin dans « Gestion du serveur ») ; réservé aux admins
    // et aux super-admins tant que le propriétaire de cette clé n'a pas ouvert la génération aux joueurs.
    private bool IsAiAllowed => ContextService.CurrentServer is { IsAiGenerationEnabled: true } server
        && ServerAiKey.Active(server) is { } key
        && (key.OpenToPlayers || ContextService.CurrentUserServer?.IsAdmin == true || ContextService.CurrentUser?.SuperAdmin == true);

    // Prompt → programme (Claude) → PlanDocument (générateur) → même chemin que l'import d'un fichier : le plan généré
    // est un brouillon non sauvegardé. Rien n'est gardé en champ : le canvas possède l'état, _document revient par
    // OnPlanChanged et l'analyse se déclenche toute seule. Un plan non vide (généré ou dessiné) peut être modifié : Claude
    // lit sa description (PlanDescriber) et renvoie une modification (PlanEditor), le plan est remplacé en une étape
    // annulable et reste le même plan sauvegardé.
    private async Task GenerateWithAiAsync()
    {
        if (_generating || _clientCatalog is null) return;
        var canEdit = _document.Architecture.Ops.Count > 0 || _document.AllObjects().Any();
        if (!canEdit && _dirty && !await ConfirmDiscardAsync()) return;
        var parameters = new DialogParameters<BuildingPlanPromptDialog> { { d => d.IsEdit, canEdit } };
        var title = LocalizationService.GetTranslation(canEdit ? "BuildingPlanner.Ai.EditTitle" : "BuildingPlanner.Ai.Title");
        var dialog = await DialogService.ShowAsync<BuildingPlanPromptDialog>(title, parameters, new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true });
        var result = await dialog.Result;
        if (result is null || result.Canceled || result.Data is not BuildingPlanPromptDialog.Request request) return;
        var prompt = request.Prompt;
        var edit = request.Edit && canEdit;
        if (canEdit && !edit && _dirty && !await ConfirmDiscardAsync()) return;

        _generating = true;
        StateHasChanged();
        _generateCts?.Cancel();
        _generateCts?.Dispose();
        // Une génération a déjà pris 86 s ; un grand plan décrit en entrée allonge encore l'appel.
        _generateCts = new CancellationTokenSource(TimeSpan.FromSeconds(180));
        try
        {
            var materials = _clientCatalog.Materials.Where(m => !BuildingPlannerCatalogService.PipeMaterials.Contains(m.Name)).Select(m => m.Name).ToList();
            // Portes du catalogue, du plus bas tier au plus haut : l'IA en choisit une par embrasure, le générateur se replie
            // sur la famille du mur puis sur la première (sans porte, la pièce reste ouverte en 3D).
            var doors = _clientCatalog.Objects.Where(o => o.IsDoor).OrderBy(o => o.Tier ?? 0).ThenBy(o => o.Name, StringComparer.Ordinal)
                .Select(o => new FurnitureInfo(o.Name, o.Cells.Where(c => c[3] is 0 or 1 or 2).Select(c => new Vec3i(c[0], c[1], c[2])).ToList())).ToList();
            var furniture = RenderableFurniture(_clientCatalog);
            var credentials = ContextService.CurrentServer is { } server ? PromptService.CredentialsFor(server) : null;
            GeneratorResult gen;
            if (edit)
            {
                var doc = _document;
                var changes = await PromptService.EditAsync(credentials, prompt, PlanDescriber.Describe(doc, _analysis), materials, doors, furniture, _generateCts.Token);
                if (changes.ErrorKey is not null)
                {
                    Snackbar.Add(LocalizationService.GetTranslation("BuildingPlanner.Ai.Error." + changes.ErrorKey), Severity.Error);
                    return;
                }
                gen = PlanEditor.Apply(doc, changes.Edit!, materials, doors, furniture);
            }
            else
            {
                var generated = await PromptService.GenerateAsync(credentials, prompt, materials, doors, furniture, _generateCts.Token);
                if (generated.ErrorKey is not null)
                {
                    Snackbar.Add(LocalizationService.GetTranslation("BuildingPlanner.Ai.Error." + generated.ErrorKey), Severity.Error);
                    return;
                }
                gen = BuildingGenerator.Generate(generated.Program!, materials, doors, furniture);
            }
            if (gen.Document is null)
            {
                Snackbar.Add(LocalizationService.GetTranslation("BuildingPlanner.Ai.Error.Invalid"), Severity.Error);
                return;
            }
            if (!_jsInitialized) return;   // l'utilisateur a changé de serveur pendant l'appel
            if (edit)
            {
                try { await JS.InvokeVoidAsync("ecoBuildingPlanner.replacePlan", _containerId, PlanDocumentJson.Serialize(gen.Document)); }
                catch (JSDisconnectedException) { return; }
                if (gen.Notes.Count > 0) Snackbar.Add(string.Join(" · ", gen.Notes), Severity.Info);
                return;
            }
            _savedPlan = null;
            await RememberLastPlanAsync(null);
            await Js("clearDraft");
            try { await JS.InvokeAsync<bool>("ecoBuildingPlanner.setPlan", _containerId, PlanDocumentJson.Serialize(gen.Document), false); }
            catch (JSDisconnectedException) { return; }
            _backgroundImage = null;
            await Js("setBackgroundImage", (string?)null);
            Navigation.NavigateTo("/building-planner", replace: true);
            if (gen.Notes.Count > 0) Snackbar.Add(string.Join(" · ", gen.Notes), Severity.Info);
        }
        catch (OperationCanceledException) { }
        finally
        {
            _generating = false;
            StateHasChanged();
        }
    }

    // Meubles proposés à l'IA : objets du catalogue (hors portes) que la vue 3D sait dessiner, c.-à-d. présents dans
    // l'index des bundles de formes (wwwroot/assets/forms/index.json, clé « objects ») ; sans bundle, aucun meuble.
    private static List<FurnitureInfo> RenderableFurniture(ClientCatalog catalog)
    {
        var path = Path.Combine(ecocraft.Extensions.StaticEnvironmentAccessor.WebHostEnvironment?.WebRootPath ?? "", "assets", "forms", "index.json");
        if (!File.Exists(path)) return [];
        HashSet<string> modeled;
        try
        {
            using var index = JsonDocument.Parse(File.ReadAllText(path));
            modeled = index.RootElement.TryGetProperty("objects", out var objects) && objects.ValueKind == JsonValueKind.Object
                ? objects.EnumerateObject().Select(p => p.Name).ToHashSet(StringComparer.Ordinal) : [];
        }
        catch (JsonException) { return []; }
        return catalog.Objects
            .Where(o => !o.IsDoor && modeled.Contains(o.Name))
            .Select(o => new FurnitureInfo(o.Name, o.Cells.Where(c => c[3] is 0 or 1 or 2).Select(c => new Vec3i(c[0], c[1], c[2])).ToList()))
            .ToList();
    }

    private async Task OpenPlanAsync()
    {
        var plans = await BuildingPlannerService.ListPlansAsync();
        var parameters = new DialogParameters<BuildingPlanListDialog> { { d => d.Plans, plans } };
        var dialog = await DialogService.ShowAsync<BuildingPlanListDialog>(LocalizationService.GetTranslation("BuildingPlanner.Plan.Open"), parameters, new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true });
        var result = await dialog.Result;
        if (_savedPlan is not null && plans.All(p => p.Id != _savedPlan.Id))
        {
            // Le plan courant a été supprimé depuis le dialogue : il redevient un brouillon non sauvegardé.
            _savedPlan = null;
            await RememberLastPlanAsync(null);
            Navigation.NavigateTo("/building-planner", replace: true);
            await Js("markDirty");
        }
        if (result is null || result.Canceled || result.Data is not BuildingPlan chosen) return;
        if (_dirty && !await ConfirmDiscardAsync()) return;

        var full = await BuildingPlannerService.LoadPlanAsync(chosen.Id);
        if (full is null) return;
        _savedPlan = full;
        await RememberLastPlanAsync(full.Id);
        await JS.InvokeAsync<bool>("ecoBuildingPlanner.setPlan", _containerId, Migrated(full.Document), true);
        _backgroundImage = full.BackgroundImage;
        await Js("setBackgroundImage", _backgroundImage);
        Navigation.NavigateTo($"/building-planner?id={full.Id}", replace: true);
    }

