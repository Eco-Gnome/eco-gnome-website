    private async Task RenameAsync()
    {
        var parameters = new DialogParameters<BuildingPlanSaveDialog> { { d => d.Name, _document.Name } };
        var dialog = await DialogService.ShowAsync<BuildingPlanSaveDialog>(LocalizationService.GetTranslation("BuildingPlanner.Plan.Rename"), parameters, new DialogOptions { MaxWidth = MaxWidth.ExtraSmall, FullWidth = true });
        var result = await dialog.Result;
        if (result is null || result.Canceled || result.Data is not string newName || string.IsNullOrWhiteSpace(newName)) return;
        newName = newName.Trim();
        _document.Name = newName;
        await Js("setName", newName);

        // Plan deja sauvegarde : on persiste le nouveau nom (et l'etat courant) immediatement.
        if (_savedPlan is not null && BuildingPlannerService.OwnsPlan(_savedPlan))
        {
            var latest = await JS.InvokeAsync<string?>("ecoBuildingPlanner.getPlan", _containerId);
            var doc = PlanDocumentJson.TryParse(latest) ?? _document;
            doc.Name = newName;
            _savedPlan = await BuildingPlannerService.SavePlanAsync(_savedPlan, newName, doc, _backgroundImage);
            _document = doc;
            await Js("markSaved");
        }
    }

    private async Task SaveAsync(bool saveAs)
    {
        var name = _document.Name;
        if (saveAs || _savedPlan is null || string.IsNullOrWhiteSpace(name))
        {
            var proposed = string.IsNullOrWhiteSpace(name) ? LocalizationService.GetTranslation("BuildingPlanner.Plan.Untitled") : name;
            if (saveAs) proposed += LocalizationService.GetTranslation("DataContext.CopySuffix");
            var parameters = new DialogParameters<BuildingPlanSaveDialog> { { d => d.Name, proposed } };
            var dialog = await DialogService.ShowAsync<BuildingPlanSaveDialog>(LocalizationService.GetTranslation(saveAs ? "BuildingPlanner.Plan.Duplicate" : "BuildingPlanner.Plan.Save"), parameters, new DialogOptions { MaxWidth = MaxWidth.ExtraSmall, FullWidth = true });
            var result = await dialog.Result;
            if (result is null || result.Canceled || result.Data is not string chosenName || string.IsNullOrWhiteSpace(chosenName)) return;
            name = chosenName.Trim();
        }

        var latest = await JS.InvokeAsync<string?>("ecoBuildingPlanner.getPlan", _containerId);
        var doc = PlanDocumentJson.TryParse(latest) ?? _document;
        _savedPlan = await BuildingPlannerService.SavePlanAsync(saveAs ? null : _savedPlan, name, doc, _backgroundImage);
        await RememberLastPlanAsync(_savedPlan.Id);
        _document = doc;
        await Js("setName", name);
        await Js("markSaved");
        Snackbar.Add(LocalizationService.GetTranslation("BuildingPlanner.Snackbar.Saved", name), Severity.Success);
        Navigation.NavigateTo($"/building-planner?id={_savedPlan.Id}", replace: true);
    }

    private async Task ShareAsync()
    {
        var latest = await JS.InvokeAsync<string?>("ecoBuildingPlanner.getPlan", _containerId);
        var doc = PlanDocumentJson.TryParse(latest) ?? _document;
        var (url, needsSave) = BuildingPlannerService.BuildShareUrl(Navigation.BaseUri, doc, _savedPlan?.Id);
        if (needsSave)
        {
            Snackbar.Add(LocalizationService.GetTranslation("BuildingPlanner.Snackbar.ShareNeedsSave"), Severity.Info);
            await SaveAsync(false);
            if (_savedPlan is null) return;
            (url, _) = BuildingPlannerService.BuildShareUrl(Navigation.BaseUri, doc, _savedPlan.Id);
        }
        if (url is null) return;
        var parameters = new DialogParameters<BuildingPlanShareDialog> { { d => d.Url, url } };
        await DialogService.ShowAsync<BuildingPlanShareDialog>(LocalizationService.GetTranslation("BuildingPlanner.Plan.Share"), parameters, new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true });
    }

    private async Task ResizeAsync()
    {
        var parameters = new DialogParameters<BuildingPlanResizeDialog> { { d => d.Width, _document.Grid.Width }, { d => d.Depth, _document.Grid.Depth } };
        var dialog = await DialogService.ShowAsync<BuildingPlanResizeDialog>(LocalizationService.GetTranslation("BuildingPlanner.Plan.Resize"), parameters, new DialogOptions { MaxWidth = MaxWidth.ExtraSmall, FullWidth = true });
        var result = await dialog.Result;
        if (result is null || result.Canceled || result.Data is not (int width, int depth)) return;
        await Js("resizePlan", width, depth);
    }

    private async Task<bool> ConfirmDiscardAsync()
    {
        try { return await JS.InvokeAsync<bool>("confirm", LocalizationService.GetTranslation("BuildingPlanner.ConfirmDiscard")); }
        catch (JSDisconnectedException) { return true; }
    }

    private async ValueTask OnLocationChanging(LocationChangingContext context)
    {
        if (!_dirty) return;
        if (context.TargetLocation.Contains("/building-planner", StringComparison.OrdinalIgnoreCase)) return;
        if (!await ConfirmDiscardAsync()) context.PreventNavigation();
    }

    private void OnContextChanged()
    {
        _ = InvokeAsync(async () =>
        {
            if (_jsInitialized)
            {
                try { await JS.InvokeVoidAsync("ecoBuildingPlanner.dispose", _containerId); } catch (JSDisconnectedException) { }
                _jsInitialized = false;
            }
            _analysis = null;
            _savedPlan = null;
            _roomDetectionSkipped = false;   // le nouveau canvas ne signale que les changements
            await LoadAsync();
        });
    }

    public async ValueTask DisposeAsync()
    {
        ContextService.OnContextChanged -= OnContextChanged;
        _locationChangingRegistration?.Dispose();
        _analyzeCts?.Cancel();
        _analyzeCts?.Dispose();
        _generateCts?.Cancel();
        _generateCts?.Dispose();
        if (_jsInitialized)
        {
            try { await JS.InvokeVoidAsync("ecoBuildingPlanner.dispose", _containerId); }
            catch (JSDisconnectedException) { }
        }
        _selfRef?.Dispose();
    }
}
