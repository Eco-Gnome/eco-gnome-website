    // Context new recipes copy their skills and tables from: the list's source, or else the default calculator context.
    private async Task LoadReferenceDataContext()
    {
        var referenceDataContextId = GetSelectedSourceId()
                                     ?? ContextService.CurrentUserServer!.DataContexts.FirstOrDefault(d => !d.IsShoppingList && d.IsDefault)?.Id;
        try
        {
            _referenceDataContext = referenceDataContextId is not null && _serverData is not null
                ? await DataContextDbService.GetDataContextWithData(referenceDataContextId.Value, _serverData)
                : null;
        }
        catch (Exception)
        {
            _referenceDataContext = null;
        }
    }

    // Saves the list's source (null = the default context); it only applies to what recipes add from now on.
    private async Task OnSourceChanged(Guid? sourceId)
    {
        if (_selectedShoppingList is null)
        {
            return;
        }

        // The chips hold their own instance of the list: keep it in sync.
        _selectedShoppingList.SourceDataContextId = sourceId;
        var chipShoppingList = ContextService.CurrentUserServer!.DataContexts.FirstOrDefault(d => d.Id == _selectedShoppingList.Id);
        if (chipShoppingList is not null)
        {
            chipShoppingList.SourceDataContextId = sourceId;
        }

        await EcoCraftDbContext.ContextSaveAsync(EcoCraftDbFactory, context =>
        {
            DataContextDbService.UpdateSource(context, _selectedShoppingList);
            return Task.CompletedTask;
        });

        await LoadReferenceDataContext();
    }

    // Copies the reference context into the list's skills and tables, once.
    private async Task ImportSource()
    {
        if (_selectedShoppingList is null || _referenceDataContext is null)
        {
            return;
        }

        await EcoCraftDbContext.ContextSaveAsync(EcoCraftDbFactory, async context =>
        {
            await ShoppingListDataService.ApplySourceDataContext(context, _selectedShoppingList, _referenceDataContext);
            await ApplyAutoExpandForMissingIngredients(context, _selectedShoppingList.UserRecipes);
        });

        Rebuild();
    }

    private async Task OnTalentsChanged()
    {
        await EcoCraftDbContext.ContextSaveAsync(EcoCraftDbFactory, async context =>
        {
            ShoppingListDataService.SynchronizeRecipeTree(context, _selectedShoppingList!);
            await ApplyAutoExpandForMissingIngredients(context, _selectedShoppingList!.UserRecipes);
        });

        Rebuild();
    }

    public async Task OnLevelChanged(UserSkill userSkill, int level)
    {
        if (_selectedShoppingList is null || userSkill.Level == level)
        {
            return;
        }

        var isIncrease = level > userSkill.Level;
        userSkill.Level = level;

        await EcoCraftDbContext.ContextSaveAsync(EcoCraftDbFactory, async context =>
        {
            UserSkillDbService.UpdateLevel(context, userSkill);

            if (!isIncrease)
            {
                UserServerDataService.RemoveTalentsAboveLevel(context, _selectedShoppingList, userSkill);
            }

            ShoppingListDataService.SynchronizeRecipeTree(context, _selectedShoppingList);
            await ApplyAutoExpandForMissingIngredients(context, _selectedShoppingList.UserRecipes);
        });

        Rebuild();
    }

    // Sets the modules of one slot (v4 slot+bonus system); the per-slot invariant
    // lives in UserCraftingTable.SetPluginModulesForSlot.
    private async Task SelectPluginModule(UserCraftingTable shoppingListCraftingTable, CraftingTablePluginModuleControl.ModuleSelection selection)
    {
        if (!shoppingListCraftingTable.SetPluginModulesForSlot(selection.ModuleSlot, selection.PluginModules))
        {
            return;
        }

        await EcoCraftDbContext.ContextSaveAsync(EcoCraftDbFactory, async context =>
        {
            await PersistCraftingTableAndSynchronize(context, shoppingListCraftingTable);
        });

        Rebuild();
    }

    private Task<IEnumerable<Recipe>> SearchRecipes(string value, CancellationToken token)
    {
        if (_serverData is null)
        {
            return Task.FromResult(Enumerable.Empty<Recipe>());
        }

        IEnumerable<Recipe> result;

        if (string.IsNullOrEmpty(value))
        {
            result = _serverData.Recipes;
        }
        else
        {
            // Nom de la recette ou de son métier : taper un métier liste ses recettes.
            result = _serverData.Recipes
                .Where(r => LocalizationService.GetTranslation(r).Contains(value, StringComparison.InvariantCultureIgnoreCase)
                            || (r.Skill is not null && LocalizationService.GetTranslation(r.Skill).Contains(value, StringComparison.InvariantCultureIgnoreCase)))
                .ToList();
        }

        var selectedRecipeIds = _selectedShoppingList!.UserRecipes
            .Where(slr => slr.ParentUserRecipe is not null)
            .Select(slr => slr.RecipeId)
            .ToHashSet();
        result = result.Where(r => !selectedRecipeIds.Contains(r.Id)).OrderBy(r => r.Skill?.Name ?? "zzz").ThenBy(r => r.Name);

        return Task.FromResult(result);
    }


    private async Task AddShoppingListRecipe(Recipe? recipe)
    {
        if (recipe is null) return;

        if (_isGuidedRunActive)
        {
            ResetGuidedRunState();
        }

        await EcoCraftDbContext.ContextSaveAsync(EcoCraftDbFactory, async context =>
        {
            var createdRecipe = await ShoppingListDataService.AddUserRecipe(context, _selectedShoppingList!, recipe, sourceDataContext: _referenceDataContext);
            await ApplyAutoExpandForMissingIngredients(context, new[] { createdRecipe });
        });

        _emptyRecipe = null;

        Rebuild();
        await RefreshRecipeAutocompleteAsync();
    }

    private async Task RemoveAllUserData()
    {
        var currentServer = ContextService.CurrentServer!;
        await ContextService.LeaveServer(ContextService.CurrentUserServer!);

        if (ContextService.CurrentUser!.UserServers.Any())
        {
            await ContextService.ChangeServer(currentServer);
        }

        Navigation.NavigateTo("/shopping-list", forceLoad: true);
    }

    private async Task PersistCraftingTableAndSynchronize(EcoCraftDbContext context, UserCraftingTable shoppingListCraftingTable)
    {
        await UserCraftingTableDbService.UpdateAllAsync(context, shoppingListCraftingTable);
        ShoppingListDataService.SynchronizeRecipeTree(context, _selectedShoppingList!);
        await ApplyAutoExpandForMissingIngredients(context, _selectedShoppingList!.UserRecipes);
    }

    private async Task RefreshRecipeAutocompleteAsync()
    {
        await Task.Yield();

        if (_recipeAutocompleteRef is not null)
        {
            await _recipeAutocompleteRef.ClearAsync();
        }
    }
}
