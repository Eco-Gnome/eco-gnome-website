@page "/shopping-list"
@implements IDisposable
@using ecocraft.Models
@using ecocraft.Services
@using ecocraft.Components.Utils
@using ecocraft.Components.Dialog
@using ecocraft.Services.DbServices
@using Microsoft.EntityFrameworkCore
@using System.Globalization
@inject IDialogService DialogService
@inject ContextService ContextService
@inject LocalStorageService LocalStorageService
@inject ShoppingListDataService ShoppingListDataService
@inject ShoppingListService ShoppingListService
@inject LocalizationService LocalizationService
@inject UserSkillDbService UserSkillDbService
@inject UserCraftingTableDbService UserCraftingTableDbService
@inject UserRecipeDbService UserRecipeDbService
@inject UserShoppingListItemDbService UserShoppingListItemDbService
@inject UserServerDataService UserServerDataService
@inject ServerDbService ServerDbService
@inject DataContextDbService DataContextDbService
@inject IJSRuntime JsRuntime
@inject NavigationManager Navigation
@inject IDbContextFactory<EcoCraftDbContext> EcoCraftDbFactory

<PageTitle>@LocalizationService.GetTranslation("ShoppingList.PageTitle") - Eco Gnome</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="pa-0">
    <ChildContent>
        <MudGrid Style="height: auto">
            <MudItem xs="12" Class="px-4 pt-4">
                <MudStack Row Spacing="3">
                    @foreach (var shoppingList in ContextService.CurrentUserServer!.DataContexts.Where(d => d.IsShoppingList))
                    {
                        <ContextChip @key="shoppingList.Id"
                                     DataContext="shoppingList"
                                     IsSelected="_selectedShoppingList?.Id == shoppingList.Id"
                                     CanDelete="true"
                                     CanRename="true"
                                     CanDuplicate="true"
                                     CanSetDefault="false"
                                     StartInRenameMode="@(_pendingRenameShoppingListId == shoppingList.Id)"
                                     OnSelect="@(() => SelectShoppingList(shoppingList))"
                                     OnRename="@(newName => RenameShoppingList(shoppingList, newName))"
                                     OnDuplicate="@(() => DuplicateShoppingList(shoppingList))"
                                     OnDelete="@(() => DeleteShoppingList(shoppingList))" />
                    }
                    <MudButton Color="Color.Tertiary"
                               EndIcon="@MDIIcons.Filled.Plus"
                               Variant="Variant.Outlined"
                               OnClick="@(() => AddShoppingList())">
                        @LocalizationService.GetTranslation("ShoppingList.AddShoppingList")
                    </MudButton>
                </MudStack>
            </MudItem>

            @if (_isLoadingData)
            {
                <MudItem xs="12" Class="px-4 pt-4">
                    <MudStack Justify="Justify.Center" AlignItems="AlignItems.Center">
                        <MudProgressCircular Size="Size.Large" Color="Color.Primary" Indeterminate="true" Class="ml-2"/>
                    </MudStack>
                </MudItem>
            }
            else if (_selectedShoppingList is not null)
            {
                <ErrorBoundary>
                    <ChildContent>
                        <MudItem xs="12" Class="px-4 pt-2">
                            @* Bandeau en lecture seule : on modifie via « Métiers & tables » (fenêtre) et « Ouverture automatique » (popover). *@
                            <MudPaper Class="sl-strip">
                                @{
                                    var stripSkills = _selectedShoppingList.UserSkills.Where(us => us.Skill is not null).ToList();
                                    var stripTables = _selectedShoppingList.UserCraftingTables.OrderBy(c => LocalizationService.GetTranslation(c.CraftingTable)).ToList();
                                }
                                <MudButton Variant="Variant.Outlined" Class="sl-strip-button" OnClick="OpenConfigDialog">
                                    <MudIcon Icon="@MDIIcons.Outline.AccountHardHat" Class="mr-2"/>
                                    <span class="sl-strip-button-text">
                                        <span class="sl-strip-button-title">@LocalizationService.GetTranslation("ShoppingList.ConfigButton")</span>
                                        <span class="sl-strip-button-summary">@LocalizationService.GetTranslation("ShoppingList.ConfigSummary", stripSkills.Count.ToString(), stripTables.Count.ToString())</span>
                                    </span>
                                    <MudIcon Icon="@MDIIcons.Outline.Pencil" Size="Size.Small" Class="ml-2 sl-muted"/>
                                </MudButton>
                                <span class="sl-strip-separator"></span>
                                <span class="sl-strip-label">@LocalizationService.GetTranslation("ShoppingList.StripSkills")</span>
                                <div class="sl-strip-icons">
                                    @foreach (var userSkill in stripSkills.Take(StripMaxIcons))
                                    {
                                        <MudTooltip Text="@LocalizationService.GetTranslation(userSkill.Skill)">
                                            <div class="sl-strip-icon">
                                                <EcoIcon Item="@userSkill.Skill" Size="32"/>
                                                <span class="sl-strip-level">@userSkill.Level</span>
                                            </div>
                                        </MudTooltip>
                                    }
                                    @if (stripSkills.Count > StripMaxIcons)
                                    {
                                        var moreSkills = (stripSkills.Count - StripMaxIcons).ToString();
                                        <MudTooltip Text="@LocalizationService.GetTranslation("ShoppingList.MoreSkills", moreSkills)">
                                            <div class="sl-strip-more" @onclick="OpenConfigDialog">+@moreSkills</div>
                                        </MudTooltip>
                                    }
                                </div>
                                <span class="sl-strip-separator"></span>
                                <span class="sl-strip-label">@LocalizationService.GetTranslation("ShoppingList.StripTables")</span>
                                <div class="sl-strip-icons">
                                    @foreach (var userCraftingTable in stripTables.Take(StripMaxIcons))
                                    {
                                        var firstModule = GetFirstSlotModule(userCraftingTable);
                                        <MudTooltip Text="@LocalizationService.GetTranslation(userCraftingTable.CraftingTable)">
                                            <div class="sl-strip-icon">
                                                <EcoIcon Item="@userCraftingTable.CraftingTable" Size="32"/>
                                                @if (firstModule is not null)
                                                {
                                                    <EcoIcon Item="@firstModule" Size="18" Class="sl-strip-module"/>
                                                }
                                            </div>
                                        </MudTooltip>
                                    }
                                    @if (stripTables.Count > StripMaxIcons)
                                    {
                                        var moreTables = (stripTables.Count - StripMaxIcons).ToString();
                                        <MudTooltip Text="@LocalizationService.GetTranslation("ShoppingList.MoreTables", moreTables)">
                                            <div class="sl-strip-more" @onclick="OpenConfigDialog">+@moreTables</div>
                                        </MudTooltip>
                                    }
                                </div>
                                <span class="flex-grow-1"></span>
                                <div class="sl-auto-open-anchor">
                                    <MudButton Variant="Variant.Outlined" Class="sl-strip-button" OnClick="@(() => _isAutoOpenPopoverOpen = !_isAutoOpenPopoverOpen)">
                                        <MudIcon Icon="@MDIIcons.Filled.AutoFix" Class="mr-2"/>
                                        <span class="sl-strip-button-text">
                                            <span class="sl-strip-button-title">@LocalizationService.GetTranslation("ShoppingList.AutoOpenButton")</span>
                                            <span class="sl-strip-button-summary">@GetAutoOpenSummary()</span>
                                        </span>
                                        <MudIcon Icon="@MDIIcons.Filled.ChevronDown" Size="Size.Small" Class="ml-2"/>
                                    </MudButton>
                                    <MudOverlay Visible="_isAutoOpenPopoverOpen" VisibleChanged="@(v => _isAutoOpenPopoverOpen = v)" AutoClose="true" LockScroll="false"/>
                                    @* Le Class d'un MudPopover téléporté n'est pas atteignable par le CSS scoped : largeur/fond en Style. *@
                                    <MudPopover Open="_isAutoOpenPopoverOpen" AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight" Elevation="8"
                                                Style="width: 460px; max-width: calc(100vw - 32px); background: #41424c; border-radius: 4px;">
                                        <div class="sl-auto-open">
                                            <div class="sl-auto-open-head">
                                                <span class="sl-auto-open-title">@LocalizationService.GetTranslation("ShoppingList.AutoOpenTitle")</span>
                                                <MudIconButton Icon="@MDIIcons.Filled.Close" Size="Size.Small" OnClick="@(() => _isAutoOpenPopoverOpen = false)"/>
                                            </div>
                                            @AutoOpenOption("ReuseChoices", _isAutoExpandEnabled, OnAutoExpandChanged)
                                            @AutoOpenOption("Propagate", _isRecipeChoicePropagationEnabled, OnRecipeChoicePropagationChanged)
                                            @AutoOpenOption("Guided", _isGuidedAutoExpandEnabled, OnGuidedAutoExpandChanged)
                                        </div>
                                    </MudPopover>
                                </div>
                            </MudPaper>
                        </MudItem>
                        <MudItem xs="12" lg="8" Class="pa-2 pl-4">
                            <MudPaper Class="pa-3">
                                <MudStack Row AlignItems="AlignItems.Center" Spacing="2" Class="mb-2" Wrap="Wrap.Wrap">
                                    <MudAutocomplete T="Recipe"
                                                     @ref="_recipeAutocompleteRef"
                                                     Value="_emptyRecipe"
                                                     Disabled="@(_serverData is null || _serverData.Recipes.Count == 0)"
                                                     SearchFunc="SearchRecipes"
                                                     ValueChanged="AddShoppingListRecipe"
                                                     CoerceText="false"
                                                     Placeholder="@LocalizationService.GetTranslation("PriceCalculator.AddRecipe")"
                                                     Class="auto-complete-input flex-grow-1"
                                                     Dense="true"
                                                     MaxItems="RecipeSearchMaxItems"
                                                     DebounceInterval="200"
                                                     Variant="Variant.Outlined"
                                                     AnchorOrigin="Origin.BottomLeft"
                                                     TransformOrigin="Origin.TopLeft">
                                        <ItemTemplate>
                                            <RecipeSummary Recipe="context" Class="pl-2" />
                                        </ItemTemplate>
                                        <MoreItemsTemplate>
                                            <MudText Typo="Typo.caption" Class="pa-2 mud-text-secondary">@LocalizationService.GetTranslation("ShoppingList.RecipeSearchMore")</MudText>
                                        </MoreItemsTemplate>
                                    </MudAutocomplete>
                                    <MudButton Variant="Variant.Text"
                                               Color="Color.Tertiary"
                                               StartIcon="@MDIIcons.Filled.Sitemap"
                                               Disabled="@(_selectedShoppingList.UserRecipes.Count == 0)"
                                               OnClick="OpenProductionChainGraph">
                                        @LocalizationService.GetTranslation("ShoppingList.VisualizeProductionChain")
                                    </MudButton>
                                    @if (ContextService.CurrentServer?.IsAutomationPlannerEnabled == true)
                                    {
                                        <MudButton Variant="Variant.Text"
                                                   Color="Color.Tertiary"
                                                   StartIcon="@MDIIcons.Filled.Factory"
                                                   Disabled="@(_selectedShoppingList.UserRecipes.Count == 0)"
                                                   OnClick="OpenAutomationGraph">
                                            @LocalizationService.GetTranslation("ShoppingList.AutomationButton")
                                        </MudButton>
                                    }
                                    <MudButton Variant="Variant.Text"
                                               StartIcon="@(_collapsedRows.Count > 0 ? MDIIcons.Filled.UnfoldMoreHorizontal : MDIIcons.Filled.UnfoldLessHorizontal)"
                                               Disabled="@(_selectedShoppingList.UserRecipes.Count == 0)"
                                               OnClick="ToggleAllRows">
                                        @LocalizationService.GetTranslation(_collapsedRows.Count > 0 ? "ShoppingList.ExpandAll" : "ShoppingList.CollapseAll")
                                    </MudButton>
                                </MudStack>
                                <div class="sl-tree">
                                    <div class="sl-tree-row sl-tree-head">
                                        <span>@LocalizationService.GetTranslation("ShoppingList.ColumnItem")</span>
                                        <span class="sl-right">@LocalizationService.GetTranslation("ShoppingList.ColumnQuantity")</span>
                                        <span>@LocalizationService.GetTranslation("ShoppingList.ObtainedVia")</span>
                                        <span></span>
                                    </div>
                                    @foreach (var rootRecipe in _selectedShoppingList.GetRootShoppingListRecipes())
                                    {
                                        @RecipeRow(rootRecipe, 0)
                                    }
                                </div>
                            </MudPaper>
                        </MudItem>
                        <MudItem xs="12" lg="4" Class="pa-2 pr-4">
                            <MudStack Spacing="4">
                                <MudExpansionPanels MultiExpansion="true" Class="sl-side-panels">
                                    @if (_view.Tags.Count > 0)
                                    {
                                        <MudExpansionPanel @bind-Expanded="ExpandedTagsPanel" Gutters="false">
                                            <TitleContent>
                                                <div class="sl-panel-head">
                                                    <MudIcon Icon="@MDIIcons.Outline.TagMultiple" Color="Color.Primary" Size="Size.Small"/>
                                                    <span class="sl-panel-title">@LocalizationService.GetTranslation("ShoppingList.TagsToConfigure")</span>
                                                    <span class="sl-muted">@_view.Tags.Count</span>
                                                    <span class="flex-grow-1"></span>
                                                    <span class="sl-caption">@LocalizationService.GetTranslation("ShoppingList.AnyOfTagCount", _view.Tags.Count(t => t.ChosenItem is null).ToString())</span>
                                                </div>
                                            </TitleContent>
                                            <ChildContent>
                                                <div class="sl-panel-body">
                                                    <div class="sl-caption pb-1">@LocalizationService.GetTranslation("ShoppingList.TagsHelp")</div>
                                                    @foreach (var tagRow in _view.Tags)
                                                    {
                                                        <div class="sl-tag-row">
                                                            <EcoIcon Item="@tagRow.Tag" Size="28"/>
                                                            <span class="sl-tag-name">
                                                                <span>@LocalizationService.GetTranslation(tagRow.Tag) <span class="sl-muted">×@FormatQuantity(tagRow.Need)</span></span>
                                                                <span class="sl-tag-choice">★ @(tagRow.ChosenItem is null ? LocalizationService.GetTranslation("ShoppingList.AnyOfTagLong") : LocalizationService.GetTranslation(tagRow.ChosenItem))</span>
                                                            </span>
                                                            <div class="sl-tag-candidates">
                                                                @foreach (var candidate in GetTagCandidates(tagRow.Tag))
                                                                {
                                                                    var isChosen = candidate.IsTag ? tagRow.ChosenItem is null : tagRow.ChosenItem?.Id == candidate.Id;
                                                                    <MudTooltip Text="@(candidate.IsTag ? LocalizationService.GetTranslation("ShoppingList.AnyOfTagLong") : LocalizationService.GetTranslation(candidate))">
                                                                        <span class="@($"sl-tag-candidate{(isChosen ? " sl-chosen" : "")}")" @onclick="@(() => ChooseTagItem(tagRow.Tag, candidate.IsTag ? null : candidate))">
                                                                            <EcoIcon Item="@candidate" Size="24"/>
                                                                            <MudIcon Icon="@(isChosen ? MDIIcons.Filled.Star : MDIIcons.Outline.Star)" Class="sl-tag-star"/>
                                                                        </span>
                                                                    </MudTooltip>
                                                                }
                                                            </div>
                                                        </div>
                                                    }
                                                </div>
                                            </ChildContent>
                                        </MudExpansionPanel>
                                    }
                                    <MudExpansionPanel @bind-Expanded="ExpandedBuyPanel" Gutters="false">
                                        <TitleContent>
                                            <div class="sl-panel-head">
                                                <MudIcon Icon="@MDIIcons.Outline.Cart" Color="Color.Secondary" Size="Size.Small"/>
                                                <span class="sl-panel-title">@LocalizationService.GetTranslation("ShoppingList.ItemsToBuy")</span>
                                                <span class="sl-muted">@_view.ToBuy.Count</span>
                                                <span class="flex-grow-1"></span>
                                                <span class="sl-caption">@LocalizationService.GetTranslation("ShoppingList.InStockCount", _view.ToBuy.Count(r => r.IsInStock).ToString(), _view.ToBuy.Count.ToString())</span>
                                            </div>
                                        </TitleContent>
                                        <ChildContent>
                                            <div class="sl-panel-body">
                                                <div class="sl-buy-row sl-buy-head">
                                                    <span></span><span></span>
                                                    <span>@LocalizationService.GetTranslation("ShoppingList.ColumnItem")</span>
                                                    <span class="sl-right">@LocalizationService.GetTranslation("ShoppingList.Need")</span>
                                                    <span class="sl-right">@LocalizationService.GetTranslation("ShoppingList.IHave")</span>
                                                    <span class="sl-right">@LocalizationService.GetTranslation("ShoppingList.Remaining")</span>
                                                </div>
                                                @foreach (var buyRow in _view.ToBuy)
                                                {
                                                    <div class="@($"sl-buy-row{(buyRow.IsInStock ? " sl-in-stock" : "")}")">
                                                        <MudTooltip Text="@LocalizationService.GetTranslation("ShoppingList.AllInStock")">
                                                            <MudIconButton Icon="@(buyRow.IsInStock ? MDIIcons.Filled.CheckboxMarked : buyRow.Stock > 0 ? MDIIcons.Filled.CheckboxIntermediate : MDIIcons.Outline.CheckboxBlank)"
                                                                           Color="@(buyRow.Stock > 0 ? Color.Success : Color.Default)"
                                                                           Size="Size.Small"
                                                                           Class="pa-0"
                                                                           OnClick="@(() => SetStock(buyRow.ItemOrTag, buyRow.IsInStock ? 0 : buyRow.Need))"/>
                                                        </MudTooltip>
                                                        <EcoIcon Item="@buyRow.ItemOrTag" Size="26"/>
                                                        <span class="sl-buy-name">@LocalizationService.GetTranslation(buyRow.ItemOrTag)</span>
                                                        <span class="sl-right sl-muted">@FormatQuantity(buyRow.Need)</span>
                                                        <MudNumericField T="decimal"
                                                                         Value="@buyRow.Stock"
                                                                         ValueChanged="@(v => SetStock(buyRow.ItemOrTag, v))"
                                                                         Min="0"
                                                                         Format="0.##"
                                                                         Culture="CultureInfo.InvariantCulture"
                                                                         HideSpinButtons="true"
                                                                         Variant="Variant.Outlined"
                                                                         Margin="Margin.Dense"
                                                                         Class="sl-stock-input"/>
                                                        <span class="sl-right sl-remaining">@FormatQuantity(buyRow.Remaining)</span>
                                                    </div>
                                                }
                                            </div>
                                        </ChildContent>
                                    </MudExpansionPanel>
                                </MudExpansionPanels>
                                @if (_view.Surplus.Count > 0)
                                {
                                    <MudPaper Class="pa-3">
                                        <MudText Typo="Typo.subtitle1" Class="mb-1">@LocalizationService.GetTranslation("ShoppingList.ItemsProduced")</MudText>
                                        @foreach (var (itemOrTag, quantity) in _view.Surplus)
                                        {
                                            <div class="sl-surplus-row">
                                                <EcoIcon Item="@itemOrTag" Size="24"/>
                                                <span class="flex-grow-1">@LocalizationService.GetTranslation(itemOrTag)</span>
                                                <span class="sl-surplus-quantity">+@FormatQuantity(quantity)</span>
                                            </div>
                                        }
                                    </MudPaper>
                                }
                            </MudStack>
                        </MudItem>
                    </ChildContent>
                    <ErrorContent>
                        <MudStack Justify="Justify.Center" AlignItems="AlignItems.Center">
                            <MudAlert Severity="Severity.Error">@LocalizationService.GetTranslation("PriceCalculator.LoadError")</MudAlert>
                            <MudButton Variant="Variant.Filled" StartIcon="@MDIIcons.Filled.DeleteForever" Color="Color.Error" OnClick="@(() => RemoveAllUserData())">@LocalizationService.GetTranslation("PriceCalculator.Reset")</MudButton>
                        </MudStack>
                    </ErrorContent>
                </ErrorBoundary>
            }
        </MudGrid>
    </ChildContent>
</MudContainer>

@code {
    private DataContext? _selectedShoppingList;
    // Price calculator context the list copies skills, talents and tables from: its source, or the default context.
    private DataContext? _referenceDataContext;
    private bool _isLoadingData;
    private Server? _serverData;

    private const int StripMaxIcons = 6;
    // Chaque résultat est un RecipeSummary (une dizaine de composants) : afficher toutes les recettes du serveur
    // rendait l'ouverture du champ très lente. Au-delà, on invite à affiner la recherche.
    private const int RecipeSearchMaxItems = 50;
    private bool _isAutoOpenPopoverOpen;
    // Lignes repliées de l'arbre (clés RecipeRowKey / IngredientRowKey) ; tout est déplié par défaut.
    private readonly HashSet<string> _collapsedRows = [];
    private ShoppingListView _view = ShoppingListView.Empty;

    private bool _expandedTagsPanel;
    private bool ExpandedTagsPanel
    {
        get => _expandedTagsPanel;
        set
        {
            _expandedTagsPanel = value;
            _ = LocalStorageService.AddItem("ShoppingListTagsExpanded", value.ToString());
        }
    }

    private bool _expandedBuyPanel;
    private bool ExpandedBuyPanel
    {
        get => _expandedBuyPanel;
        set
        {
            _expandedBuyPanel = value;
            _ = LocalStorageService.AddItem("ShoppingListBuyExpanded", value.ToString());
        }
    }

    private const string AutoExpandStorageKey = "ShoppingListAutoExpand";
    private const string LegacyAutoExpandStorageKey = "ShoppingListAutoUseExistingChoice";
    private const string RecipeChoicePropagationStorageKey = "ShoppingListAutoPropagateRecipeChoice";
    private const string GuidedAutoExpandStorageKey = "ShoppingListGuidedAutoExpand";

    private bool _isAutoExpandEnabled;
    private bool _isRecipeChoicePropagationEnabled;
    private bool _isGuidedAutoExpandEnabled;
    private bool _isGuidedRunActive;
    private readonly Queue<Guid> _guidedRunQueue = new();
    private readonly HashSet<Guid> _guidedRunQueuedIds = [];
    private Guid? _guidedPendingParentRecipeId;
    private Guid? _guidedPendingIngredientId;
    private ElementReference _guidedPendingChoiceAnchorRef;
    private bool _shouldScrollToGuidedPendingChoice;

    private Recipe? _emptyRecipe;
    private MudAutocomplete<Recipe>? _recipeAutocompleteRef;
    // Menu de choix de recette ouvert sous un ingrédient (recette parente + ingrédient).
    private Guid? _openedParentRecipeId;
    private Guid? _openedIngredientId;
    private bool IsGuidedRunPaused => _isGuidedRunActive && _guidedPendingParentRecipeId.HasValue && _guidedPendingIngredientId.HasValue;

    protected override void OnInitialized()
    {
        ContextService.OnContextChanged += OnContextChanged;
    }

    protected override async Task OnInitializedAsync()
    {
        _expandedTagsPanel = await LocalStorageService.GetItem("ShoppingListTagsExpanded") != "False";
        _expandedBuyPanel = await LocalStorageService.GetItem("ShoppingListBuyExpanded") != "False";

        var autoExpandSetting = await LocalStorageService.GetItem(AutoExpandStorageKey);
        if (string.IsNullOrEmpty(autoExpandSetting))
        {
            autoExpandSetting = await LocalStorageService.GetItem(LegacyAutoExpandStorageKey);
        }

        _isAutoExpandEnabled = autoExpandSetting == "True";
        _isRecipeChoicePropagationEnabled = await LocalStorageService.GetItem(RecipeChoicePropagationStorageKey) == "True";
        _isGuidedAutoExpandEnabled = await LocalStorageService.GetItem(GuidedAutoExpandStorageKey) == "True";
    }

    private async Task OnAutoExpandChanged(bool value)
    {
        _isAutoExpandEnabled = value;
        await LocalStorageService.AddItem(AutoExpandStorageKey, value.ToString());
    }

    private async Task OnRecipeChoicePropagationChanged(bool value)
    {
        _isRecipeChoicePropagationEnabled = value;
        await LocalStorageService.AddItem(RecipeChoicePropagationStorageKey, value.ToString());
    }

    private async Task OnGuidedAutoExpandChanged(bool value)
    {
        _isGuidedAutoExpandEnabled = value;
        await LocalStorageService.AddItem(GuidedAutoExpandStorageKey, value.ToString());
        if (!value && _isGuidedRunActive)
        {
            ResetGuidedRunState();
            Rebuild();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await RetrieveData();
            return;
        }

        if (_shouldScrollToGuidedPendingChoice && IsGuidedRunPaused)
        {
            _shouldScrollToGuidedPendingChoice = false;
            await JsRuntime.InvokeVoidAsync("scrollElementIntoViewCenter", _guidedPendingChoiceAnchorRef);
        }
    }

    // Colonne de droite (tags, à acheter, surplus), recalculée à chaque changement de l'arbre, du stock ou d'un tag.
    // Un tag dont l'objet est choisi est reporté sur cet objet (et additionné s'il est aussi acheté en direct) ;
    // le stock est seulement déduit du reste à acheter, l'arbre n'en tient pas compte.
    private void RebuildView()
    {
        if (_selectedShoppingList is null)
        {
            _view = ShoppingListView.Empty;
            return;
        }

        var outputs = ShoppingListService.GetAggregatedOutputs(_selectedShoppingList, _selectedShoppingList.GetRootShoppingListRecipes());
        var settings = _selectedShoppingList.UserShoppingListItems.ToDictionary(usli => usli.ItemOrTagId);

        var tags = new List<TagRow>();
        var needs = new Dictionary<Guid, (ItemOrTag ItemOrTag, decimal Need)>();
        foreach (var (itemOrTag, value) in outputs.Where(o => o.Value < 0))
        {
            var target = itemOrTag;
            if (itemOrTag.IsTag)
            {
                var chosenItem = settings.GetValueOrDefault(itemOrTag.Id)?.ChosenItem;
                tags.Add(new TagRow(itemOrTag, RoundNeed(value), chosenItem));
                target = chosenItem ?? itemOrTag;
            }

            needs[target.Id] = (target, (needs.TryGetValue(target.Id, out var existing) ? existing.Need : 0) + Math.Abs(value));
        }

        var toBuy = needs.Values
            .Select(n => new BuyRow(n.ItemOrTag, RoundNeed(n.Need), settings.GetValueOrDefault(n.ItemOrTag.Id)?.Stock ?? 0))
            .ToList();

        _view = new ShoppingListView(
            tags.OrderBy(t => LocalizationService.GetTranslation(t.Tag)).ToList(),
            toBuy,
            toBuy.ToDictionary(r => r.ItemOrTag.Id),
            outputs.Where(o => o.Value > 0).Select(o => (o.Key, o.Value)).ToList());
    }

    // Comme l'export vers le jeu (EcoApiDataService) : on achète des objets entiers.
    private static decimal RoundNeed(decimal value) => Math.Ceiling(Math.Round(Math.Abs(value), 4));

    private static string FormatQuantity(decimal value) => Math.Round(value, 2).ToString("0.##", CultureInfo.InvariantCulture);

    private sealed record TagRow(ItemOrTag Tag, decimal Need, ItemOrTag? ChosenItem);

    private sealed record BuyRow(ItemOrTag ItemOrTag, decimal Need, decimal Stock)
    {
        public decimal Remaining => Math.Max(0, Need - Stock);
        public bool IsInStock => Stock >= Need;
    }

    private sealed record ShoppingListView(List<TagRow> Tags, List<BuyRow> ToBuy, Dictionary<Guid, BuyRow> BuyRowsById, List<(ItemOrTag ItemOrTag, decimal Quantity)> Surplus)
    {
        public static readonly ShoppingListView Empty = new([], [], [], []);
    }

    private static decimal GetIngredientQuantityGoal(UserRecipe userRecipe, Element ingredient, DataContext shoppingList)
    {
        return Math.Abs(ingredient.Quantity.GetDynamicValue(shoppingList) * userRecipe.RoundFactor);
    }

    private static decimal GetProducedQuantityForIngredient(UserRecipe parentRecipe, Element ingredient, DataContext shoppingList)
    {
        return ShoppingListCoverageCalculator.GetCoveredQuantityForIngredient(
            parentRecipe,
            ingredient,
            shoppingList,
            parentRecipe.ChildrenUserRecipes);
    }

    private List<Recipe> GetPossibleRecipesForIngredient(Element ingredient)
    {
        if (_serverData is null)
        {
            return [];
        }

        return _serverData.Recipes
            .Where(r => r.Elements.Any(e => e.IsProduct()
                && !e.DefaultIsReintegrated
                && ShoppingListCoverageCalculator.CanSupplyIngredient(e.ItemOrTag, ingredient.ItemOrTag)))
            .ToList();
    }

    private Recipe? GetSingleExistingRecipeChoiceForIngredient(Element ingredient, List<Recipe> possibleRecipes)
    {
        if (_selectedShoppingList is null)
        {
            return null;
        }

        var possibleRecipeIds = possibleRecipes.Select(r => r.Id).ToHashSet();
        var matchingRecipeIds = _selectedShoppingList.UserRecipes
            .Where(ur => ur.Recipe.Elements.Any(e => e.IsProduct()
                && !e.DefaultIsReintegrated
                && ShoppingListCoverageCalculator.CanSupplyIngredient(e.ItemOrTag, ingredient.ItemOrTag)))
            .Select(ur => ur.RecipeId)
            .Where(recipeId => possibleRecipeIds.Contains(recipeId))
            .Distinct()
            .ToList();

        if (matchingRecipeIds.Count != 1)
        {
            return null;
        }

        return possibleRecipes.FirstOrDefault(r => r.Id == matchingRecipeIds[0]);
    }

    private static bool IsIngredientAlreadyInBranch(UserRecipe parentRecipe, Element ingredient)
    {
        UserRecipe? current = parentRecipe;
        while (current is not null)
        {
            var containsItemInBranch = current.Recipe.Elements.Any(e =>
                e.IsProduct() &&
                !e.DefaultIsReintegrated &&
                ShoppingListCoverageCalculator.CanSupplyIngredient(e.ItemOrTag, ingredient.ItemOrTag));
            if (containsItemInBranch)
            {
                return true;
            }

            current = current.ParentUserRecipe;
        }

        return false;
    }

    private async Task<UserRecipe> AddChildRecipeCore(EcoCraftDbContext context, UserRecipe userRecipe, Element element, decimal quantityGoal, Recipe recipe)
    {
        var matchingProduct = GetPreferredProductMatch(recipe, element);
        var quantityToCraft = Math.Ceiling(quantityGoal / matchingProduct.Quantity.GetDynamicValue(_selectedShoppingList));

        return await ShoppingListDataService.AddUserRecipe(context, _selectedShoppingList!, recipe, userRecipe, (int)quantityToCraft, _referenceDataContext);
    }

    private async Task ApplyAutoExpandForMissingIngredients(EcoCraftDbContext context, IEnumerable<UserRecipe> parentRecipes)
    {
        if (_selectedShoppingList is null || _serverData is null || !_isAutoExpandEnabled)
        {
            return;
        }

        var processedParentIds = new HashSet<Guid>();
        var queuedParentIds = new HashSet<Guid>();
        var queue = new Queue<UserRecipe>();

        foreach (var parentRecipe in parentRecipes)
        {
            if (queuedParentIds.Add(parentRecipe.Id))
            {
                queue.Enqueue(parentRecipe);
            }
        }

        while (queue.Count > 0)
        {
            var parentRecipe = queue.Dequeue();
            if (!processedParentIds.Add(parentRecipe.Id))
            {
                continue;
            }

            foreach (var ingredient in parentRecipe.Recipe.Elements.Where(e => e.IsIngredient()))
            {
                var requiredQuantity = GetIngredientQuantityGoal(parentRecipe, ingredient, _selectedShoppingList);
                var producedQuantity = GetProducedQuantityForIngredient(parentRecipe, ingredient, _selectedShoppingList);
                if (producedQuantity >= requiredQuantity || IsIngredientAlreadyInBranch(parentRecipe, ingredient))
                {
                    continue;
                }

                var possibleRecipes = GetPossibleRecipesForIngredient(ingredient);
                var chosenRecipe = GetSingleExistingRecipeChoiceForIngredient(ingredient, possibleRecipes);
                if (chosenRecipe is null)
                {
                    continue;
                }

                var missingQuantity = requiredQuantity - producedQuantity;
                if (missingQuantity <= 0)
                {
                    continue;
                }

                var createdRecipe = await AddChildRecipeCore(context, parentRecipe, ingredient, missingQuantity, chosenRecipe);
                if (queuedParentIds.Add(createdRecipe.Id))
                {
                    queue.Enqueue(createdRecipe);
                }
            }
        }
    }

    // « L'acheter » dans le menu de choix : l'ingrédient redevient une feuille, donc à acheter. Pendant une pause du
    // mode guidé, c'est un refus de choisir : on arrête la course (les recettes déjà ajoutées restent).
    private async Task SelectBuyForIngredient(UserRecipe parentRecipe, Element ingredient)
    {
        if (IsGuidedRunPausedForIngredient(parentRecipe, ingredient))
        {
            StopGuidedAutoExpandRun();
            return;
        }

        if (GetMatchingChildrenForIngredient(parentRecipe, ingredient).Count == 0)
        {
            CloseMenu();
            return;
        }

        await RemoveIngredientChildren(parentRecipe, ingredient);
    }

    // Une recette choisie dans le menu remplace celle(s) de l'ingrédient ; propagation et mode guidé suivent les options.
    private async Task SelectRecipeForIngredient(UserRecipe parentRecipe, Element ingredient, Recipe recipe)
    {
        if (_selectedShoppingList is null)
        {
            return;
        }

        if (!IsGuidedRunPausedForIngredient(parentRecipe, ingredient))
        {
            var existingChildren = GetMatchingChildrenForIngredient(parentRecipe, ingredient);
            if (existingChildren.Count == 1 && existingChildren[0].RecipeId == recipe.Id)
            {
                CloseMenu();
                return;
            }

            if (existingChildren.Count > 0)
            {
                await EcoCraftDbContext.ContextSaveAsync(EcoCraftDbFactory, context =>
                {
                    foreach (var childRecipe in existingChildren)
                    {
                        ShoppingListDataService.RemoveUserRecipe(context, _selectedShoppingList, childRecipe);
                    }

                    return Task.CompletedTask;
                });
            }
        }

        await AddChildRecipeFromManualSelection(parentRecipe, ingredient, recipe);
    }

    private async Task RemoveIngredientChildren(UserRecipe parentRecipe, Element ingredient)
    {
        if (_selectedShoppingList is null)
        {
            return;
        }

        if (_isGuidedRunActive)
        {
            ResetGuidedRunState();
        }

        var childrenToRemove = GetMatchingChildrenForIngredient(parentRecipe, ingredient);

        if (childrenToRemove.Count == 0)
        {
            return;
        }

        await EcoCraftDbContext.ContextSaveAsync(EcoCraftDbFactory, context =>
        {
            foreach (var childRecipe in childrenToRemove)
            {
                ShoppingListDataService.RemoveUserRecipe(context, _selectedShoppingList!, childRecipe);
            }

            return Task.CompletedTask;
        });

        CloseMenu();
        Rebuild();
    }

    private static List<UserRecipe> GetMatchingChildrenForIngredient(UserRecipe parentRecipe, Element ingredient)
    {
        return parentRecipe.ChildrenUserRecipes
            .Where(childRecipe => childRecipe.Recipe.Elements.Any(product =>
                product.IsProduct() &&
                ShoppingListCoverageCalculator.CanSupplyIngredient(product.ItemOrTag, ingredient.ItemOrTag)))
            .ToList();
    }

    private List<(Guid ParentRecipeId, Guid IngredientId)> GetMatchingIngredientTargetsForPropagation(Element sourceIngredient)
    {
        if (_selectedShoppingList is null)
        {
            return [];
        }

        var sourceIngredientIds = sourceIngredient.ItemOrTag.GetAssociatedTagsAndSelf()
            .Select(iot => iot.Id)
            .ToHashSet();

        return _selectedShoppingList.UserRecipes
            .SelectMany(parentRecipe => parentRecipe.Recipe.Elements
                .Where(candidateIngredient =>
                    candidateIngredient.IsIngredient() &&
                    candidateIngredient.ItemOrTag.GetAssociatedTagsAndSelf().Any(iot => sourceIngredientIds.Contains(iot.Id)))
                .OrderBy(candidateIngredient => candidateIngredient.Index)
                .Select(candidateIngredient => (parentRecipe.Id, candidateIngredient.Id)))
            .ToList();
    }

    private async Task<List<UserRecipe>> PropagateRecipeChoiceAcrossTreeCore(Element sourceIngredient, Recipe chosenRecipe, bool runAutoExpandAfterApply)
    {
        if (_selectedShoppingList is null)
        {
            return [];
        }

        var createdRecipes = new List<UserRecipe>();
        await EcoCraftDbContext.ContextSaveAsync(EcoCraftDbFactory, async context =>
        {
            var targets = GetMatchingIngredientTargetsForPropagation(sourceIngredient);

            foreach (var (parentRecipeId, ingredientId) in targets)
            {
                var parentRecipe = _selectedShoppingList.UserRecipes.FirstOrDefault(ur => ur.Id == parentRecipeId);
                if (parentRecipe is null)
                {
                    continue;
                }

                var ingredient = parentRecipe.Recipe.Elements.FirstOrDefault(e => e.Id == ingredientId);
                if (ingredient is null || !ingredient.IsIngredient())
                {
                    continue;
                }

                var canChosenRecipeCraftIngredient = chosenRecipe.Elements.Any(product =>
                    product.IsProduct() &&
                    !product.DefaultIsReintegrated &&
                    ShoppingListCoverageCalculator.CanSupplyIngredient(product.ItemOrTag, ingredient.ItemOrTag));

                if (!canChosenRecipeCraftIngredient)
                {
                    continue;
                }

                var existingChildren = GetMatchingChildrenForIngredient(parentRecipe, ingredient);
                var alreadyAppliedSingleChoice = existingChildren.Count == 1 && existingChildren[0].RecipeId == chosenRecipe.Id;
                if (!alreadyAppliedSingleChoice)
                {
                    foreach (var childRecipe in existingChildren)
                    {
                        ShoppingListDataService.RemoveUserRecipe(context, _selectedShoppingList, childRecipe);
                    }

                    var quantityGoal = GetIngredientQuantityGoal(parentRecipe, ingredient, _selectedShoppingList);
                    var createdRecipe = await AddChildRecipeCore(context, parentRecipe, ingredient, quantityGoal, chosenRecipe);
                    createdRecipes.Add(createdRecipe);
                }
            }

            if (runAutoExpandAfterApply && createdRecipes.Count > 0)
            {
                await ApplyAutoExpandForMissingIngredients(context, createdRecipes);
            }
        });

        return createdRecipes;
    }

    private async Task PropagateManualRecipeChoiceAcrossTree(Element sourceIngredient, Recipe chosenRecipe)
    {
        await PropagateRecipeChoiceAcrossTreeCore(sourceIngredient, chosenRecipe, runAutoExpandAfterApply: true);

        CloseMenu();
        Rebuild();
    }

    private async Task AddChildRecipeFromManualSelection(UserRecipe userRecipe, Element ingredient, Recipe recipe)
    {
        if (_selectedShoppingList is null)
        {
            return;
        }

        if (_isGuidedRunActive && IsGuidedRunPausedForIngredient(userRecipe, ingredient))
        {
            _guidedPendingParentRecipeId = null;
            _guidedPendingIngredientId = null;
            CloseMenu();

            var createdRecipes = await ApplyRecipeChoiceToIngredient(userRecipe, ingredient, recipe, runAutoExpandAfterApply: false);
            foreach (var createdRecipe in createdRecipes)
            {
                EnqueueGuidedParent(createdRecipe);
            }

            await ContinueGuidedRunAsync();
            return;
        }

        if (_isGuidedRunActive)
        {
            ResetGuidedRunState();
        }

        // « Aller jusqu'aux ressources brutes » : le choix lance une course guidée qui ouvre toute la chaîne
        // en dessous, et s'arrête sur le prochain ingrédient à plusieurs recettes.
        if (_isGuidedAutoExpandEnabled)
        {
            CloseMenu();
            _isGuidedRunActive = true;
            var createdRecipes = await ApplyRecipeChoiceToIngredient(userRecipe, ingredient, recipe, runAutoExpandAfterApply: false);
            foreach (var createdRecipe in createdRecipes)
            {
                EnqueueGuidedParent(createdRecipe);
            }

            await ContinueGuidedRunAsync();
            return;
        }

        if (_isRecipeChoicePropagationEnabled)
        {
            await PropagateManualRecipeChoiceAcrossTree(ingredient, recipe);
            return;
        }

        var quantityGoal = GetIngredientQuantityGoal(userRecipe, ingredient, _selectedShoppingList);
        await AddChildRecipe(userRecipe, ingredient, quantityGoal, recipe);
    }

    private async Task AddChildRecipe(UserRecipe userRecipe, Element element, decimal quantityGoal, Recipe recipe)
    {
        await AddChildRecipeCoreAndOptionallyAutoExpand(userRecipe, element, quantityGoal, recipe, runAutoExpandAfterAdd: true);

        CloseMenu();
        Rebuild();
    }

    private async Task<UserRecipe> AddChildRecipeCoreAndOptionallyAutoExpand(UserRecipe userRecipe, Element element, decimal quantityGoal, Recipe recipe, bool runAutoExpandAfterAdd)
    {
        UserRecipe? createdRecipe = null;
        await EcoCraftDbContext.ContextSaveAsync(EcoCraftDbFactory, async context =>
        {
            createdRecipe = await AddChildRecipeCore(context, userRecipe, element, quantityGoal, recipe);
            if (runAutoExpandAfterAdd && createdRecipe is not null)
            {
                await ApplyAutoExpandForMissingIngredients(context, new[] { createdRecipe });
            }
        });

        return createdRecipe!;
    }

    // Rattache chaque sous-recette au premier ingrédient (par Index) qu'elle peut fournir ; celles qui n'en fournissent
    // aucun sont rangées sous Guid.Empty et affichées à part sous la recette.
    private static Dictionary<Guid, List<UserRecipe>> GetChildrenByIngredient(UserRecipe parentRecipe)
    {
        var ingredients = parentRecipe.Recipe.Elements.Where(e => e.IsIngredient()).OrderBy(e => e.Index).ToList();

        return parentRecipe.ChildrenUserRecipes
            .OrderBy(childRecipe => childRecipe.Recipe.Name)
            .GroupBy(childRecipe => ingredients.FirstOrDefault(ingredient => childRecipe.Recipe.Elements.Any(product =>
                product.IsProduct() &&
                !product.DefaultIsReintegrated &&
                ShoppingListCoverageCalculator.CanSupplyIngredient(product.ItemOrTag, ingredient.ItemOrTag)))?.Id ?? Guid.Empty)
            .ToDictionary(g => g.Key, g => g.ToList());
    }

    private static IEnumerable<Element> GetOrderedProductsForDisplay(UserRecipe userRecipe)
    {
        return userRecipe.Recipe.Elements
            .Where(e => e.IsProduct())
            .OrderBy(e => e.ItemOrTag.IsTag ? 1 : 0)
            .ThenBy(e => e.Index);
    }

    private static Element GetPreferredProductMatch(Recipe recipe, Element ingredient)
    {
        return recipe.Elements
            .Where(e =>
                e.IsProduct() &&
                !e.DefaultIsReintegrated &&
                ShoppingListCoverageCalculator.CanSupplyIngredient(e.ItemOrTag, ingredient.ItemOrTag))
            .OrderBy(e => e.ItemOrTag.IsTag ? 1 : 0)
            .ThenBy(e => e.Index)
            .First();
    }

    private bool IsAddChildrenOpen(UserRecipe parentRecipe, Element ingredient)
    {
        if (_openedParentRecipeId == parentRecipe.Id && _openedIngredientId == ingredient.Id)
        {
            return true;
        }

        return IsGuidedRunPausedForIngredient(parentRecipe, ingredient);
    }

    private bool IsGuidedRunPausedForIngredient(UserRecipe userRecipe, Element ingredient)
    {
        return IsGuidedRunPaused
               && _guidedPendingParentRecipeId == userRecipe.Id
               && _guidedPendingIngredientId == ingredient.Id;
    }

    private void ToggleAddChildren(UserRecipe parentRecipe, Element ingredient)
    {
        if (IsGuidedRunPausedForIngredient(parentRecipe, ingredient))
        {
            return;
        }

        if (_openedParentRecipeId == parentRecipe.Id && _openedIngredientId == ingredient.Id)
        {
            CloseMenu();
        }
        else
        {
            _openedParentRecipeId = parentRecipe.Id;
            _openedIngredientId = ingredient.Id;
        }
    }

    private void CloseMenu()
    {
        _openedParentRecipeId = null;
        _openedIngredientId = null;
    }

    private void CloseMenu(UserRecipe parentRecipe, Element ingredient)
    {
        if (IsGuidedRunPausedForIngredient(parentRecipe, ingredient))
        {
            StopGuidedAutoExpandRun();
            return;
        }

        CloseMenu();
    }

    private void StopGuidedAutoExpandRun()
    {
        if (!_isGuidedRunActive)
        {
            return;
        }

        ResetGuidedRunState();
        Rebuild();
    }

    private void ResetGuidedRunState()
    {
        _isGuidedRunActive = false;
        _guidedPendingParentRecipeId = null;
        _guidedPendingIngredientId = null;
        _shouldScrollToGuidedPendingChoice = false;
        _guidedPendingChoiceAnchorRef = default;
        _guidedRunQueue.Clear();
        _guidedRunQueuedIds.Clear();
        CloseMenu();
    }

    private static string RecipeRowKey(UserRecipe userRecipe) => $"r{userRecipe.Id}";

    private static string IngredientRowKey(UserRecipe parentRecipe, Element ingredient) => $"{parentRecipe.Id}:{ingredient.Id}";

    private void ToggleRow(string key)
    {
        if (!_collapsedRows.Remove(key))
        {
            _collapsedRows.Add(key);
        }
    }

    // Tout replier (chaque recette et chaque ingrédient) ou, si quelque chose est déjà replié, tout déplier.
    private void ToggleAllRows()
    {
        if (_collapsedRows.Count > 0 || _selectedShoppingList is null)
        {
            _collapsedRows.Clear();
            return;
        }

        foreach (var userRecipe in _selectedShoppingList.UserRecipes)
        {
            _collapsedRows.Add(RecipeRowKey(userRecipe));
            foreach (var ingredient in userRecipe.Recipe.Elements.Where(e => e.IsIngredient()))
            {
                _collapsedRows.Add(IngredientRowKey(userRecipe, ingredient));
            }
        }
    }

    private static string Indent(int depth) => $"padding-left: {depth * 28}px;";

    private decimal GetTotalIngredientQuantity(ItemOrTag itemOrTag)
    {
        return _selectedShoppingList!.UserRecipes
            .SelectMany(ur => ur.Recipe.Elements
                .Where(e => e.IsIngredient() && e.ItemOrTag.Id == itemOrTag.Id)
                .Select(e => GetIngredientQuantityGoal(ur, e, _selectedShoppingList)))
            .Sum();
    }

    private ItemOrTag? GetChosenItem(ItemOrTag tag)
    {
        return _selectedShoppingList?.UserShoppingListItems.FirstOrDefault(usli => usli.ItemOrTagId == tag.Id)?.ChosenItem;
    }

    // Candidats d'un tag : le tag lui-même (« n'importe quel objet », choix par défaut) puis ses objets.
    private List<ItemOrTag> GetTagCandidates(ItemOrTag tag)
    {
        return tag.AssociatedItems
            .OrderBy(item => LocalizationService.GetTranslation(item))
            .Prepend(tag)
            .ToList();
    }

    private Task ChooseTagItem(ItemOrTag tag, ItemOrTag? item)
    {
        return UpdateShoppingListItem(tag, usli =>
        {
            usli.ChosenItem = item;
            usli.ChosenItemId = item?.Id;
        });
    }

    private Task SetStock(ItemOrTag itemOrTag, decimal stock)
    {
        return UpdateShoppingListItem(itemOrTag, usli => usli.Stock = Math.Max(0, stock));
    }

    // Une ligne n'existe en base que tant qu'elle porte un stock ou un choix de tag.
    private async Task UpdateShoppingListItem(ItemOrTag itemOrTag, Action<UserShoppingListItem> change)
    {
        if (_selectedShoppingList is null)
        {
            return;
        }

        var shoppingListItem = _selectedShoppingList.UserShoppingListItems.FirstOrDefault(usli => usli.ItemOrTagId == itemOrTag.Id);
        var isNew = shoppingListItem is null;
        shoppingListItem ??= new UserShoppingListItem
        {
            DataContext = _selectedShoppingList,
            DataContextId = _selectedShoppingList.Id,
            ItemOrTag = itemOrTag,
            ItemOrTagId = itemOrTag.Id,
        };
        change(shoppingListItem);

        if (isNew && shoppingListItem.IsEmpty())
        {
            Rebuild();
            return;
        }

        await EcoCraftDbContext.ContextSaveAsync(EcoCraftDbFactory, context =>
        {
            if (isNew)
            {
                UserShoppingListItemDbService.Create(context, shoppingListItem);
            }
            else if (shoppingListItem.IsEmpty())
            {
                UserShoppingListItemDbService.Destroy(context, shoppingListItem);
            }
            else
            {
                UserShoppingListItemDbService.Update(context, shoppingListItem);
            }

            return Task.CompletedTask;
        });

        if (isNew)
        {
            _selectedShoppingList.UserShoppingListItems.Add(shoppingListItem);
        }
        else if (shoppingListItem.IsEmpty())
        {
            _selectedShoppingList.UserShoppingListItems.Remove(shoppingListItem);
        }

        Rebuild();
    }

    private static PluginModule? GetFirstSlotModule(UserCraftingTable userCraftingTable)
    {
        return userCraftingTable.CraftingTable.GetOrderedModuleSlots()
            .Select(moduleSlot => userCraftingTable.GetInstalledPluginModules(moduleSlot).FirstOrDefault())
            .FirstOrDefault();
    }

    private string GetAutoOpenSummary()
    {
        var parts = new List<string>();
        if (_isAutoExpandEnabled) parts.Add(LocalizationService.GetTranslation("ShoppingList.ReuseChoicesShort"));
        if (_isRecipeChoicePropagationEnabled) parts.Add(LocalizationService.GetTranslation("ShoppingList.PropagateShort"));
        if (_isGuidedAutoExpandEnabled) parts.Add(LocalizationService.GetTranslation("ShoppingList.GuidedShort"));

        return parts.Count > 0 ? string.Join(" · ", parts) : LocalizationService.GetTranslation("ShoppingList.AutoOpenSummaryNone");
    }

    private RenderFragment AutoOpenOption(string key, bool value, Func<bool, Task> onChanged) => __builder =>
    {
        <div class="sl-auto-open-option">
            <MudSwitch T="bool" Value="value" ValueChanged="@((bool v) => onChanged(v))" Color="Color.Primary"/>
            <div class="sl-auto-open-text">
                <span class="sl-auto-open-option-title">@LocalizationService.GetTranslation($"ShoppingList.{key}Title")</span>
                <span class="sl-auto-open-option-desc">@LocalizationService.GetTranslation($"ShoppingList.{key}Desc")</span>
                <span class="sl-auto-open-option-example">@LocalizationService.GetTranslation($"ShoppingList.{key}Example")</span>
            </div>
        </div>
    };

    // Ligne d'une recette : racine (quantité à produire modifiable, ✕) ou sous-recette affichée à part (plusieurs
    // recettes pour un même ingrédient). Dépliée, elle montre ses ingrédients.
    private RenderFragment RecipeRow(UserRecipe userRecipe, int depth) => __builder =>
    {
        var orderedProducts = GetOrderedProductsForDisplay(userRecipe).ToList();
        var primaryProduct = orderedProducts.First();
        var perCraft = primaryProduct.Quantity.GetDynamicValue(_selectedShoppingList!);
        var producedQuantity = perCraft * userRecipe.RoundFactor;
        var key = RecipeRowKey(userRecipe);
        var isExpanded = !_collapsedRows.Contains(key);
        var isRoot = depth == 0;

        <div class="@($"sl-tree-row{(isRoot ? " sl-root" : "")}")">
            <div class="sl-item" style="@Indent(depth)">
                <MudIconButton Icon="@(isExpanded ? MDIIcons.Filled.ChevronDown : MDIIcons.Filled.ChevronRight)" Size="Size.Small" Class="sl-chevron" OnClick="@(() => ToggleRow(key))"/>
                <EcoIcon Item="@primaryProduct.ItemOrTag" Size="32"/>
                <span class="sl-item-text">
                    <span class="sl-item-name">@LocalizationService.GetTranslation(primaryProduct.ItemOrTag)</span>
                    @if (orderedProducts.Count > 1)
                    {
                        <span class="sl-item-products">
                            @foreach (var product in orderedProducts.Skip(1))
                            {
                                <MudTooltip Text="@LocalizationService.GetTranslation(product.ItemOrTag)">
                                    <span class="sl-item-product">+@FormatQuantity(product.Quantity.GetDynamicValue(_selectedShoppingList!) * userRecipe.RoundFactor) <EcoIcon Item="@product.ItemOrTag" Size="16"/></span>
                                </MudTooltip>
                            }
                        </span>
                    }
                </span>
            </div>
            @if (isRoot)
            {
                <MudTooltip Text="@LocalizationService.GetTranslation("ShoppingList.QuantityToProduceTooltip")">
                    <MudNumericField T="int"
                                     Value="@((int)Math.Round(producedQuantity, MidpointRounding.AwayFromZero))"
                                     ValueChanged="@(v => OnQuantityToProduceChanged(userRecipe, primaryProduct, v))"
                                     Format="0"
                                     Step="@(perCraft >= 1 ? (int)Math.Round(perCraft) : 1)"
                                     Culture="CultureInfo.InvariantCulture"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     Class="sl-quantity-input"
                                     Min="1"/>
                </MudTooltip>
            }
            else
            {
                <span class="sl-right">@FormatQuantity(producedQuantity)</span>
            }
            <div class="sl-chip sl-chip-static">
                <EcoIcon Item="@userRecipe.Recipe.CraftingTable" Size="22" Class="sl-chip-icon"/>
                <span class="sl-chip-label">@LocalizationService.GetTranslation(userRecipe.Recipe)</span>
            </div>
            <MudIconButton Icon="@MDIIcons.Filled.Close" Size="Size.Small" OnClick="() => RemoveShoppingListRecipe(userRecipe)"/>
        </div>
        @if (isExpanded)
        {
            @RecipeChildren(userRecipe, depth + 1)
        }
    };

    private RenderFragment RecipeChildren(UserRecipe userRecipe, int depth) => __builder =>
    {
        var childrenByIngredient = GetChildrenByIngredient(userRecipe);
        var coverage = ShoppingListCoverageCalculator.ComputeCoverage(userRecipe, _selectedShoppingList!, userRecipe.ChildrenUserRecipes);
        var ingredients = userRecipe.Recipe.Elements.Where(e => e.IsIngredient()).OrderBy(e => e.Index).ToList();
        var orphanRecipes = childrenByIngredient.GetValueOrDefault(Guid.Empty) ?? new List<UserRecipe>();

        @foreach (var ingredient in ingredients)
        {
            var ingredientChildren = childrenByIngredient.GetValueOrDefault(ingredient.Id) ?? new List<UserRecipe>();
            @IngredientRow(userRecipe, ingredient, ingredientChildren, coverage.IsFulfilled(ingredient), depth)
        }
        @foreach (var orphanRecipe in orphanRecipes)
        {
            @RecipeRow(orphanRecipe, depth)
        }
    };

    // Ligne d'un ingrédient : la puce « Obtenu via » ouvre le menu de choix ; s'il est fabriqué, la ligne se déplie
    // sur les ingrédients de sa sous-recette (ou sur chaque sous-recette s'il y en a plusieurs).
    private RenderFragment IngredientRow(UserRecipe parentRecipe, Element ingredient, List<UserRecipe> children, bool isFulfilled, int depth) => __builder =>
    {
        var key = IngredientRowKey(parentRecipe, ingredient);
        var hasChildren = children.Count > 0;
        var isExpanded = hasChildren && !_collapsedRows.Contains(key);
        var quantity = GetIngredientQuantityGoal(parentRecipe, ingredient, _selectedShoppingList!);
        var possibleRecipes = GetPossibleRecipesForIngredient(ingredient);
        var isMenuOpen = IsAddChildrenOpen(parentRecipe, ingredient);

        <div class="@($"sl-tree-row{(isMenuOpen ? " sl-menu-open" : "")}")">
            <div class="sl-item" style="@Indent(depth)">
                @if (hasChildren)
                {
                    <MudIconButton Icon="@(isExpanded ? MDIIcons.Filled.ChevronDown : MDIIcons.Filled.ChevronRight)" Size="Size.Small" Class="sl-chevron" OnClick="@(() => ToggleRow(key))"/>
                }
                else
                {
                    <span class="sl-chevron-placeholder"></span>
                }
                <EcoIcon Item="@ingredient.ItemOrTag" Size="32"/>
                <span class="sl-item-text">
                    <span class="sl-item-name">@LocalizationService.GetTranslation(ingredient.ItemOrTag)</span>
                    @if (hasChildren && !isFulfilled)
                    {
                        <span class="sl-caption sl-warning">@LocalizationService.GetTranslation("ShoppingList.PartiallyCovered", FormatQuantity(GetProducedQuantityForIngredient(parentRecipe, ingredient, _selectedShoppingList!)), FormatQuantity(quantity))</span>
                    }
                    else if (!hasChildren && possibleRecipes.Count >= 2)
                    {
                        <span class="sl-caption">@LocalizationService.GetTranslation("ShoppingList.RecipesPossible", possibleRecipes.Count.ToString())</span>
                    }
                </span>
            </div>
            <span class="sl-right">@FormatQuantity(quantity)</span>
            @IngredientChip(parentRecipe, ingredient, children, possibleRecipes)
            <span></span>
        </div>
        @if (isMenuOpen)
        {
            @RecipeMenu(parentRecipe, ingredient, children, possibleRecipes, depth + 1)
        }
        @if (isExpanded && children.Count == 1)
        {
            @RecipeChildren(children[0], depth + 1)
        }
        @if (isExpanded && children.Count > 1)
        {
            @foreach (var childRecipe in children)
            {
                @RecipeRow(childRecipe, depth + 1)
            }
        }
    };

    // Puce « Obtenu via » : fabriqué (table + recette), tag (★ objet choisi), en stock, ou à acheter.
    private RenderFragment IngredientChip(UserRecipe parentRecipe, Element ingredient, List<UserRecipe> children, List<Recipe> possibleRecipes) => __builder =>
    {
        var canChoose = possibleRecipes.Count > 0 || children.Count > 0;
        var isTag = children.Count == 0 && ingredient.ItemOrTag.IsTag;
        var chosenItem = isTag ? GetChosenItem(ingredient.ItemOrTag) : null;
        var isInStock = children.Count == 0 && !isTag && _view.BuyRowsById.GetValueOrDefault(ingredient.ItemOrTag.Id)?.IsInStock == true;
        var chipClass = children.Count > 0 ? "sl-chip" : isTag ? "sl-chip sl-chip-tag" : isInStock ? "sl-chip sl-chip-stock" : "sl-chip sl-chip-buy";

        <button type="button" class="@chipClass" disabled="@(!canChoose)" @onclick="@(() => ToggleAddChildren(parentRecipe, ingredient))">
            @if (children.Count > 0)
            {
                <EcoIcon Item="@children[0].Recipe.CraftingTable" Size="22" Class="sl-chip-icon"/>
                <span class="sl-chip-label">@LocalizationService.GetTranslation(children[0].Recipe)@(children.Count > 1 ? $" +{children.Count - 1}" : "")</span>
            }
            else if (isTag)
            {
                <EcoIcon Item="@(chosenItem ?? ingredient.ItemOrTag)" Size="22" Class="sl-chip-icon"/>
                <MudIcon Icon="@MDIIcons.Filled.Star" Size="Size.Small"/>
                <span class="sl-chip-label">@(chosenItem is null ? LocalizationService.GetTranslation("ShoppingList.AnyOfTag") : LocalizationService.GetTranslation(chosenItem))</span>
                <span class="sl-chip-sub">@LocalizationService.GetTranslation("ShoppingList.TagCaption", LocalizationService.GetTranslation(ingredient.ItemOrTag))</span>
            }
            else if (isInStock)
            {
                <MudIcon Icon="@MDIIcons.Filled.CheckCircle" Size="Size.Small"/>
                <span class="sl-chip-label">@LocalizationService.GetTranslation("ShoppingList.InStock")</span>
            }
            else
            {
                <MudIcon Icon="@MDIIcons.Outline.Cart" Size="Size.Small"/>
                <span class="sl-chip-label">@LocalizationService.GetTranslation("ShoppingList.Buy")</span>
            }
            @if (canChoose)
            {
                <MudIcon Icon="@MDIIcons.Filled.ChevronDown" Size="Size.Small" Class="sl-chip-end"/>
            }
        </button>
    };

    // Menu de choix inséré sous l'ingrédient : « L'acheter » d'abord, puis une carte par recette possible
    // (icône de la table, nom de la recette, ingrédients → produit par craft).
    private RenderFragment RecipeMenu(UserRecipe parentRecipe, Element ingredient, List<UserRecipe> children, List<Recipe> possibleRecipes, int depth) => __builder =>
    {
        var isPending = IsGuidedRunPausedForIngredient(parentRecipe, ingredient);

        <div class="@($"sl-menu{(isPending ? " sl-menu-pending" : "")}")" style="@($"margin-left: {depth * 28}px;")">
            <div class="sl-menu-head">
                <EcoIcon Item="@ingredient.ItemOrTag" Size="28"/>
                <span class="sl-menu-title">@LocalizationService.GetTranslation("ShoppingList.HowToObtain", LocalizationService.GetTranslation(ingredient.ItemOrTag))</span>
                <span class="sl-caption">@LocalizationService.GetTranslation("ShoppingList.HowToObtainSub", possibleRecipes.Count.ToString(), FormatQuantity(GetTotalIngredientQuantity(ingredient.ItemOrTag)))</span>
                <span class="flex-grow-1"></span>
                @if (isPending)
                {
                    <span class="guided-choice-scroll-anchor" @ref="_guidedPendingChoiceAnchorRef"></span>
                    <MudTooltip Text="@LocalizationService.GetTranslation("ShoppingList.StopGuidedAutoExpandTooltip")">
                        <MudButton Variant="Variant.Text" Color="Color.Warning" Size="Size.Small" StartIcon="@MDIIcons.Filled.StopCircle" OnClick="StopGuidedAutoExpandRun">
                            @LocalizationService.GetTranslation("ShoppingList.StopGuidedAutoExpandLabel")
                        </MudButton>
                    </MudTooltip>
                }
                <MudIconButton Icon="@MDIIcons.Filled.Close" Size="Size.Small" OnClick="@(() => CloseMenu(parentRecipe, ingredient))"/>
            </div>
            <div class="sl-menu-cards">
                <div class="@($"sl-card{(children.Count == 0 ? " sl-chosen" : "")}")" @onclick="@(() => SelectBuyForIngredient(parentRecipe, ingredient))">
                    <div class="sl-card-title">
                        <EcoIcon Item="@ingredient.ItemOrTag" Size="32"/>
                        <span>@LocalizationService.GetTranslation("ShoppingList.BuyIt")</span>
                    </div>
                </div>
                @foreach (var recipe in possibleRecipes)
                {
                    var product = GetPreferredProductMatch(recipe, ingredient);
                    <div class="@($"sl-card{(children.Any(c => c.RecipeId == recipe.Id) ? " sl-chosen" : "")}")" @onclick="@(() => SelectRecipeForIngredient(parentRecipe, ingredient, recipe))">
                        <div class="sl-card-title">
                            <EcoIcon Item="@recipe.CraftingTable" Size="32"/>
                            <span>@LocalizationService.GetTranslation(recipe)</span>
                        </div>
                        <div class="sl-card-io">
                            @foreach (var recipeIngredient in recipe.Elements.Where(e => e.IsIngredient()).OrderBy(e => e.Index))
                            {
                                <span class="sl-card-element">@FormatQuantity(Math.Abs(recipeIngredient.Quantity.GetDynamicValue(_selectedShoppingList!)))<EcoIcon Item="@recipeIngredient.ItemOrTag" Size="20"/></span>
                            }
                            <MudIcon Icon="@MDIIcons.Filled.ArrowRight" Size="Size.Small"/>
                            <span class="sl-card-element">@FormatQuantity(product.Quantity.GetDynamicValue(_selectedShoppingList!))<EcoIcon Item="@product.ItemOrTag" Size="20"/></span>
                        </div>
                    </div>
                }
            </div>
        </div>
    };

