@using ecocraft.Models
@using ecocraft.Services
@inject LocalizationService LocalizationService

@* One icon per module slot of the table (one per installed module in the specialty slot). Clicking
   opens a dropdown of the modules the table accepts for that slot: a single choice, or checkboxes in
   the specialty slot, where a module reaching the same skill as a checked one is disabled. The
   tooltip shows the installed modules' bonuses; all installed modules apply together. *@
@{
    var orderedModuleSlots = UserCraftingTable.CraftingTable.GetOrderedModuleSlots()
        .Where(ms => UserCraftingTable.CraftingTable.GetPluginModulesForSlot(ms).Count > 0)
        .ToList();
}

@if (orderedModuleSlots.Count > 0)
{
    <MudStack Row AlignItems="AlignItems.Center" Spacing="1" Class="@Class">
        @foreach (var moduleSlot in orderedModuleSlots)
        {
            var installed = UserCraftingTable.GetInstalledPluginModules(moduleSlot);

            <MudMenu Dense="true" Disabled="Disabled" AnchorOrigin="Origin.BottomLeft" TransformOrigin="Origin.TopLeft">
                <ActivatorContent Context="menu">
                    <MudLink OnClick="@(args => menu.ToggleAsync(args))" Disabled="Disabled">
                        <MudTooltip Text="@GetSlotTooltip(moduleSlot, installed)">
                            <MudStack Row AlignItems="AlignItems.Center" Spacing="0">
                                @if (installed.Count == 0)
                                {
                                    <EcoIcon Item="null" FallbackIcon="@MDIIcons.Filled.Cancel" Size="24" Class="no-pluginmodule mt-1"/>
                                }
                                @foreach (var pluginModule in installed)
                                {
                                    <EcoIcon Item="@pluginModule" Size="24" Class="has-pluginmodule mt-1"/>
                                }
                            </MudStack>
                        </MudTooltip>
                    </MudLink>
                </ActivatorContent>
                <ChildContent>
                    @if (!moduleSlot.AllowsSeveralModules)
                    {
                        <MudMenuItem OnClick="@(() => Select(moduleSlot, []))">
                            <MudStack Row AlignItems="AlignItems.Center" Spacing="2">
                                <MudIcon Icon="@MDIIcons.Filled.Cancel" Size="Size.Small"/>
                                <MudText Typo="Typo.body2">@LocalizationService.GetTranslation("PriceCalculator.NoModule")</MudText>
                            </MudStack>
                        </MudMenuItem>
                    }
                    @foreach (var candidate in GetOrderedCandidates(moduleSlot))
                    {
                        var isInstalled = installed.Any(pm => pm.Id == candidate.Id);
                        var conflict = isInstalled ? null : installed.FirstOrDefault(pm => moduleSlot.AllowsSeveralModules && pm.ConflictsWith(candidate));

                        <MudMenuItem OnClick="@(() => OnCandidateClicked(moduleSlot, candidate))"
                                     AutoClose="@(!moduleSlot.AllowsSeveralModules)"
                                     Disabled="@(conflict is not null)">
                            <MudStack Row AlignItems="AlignItems.Center" Spacing="2" Style="min-width: 260px;">
                                @if (moduleSlot.AllowsSeveralModules)
                                {
                                    <MudIcon Icon="@(isInstalled ? Icons.Material.Filled.CheckBox : Icons.Material.Filled.CheckBoxOutlineBlank)" Size="Size.Small"/>
                                }
                                <EcoIcon Item="@candidate" Size="24"/>
                                <MudStack Spacing="0">
                                    <MudText Typo="Typo.body2" Color="@(isInstalled ? Color.Primary : Color.Default)">@candidate.GetTooltip(LocalizationService)</MudText>
                                    @if (conflict is not null)
                                    {
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                                            @LocalizationService.GetTranslation("PriceCalculator.ModuleSameSkill", LocalizationService.GetTranslation(conflict))
                                        </MudText>
                                    }
                                </MudStack>
                            </MudStack>
                        </MudMenuItem>
                    }
                </ChildContent>
            </MudMenu>
        }
    </MudStack>
}

@code {
    public record ModuleSelection(ModuleSlot ModuleSlot, List<PluginModule> PluginModules);

    [Parameter, EditorRequired] public UserCraftingTable UserCraftingTable { get; set; } = null!;
    [Parameter] public string? Class { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public EventCallback<ModuleSelection> ModuleSelected { get; set; }

    private List<PluginModule> GetOrderedCandidates(ModuleSlot moduleSlot)
    {
        return UserCraftingTable.CraftingTable.GetPluginModulesForSlot(moduleSlot)
            .OrderBy(pm => LocalizationService.GetTranslation(pm))
            .ToList();
    }

    private Task OnCandidateClicked(ModuleSlot moduleSlot, PluginModule candidate)
    {
        if (!moduleSlot.AllowsSeveralModules)
        {
            return Select(moduleSlot, [candidate]);
        }

        var installed = UserCraftingTable.GetInstalledPluginModules(moduleSlot);
        if (installed.RemoveAll(pm => pm.Id == candidate.Id) == 0)
        {
            installed.Add(candidate);
        }

        return Select(moduleSlot, installed);
    }

    private async Task Select(ModuleSlot moduleSlot, List<PluginModule> pluginModules)
    {
        if (Disabled) return;

        await ModuleSelected.InvokeAsync(new ModuleSelection(moduleSlot, pluginModules));
    }

    private string GetSlotTooltip(ModuleSlot moduleSlot, List<PluginModule> installed)
    {
        var slotName = LocalizationService.GetTranslation(moduleSlot);

        return installed.Count > 0
            ? $"{slotName}: {string.Join(" / ", installed.Select(pm => pm.GetTooltip(LocalizationService)))}"
            : $"{slotName}: {LocalizationService.GetTranslation("PriceCalculator.NoModule")}";
    }
}
