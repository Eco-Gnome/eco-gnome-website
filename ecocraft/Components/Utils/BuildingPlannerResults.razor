@using ecocraft.BuildingPlanner
@using ecocraft.BuildingPlanner.Model
@using ecocraft.Services
@inject LocalizationService LocalizationService
@inject ContextService ContextService

@* Un volet à la fois (Panel) : le rail et l'entête du volet sont dans BuildingPlannerPage. *@
@switch (Panel)
{
    case "housing":
        @if (Analysis?.Housing is { } housing)
        {
            <div class="bp-score">
                <span class="bp-score-value">@housing.Total.ToString("0.00")</span>
                <span class="bp-muted">@LocalizationService.GetTranslation("BuildingPlanner.Housing.PerDay")</span>
            </div>
            <div class="bp-muted bp-score-sub">
                @LocalizationService.GetTranslation("BuildingPlanner.Housing.BeforeOccupancy"): @housing.TotalBeforeOccupancy.ToString("0.00")
                × @housing.OccupancyMultiplier.ToString("0.###") (@housing.Residents @LocalizationService.GetTranslation("BuildingPlanner.Residents").ToLowerInvariant())
            </div>
            @if (Analysis.HousingRulesAreDefaults)
            {
                <MudAlert Severity="Severity.Info" Dense="true" Class="mt-2">@LocalizationService.GetTranslation("BuildingPlanner.Issue.HousingConfigMissing")</MudAlert>
            }
            @* Une ligne par pièce, regroupées par niveau puis par catégorie (catégories limitées en dernier, comme le jeu) : ce qu'elle apporte
               vraiment à la propriété (« valeur → apport » orange si le rang ou la limite de catégorie l'a réduite, « i » = la règle) ;
               la somme de la colonne Total retombe sur « avant multiplicateur ». *@
            <div class="bp-hrows">
                <div class="bp-hrow-head">
                    <span>@LocalizationService.GetTranslation("BuildingPlanner.Inspector.Room")</span>
                    <span>@LocalizationService.GetTranslation("BuildingPlanner.Housing.Total")</span>
                </div>
                @foreach (var levelGroup in housing.Rooms.Where(r => r.RoomId != PlanAnalyzer.OutdoorRoomId).GroupBy(r => Document?.FindRoom(r.RoomId)?.Level ?? 0).OrderBy(g => g.Key))
                {
                    <div class="bp-theme-title">@LevelLabel(levelGroup.Key)</div>
                    foreach (var row in levelGroup.OrderBy(r => CapPercent(r.Category) > 0f ? 1 : 0).ThenBy(r => r.Category).ThenBy(r => r.Rank))
                    {
                        @HousingRow(row, Document?.FindRoom(row.RoomId)?.Room.Name ?? row.RoomId, Analysis.Rooms.FirstOrDefault(r => r.RoomId == row.RoomId)?.Housing, false)
                    }
                }
                @* Pièce « Extérieur » du deed : objets hors de toute pièce, tous niveaux confondus — une seule, en bas, comme dans le jeu. *@
                @if (Analysis.OutdoorHousing is { } outdoor && housing.Rooms.FirstOrDefault(r => r.RoomId == PlanAnalyzer.OutdoorRoomId) is { } outdoorRow)
                {
                    <div class="bp-theme-title">@LocalizationService.GetTranslation("BuildingPlanner.Housing.Outdoor")</div>
                    @HousingRow(outdoorRow, LocalizationService.GetTranslation("BuildingPlanner.Housing.Outdoor"), outdoor, true, LocalizationService.GetTranslation("BuildingPlanner.Housing.OutdoorHelp"))
                }
            </div>
        }
        else
        {
            <div class="bp-muted">@LocalizationService.GetTranslation("BuildingPlanner.Results.Pending")</div>
        }
        break;

    case "issues":
        @if (Analysis is null)
        {
            <div class="bp-muted">@LocalizationService.GetTranslation("BuildingPlanner.Results.Pending")</div>
        }
        else
        {
            var visible = Analysis.Issues.Where(i => !HiddenIssueCodes.Contains(i.Code)).ToList();
            if (visible.Count == 0)
            {
                <span class="bp-chip ok"><MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small"/>@LocalizationService.GetTranslation("BuildingPlanner.Results.NoIssue")</span>
            }
            else
            {
                var shown = visible.Take(80).ToList();
                foreach (var theme in Themes)
                {
                    var group = shown.Where(i => ThemeOf(i.Code) == theme).ToList();
                    if (group.Count == 0) continue;
                    <div class="bp-theme-title">@LocalizationService.GetTranslation($"BuildingPlanner.Results.Theme.{theme}")</div>
                    foreach (var issue in group)
                    {
                        <div class="@IssueClass(issue)" @onclick="@(() => OnFocusIssue.InvokeAsync(issue))">
                            <MudIcon Icon="@IssueIcon(issue.Severity)" Size="Size.Small"/>
                            <span class="bp-issue-text">@LocalizationService.GetTranslation($"BuildingPlanner.Issue.{issue.Code}", issue.Args)</span>
                            <MudIcon Icon="@Icons.Material.Filled.CenterFocusStrong" Size="Size.Small" Class="bp-issue-focus"/>
                        </div>
                    }
                }
                @if (visible.Count > shown.Count)
                {
                    <div class="bp-muted">… +@(visible.Count - shown.Count)</div>
                }
            }
        }
        break;

    case "objects":
        @if (Analysis is null)
        {
            <div class="bp-muted">@LocalizationService.GetTranslation("BuildingPlanner.Results.Pending")</div>
        }
        else if (Analysis.ObjectCounts.Count == 0)
        {
            <div class="bp-muted">@LocalizationService.GetTranslation("BuildingPlanner.Objects.None")</div>
        }
        else
        {
            @* Liste d'achat : quantité par type d'objet posé, groupée par spécialité qui le fabrique (sans spécialité en dernier)
               pour faire ses courses boutique par boutique ; cliquer l'en-tête replie le groupe. *@
            foreach (var g in Analysis.ObjectCounts.GroupBy(l => ObjectOf(l.Type)?.Skill ?? "").OrderBy(g => g.Key == "" ? 1 : 0).ThenBy(g => SkillLabel(g.First().Type)))
            {
                var collapsed = _collapsedSkills.Contains(g.Key);
                <div class="bp-theme-title bp-skill-title" @onclick="@(() => ToggleSkill(g.Key))">
                    <MudIcon Icon="@(collapsed ? Icons.Material.Filled.ChevronRight : Icons.Material.Filled.ExpandMore)" Size="Size.Small"/>
                    <span class="bp-ellipsis">@SkillLabel(g.First().Type)</span>
                    <span class="bp-num">×@g.Sum(l => l.Count)</span>
                </div>
                if (collapsed) continue;
                foreach (var line in g.OrderBy(l => ObjectLabel(l.Type)))
                {
                    <div class="bp-orow">
                        <MudImage Src="@($"/assets/eco-icons/{line.Type}.png?serverId={ContextService.CurrentServer?.Id}")" FallbackSrc="/assets/eco-icons/EmptyIcon.png" Width="20" Height="20"/>
                        <span class="bp-ellipsis">@ObjectLabel(line.Type)</span>
                        <span class="bp-num bp-strong">×@line.Count</span>
                    </div>
                }
            }
        }
        break;

    case "materials":
        @if (Analysis is not null && Analysis.Materials.Count > 0)
        {
            <MudSimpleTable Dense="true" Hover="true" Class="bp-table">
                <thead>
                <tr>
                    <th>@LocalizationService.GetTranslation("BuildingPlanner.Material")</th>
                    <th style="text-align:right">@LocalizationService.GetTranslation("BuildingPlanner.Materials.Walls")</th>
                    <th style="text-align:right">@LocalizationService.GetTranslation("BuildingPlanner.Materials.Floors")</th>
                    <th style="text-align:right">@LocalizationService.GetTranslation("BuildingPlanner.Materials.Ceilings")</th>
                    <th style="text-align:right">@LocalizationService.GetTranslation("BuildingPlanner.Materials.Total")</th>
                </tr>
                </thead>
                <tbody>
                @foreach (var m in Analysis.Materials)
                {
                    <tr>
                        <td>@(Catalog?.Materials.FirstOrDefault(x => x.Name == m.Material)?.Label ?? m.Material)</td>
                        <td style="text-align:right">@m.Walls</td>
                        <td style="text-align:right">@m.Floors</td>
                        <td style="text-align:right">@m.Ceilings</td>
                        <td style="text-align:right"><b>@m.Total</b></td>
                    </tr>
                }
                </tbody>
            </MudSimpleTable>
        }
        else
        {
            <div class="bp-muted">@LocalizationService.GetTranslation("BuildingPlanner.Results.Pending")</div>
        }
        break;

    case "assumptions":
        <ul class="bp-assumptions">
            @foreach (var key in AssumptionKeys)
            {
                <li>@LocalizationService.GetTranslation($"BuildingPlanner.Assumptions.{key}")</li>
            }
        </ul>
        break;
}

@code {
    [Parameter] public string Panel { get; set; } = "housing";
    [Parameter] public PlanDocument? Document { get; set; }
    [Parameter] public AnalysisResult? Analysis { get; set; }
    [Parameter] public ClientCatalog? Catalog { get; set; }
    [Parameter] public string? SelectionKind { get; set; }
    [Parameter] public string? SelectionId { get; set; }
    [Parameter] public EventCallback<PlanIssue> OnFocusIssue { get; set; }
    [Parameter] public EventCallback<string?> OnFocusRoom { get; set; }   // null = désélection (re-clic sur l'œil de la pièce sélectionnée)

    private static readonly string[] AssumptionKeys =
    [
        "EmptyEdges", "Holes", "Levels", "Paint", "Pollution", "Culture", "Deed", "Efficiency", "Talents", "Modules", "Terrain", "Rotations", "Forms", "Tie",
    ];

    // Mécanique normale du jeu, déjà expliquée par les « i » du volet Housing : pas des avertissements.
    private static readonly HashSet<string> HiddenIssueCodes = ["HousingCapped", "HousingObjectExcluded"];

    // Regroupement des avertissements par thème ; tout code absent tombe dans « Données » (validation, placement, références).
    private static readonly string[] Themes = ["Rooms", "Housing", "Tables", "Data"];

    private static readonly Dictionary<string, string> IssueTheme = new(StringComparer.Ordinal)
    {
        ["RoomSeedInWall"] = "Rooms", ["RoomNotEnclosed2D"] = "Rooms", ["RoomsShareSpace"] = "Rooms", ["MissingFloor"] = "Rooms", ["RoomTallerThanLevel"] = "Rooms",
        ["MissingCeilingMaterial"] = "Rooms", ["CeilingConflict"] = "Rooms", ["DiagonalGap"] = "Rooms", ["NoRoomDefined"] = "Rooms", ["NoSupportBelow"] = "Rooms",
        ["RoomTooBig"] = "Rooms", ["NoCeiling"] = "Rooms", ["VolumeTooSmall"] = "Rooms", ["RoomInvalid"] = "Rooms", ["EmptyEdges"] = "Rooms",
        ["BuildingTooHigh"] = "Rooms", ["TooManyRooms"] = "Rooms", ["SeedOutOfGrid"] = "Rooms",
        ["HousingNegated"] = "Housing", ["HousingObjectExcluded"] = "Housing", ["PrimaryCategoryTie"] = "Housing", ["HousingCapped"] = "Housing",
        ["HousingConfigMissing"] = "Housing", ["DefaultOccupancy"] = "Housing", ["UnknownHousingCategory"] = "Housing", ["UnknownLockCategory"] = "Housing",
        ["TableNotInRoom"] = "Tables", ["TableNotContained"] = "Tables", ["TableTierTooLow"] = "Tables", ["TableModulesInactive"] = "Tables", ["TableVolumeExceeded"] = "Tables",
    };

    private static string ThemeOf(string code) => IssueTheme.GetValueOrDefault(code, "Data");

    private ClientObject? ObjectOf(string type) => Catalog?.Objects.FirstOrDefault(o => o.Name == type);
    private string SkillLabel(string type) => ObjectOf(type)?.SkillLabel ?? LocalizationService.GetTranslation("BuildingPlanner.Objects.NoSkill");

    // Groupes repliés du volet Mobilier (tous dépliés par défaut) ; "" = sans spécialité.
    private readonly HashSet<string> _collapsedSkills = [];

    private void ToggleSkill(string skill)
    {
        if (!_collapsedSkills.Remove(skill)) _collapsedSkills.Add(skill);
    }

    // Pièces dépliées dans le volet Housing (toutes repliées par défaut) ; état perdu à la fermeture du volet, volontairement.
    private readonly HashSet<string> _expandedRooms = [];

    private void ToggleRoom(string roomId)
    {
        if (!_expandedRooms.Remove(roomId)) _expandedRooms.Add(roomId);
    }

    // Une ligne de pièce : ce qu'elle apporte à la propriété (« valeur → apport » orange si le rang ou la limite de catégorie l'a réduite, « i » = la règle),
    // puis l'œil bleu (action) qui sélectionne la pièce sur le plan, plein quand elle est sélectionnée (re-clic = désélection) ; cliquer la ligne replie/déplie ses objets, présentés comme le panneau « Room Details »
    // du jeu : phrase de soft-cap des matériaux s'il s'applique, un objet par ligne avec sa valeur dans la pièce et « (x %) » orange + « i »
    // si le jeu l'a réduite (répétition, déjà présent sur la propriété), « Ignoré » si sa catégorie ne soutient pas la pièce, puis une ligne
    // Total « somme → valeur de la pièce » (« i » = plafonds de soutien, appliqués au total et non objet par objet).
    // Pour la pièce Extérieur les objets sont groupés par niveau (jardin, balcon…) et sa règle (pas de tier, 100 % du reste) tient dans un « i » orange.
    private RenderFragment HousingRow(RoomContribution row, string name, RoomHousingResult? roomHousing, bool groupByLevel, string? note = null) =>
        @<div class="@("bp-hrow" + (roomHousing is { Objects.Count: > 0 } ? " bp-hrow-foldable" : ""))" @onclick="@(() => { if (roomHousing is { Objects.Count: > 0 }) ToggleRoom(row.RoomId); })">
            @{
                var steps = roomHousing is null ? [] : HousingBreakdown.RoomSteps(roomHousing, Analysis!.Housing!, row.RoomId, CapPercent);
                var effective = row.RoomValue * HousingBreakdown.RoomFactor(steps);
                var reduced = effective < row.RoomValue - 0.005f;
                var hasObjects = roomHousing is { Objects.Count: > 0 };
                var expanded = hasObjects && _expandedRooms.Contains(row.RoomId);
                var selected = SelectionKind == "room" && SelectionId == row.RoomId;
            }
            <div class="bp-hrow-main">
                <span class="bp-hrow-toggle">
                    @if (hasObjects) { <MudIcon Icon="@(expanded ? Icons.Material.Filled.ExpandMore : Icons.Material.Filled.ChevronRight)" Size="Size.Small"/> }
                </span>
                <span class="bp-ellipsis"><span class="bp-strong">@name</span><span class="bp-muted"> · @CategoryLabel(row.Category)</span></span>
                <span class="bp-num">
                    @if (reduced) { <span>@row.RoomValue.ToString("0.00")</span><span class="bp-excluded"> → @effective.ToString("0.00")</span> }
                    else { <span class="bp-strong">@effective.ToString("0.00")</span> }
                    <BuildingPlannerHousingInfos Steps="@steps.Where(s => s.Kind is "rank" or "category")" Note="@note" Catalog="Catalog"/>
                </span>
                <span class="@("bp-hrow-eye" + (selected ? " selected" : ""))" title="@LocalizationService.GetTranslation("BuildingPlanner.Housing.ShowRoom")" @onclick="@(() => OnFocusRoom.InvokeAsync(selected ? null : row.RoomId))" @onclick:stopPropagation>
                    <MudIcon Icon="@(selected ? Icons.Material.Filled.Visibility : Icons.Material.Outlined.Visibility)" Size="Size.Small"/>
                </span>
            </div>
            @if (expanded)
            {
                var lines = groupByLevel ? roomHousing!.Objects.OrderBy(l => Document?.FindObject(l.ObjectId)?.Level ?? 0).ToList() : roomHousing!.Objects;
                int? currentLevel = null;
                <div class="bp-hrow-items">
                    @if (roomHousing!.CappedByTier)
                    {
                        <div class="bp-hrow-note bp-excluded">
                            @LocalizationService.GetTranslation("BuildingPlanner.Housing.SoftCapped", roomHousing.TotalBeforeCap.ToString("0.00"), roomHousing.Value.ToString("0.00"),
                                roomHousing.TierVal.ToString("0.##"), roomHousing.TierSoftCap.ToString("0.##"), (1f - roomHousing.Value / roomHousing.TotalBeforeCap).ToString("P0"))
                        </div>
                    }
                    @foreach (var line in lines)
                    {
                        var level = groupByLevel ? Document?.FindObject(line.ObjectId)?.Level ?? 0 : (int?)null;
                        if (level is not null && level != currentLevel)
                        {
                            currentLevel = level;
                            <div class="bp-hrow-item-level">@LevelLabel(level.Value)</div>
                        }
                        <div class="bp-hrow-item">
                            <span class="@("bp-ellipsis" + (line.Excluded ? " bp-excluded" : ""))">@ObjectLabel(line.Type)</span>
                            @if (line.Excluded)
                            {
                                <span class="bp-num bp-excluded">@LocalizationService.GetTranslation("BuildingPlanner.Housing.Ignored", CategoryLabel(roomHousing!.PrimaryCategory))</span>
                            }
                            else
                            {
                                <span class="bp-num">
                                    @line.Value.ToString("0.00")
                                    @if (line.Value < line.BaseValue - 0.005f)
                                    {
                                        <span class="bp-excluded"> (@((line.Value / line.BaseValue).ToString("P0")))</span>
                                        <BuildingPlannerHousingInfos Combined="true" Steps="@HousingBreakdown.ObjectSteps(line, steps, roomHousing!.PrimaryCategory).Where(s => s.Kind is "property" or "repeat")" Catalog="Catalog"/>
                                    }
                                </span>
                            }
                        </div>
                    }
                    @{
                        var raw = lines.Where(l => !l.Excluded).Sum(l => l.Value);
                        var capped = raw > roomHousing!.Value + 0.005f;
                    }
                    <div class="bp-hrow-item bp-hrow-total">
                        <span>@LocalizationService.GetTranslation("BuildingPlanner.Housing.Total")</span>
                        <span class="bp-num">
                            @if (capped) { <span>@raw.ToString("0.00")</span><span class="bp-excluded"> → @roomHousing.Value.ToString("0.00")</span> }
                            else { <span>@roomHousing.Value.ToString("0.00")</span> }
                            <BuildingPlannerHousingInfos Steps="@steps.Where(s => s.Kind == "support")" Catalog="Catalog"/>
                        </span>
                    </div>
                </div>
            }
        </div>;

    private string IssueClass(PlanIssue issue)
    {
        var selected = SelectionKind == "object" ? issue.ObjectId == SelectionId
            : SelectionKind == "room" && issue.ObjectId is null && issue.RoomId == SelectionId;
        return "bp-issue" + issue.Severity switch { IssueSeverity.Error => " error", IssueSeverity.Info => " info", _ => "" } + (selected ? " selected" : "");
    }

    private static string IssueIcon(IssueSeverity severity) => severity switch
    {
        IssueSeverity.Error => Icons.Material.Filled.Error,
        IssueSeverity.Info => Icons.Material.Filled.Info,
        _ => Icons.Material.Filled.Warning,
    };

    private string CategoryLabel(string name) => Catalog?.Categories.FirstOrDefault(c => c.Name == name)?.Label ?? name;
    private float CapPercent(string name) => Catalog?.Categories.FirstOrDefault(c => c.Name == name)?.CapPercent ?? 0f;
    private string ObjectLabel(string type) => Catalog?.Objects.FirstOrDefault(o => o.Name == type)?.Label ?? type;

    private string LevelLabel(int level)
    {
        var name = Document is not null && level < Document.Levels.Count ? Document.Levels[level].Name : "";
        return string.IsNullOrWhiteSpace(name) ? LocalizationService.GetTranslation("BuildingPlanner.Level.Default", Document?.DisplayNumber(level).ToString() ?? "") : name;
    }
}
