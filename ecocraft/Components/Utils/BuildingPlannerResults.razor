@using ecocraft.BuildingPlanner.Model
@using ecocraft.Services
@inject LocalizationService LocalizationService

@* Un volet à la fois (Panel) : le rail et l'entête du volet sont dans BuildingPlannerPage. *@
@switch (Panel)
{
    case "housing":
        @if (Analysis?.Housing is { } housing)
        {
            <div class="bp-score">
                <span class="bp-score-value">@housing.Total.ToString("0.00")</span>
                <span class="bp-muted">@LocalizationService.GetTranslation("BuildingPlanner.Housing.PerDay")</span>
            </div>
            <div class="bp-muted bp-score-sub">
                @LocalizationService.GetTranslation("BuildingPlanner.Housing.BeforeOccupancy"): @housing.TotalBeforeOccupancy.ToString("0.00")
                × @housing.OccupancyMultiplier.ToString("0.###") (@housing.Residents @LocalizationService.GetTranslation("BuildingPlanner.Residents").ToLowerInvariant())
            </div>
            @if (Analysis.HousingRulesAreDefaults)
            {
                <MudAlert Severity="Severity.Info" Dense="true" Class="mt-2">@LocalizationService.GetTranslation("BuildingPlanner.Issue.HousingConfigMissing")</MudAlert>
            }
            <div class="bp-hrows">
                <div class="bp-hrow-head">
                    <span>@LocalizationService.GetTranslation("BuildingPlanner.Inspector.Room")</span>
                    <span>@LocalizationService.GetTranslation("BuildingPlanner.Housing.RoomValue")</span>
                    <span>×</span>
                    <span>@LocalizationService.GetTranslation("BuildingPlanner.Housing.Total")</span>
                </div>
                @foreach (var row in housing.Rooms.OrderByDescending(r => r.Contribution))
                {
                    var entry = Document?.FindRoom(row.RoomId);
                    var roomHousing = Analysis.Rooms.FirstOrDefault(r => r.RoomId == row.RoomId)?.Housing;
                    var expanded = _expandedRooms.Contains(row.RoomId);
                    <div class="bp-hrow" @onclick="@(() => OnFocusRoom.InvokeAsync(row.RoomId))">
                        <div class="bp-hrow-main">
                            <span class="bp-ellipsis"><span class="bp-strong">@(entry?.Room.Name ?? row.RoomId)</span><span class="bp-muted"> · @(entry is { } e ? LevelLabel(e.Level) : "") · @row.Category</span></span>
                            <span class="bp-num">@row.RoomValue.ToString("0.00")</span>
                            <span class="bp-num">@row.Multiplier.ToString("0.##")</span>
                            <span class="bp-num bp-strong">@row.Contribution.ToString("0.00")</span>
                        </div>
                        @if (roomHousing is { Objects.Count: > 0 })
                        {
                            <div class="bp-hrow-sub">
                                <span>
                                    @for (var i = 0; i < roomHousing.Objects.Count; i++)
                                    {
                                        var line = roomHousing.Objects[i];
                                        if (i > 0) { <span> · </span> }
                                        <span class="@(line.Excluded ? "bp-excluded" : null)">
                                            @(Catalog?.Objects.FirstOrDefault(o => o.Name == line.Type)?.Label ?? line.Type) (@line.Category) : @line.Value.ToString("0.00")@(!line.Excluded && line.Multiplier < 0.999f ? $" × {line.Multiplier:0.##}" : "")@(line.Excluded ? $" — {LocalizationService.GetTranslation("BuildingPlanner.Housing.Excluded")}" : "")
                                        </span>
                                    }
                                </span>
                                <span class="bp-link" @onclick:stopPropagation="true" @onclick="@(() => ToggleDetail(row.RoomId))">@LocalizationService.GetTranslation("BuildingPlanner.Results.Detail") @(expanded ? "▾" : "▸")</span>
                            </div>
                            @if (expanded)
                            {
                                <div class="bp-hrow-detail">
                                    @foreach (var (cat, value) in roomHousing.ValueByCategory)
                                    {
                                        <div><b>@cat</b>: @value.ToString("0.00")@(roomHousing.RawValueByCategory.TryGetValue(cat, out var raw) && raw > value + 0.005f ? $" (cap {raw:0.00})" : "")</div>
                                    }
                                    @if (roomHousing.CappedByTier)
                                    {
                                        <div class="bp-excluded">@LocalizationService.GetTranslation("BuildingPlanner.Issue.HousingCapped", roomHousing.TotalBeforeCap.ToString("0.00"), roomHousing.Value.ToString("0.00"), roomHousing.TierSoftCap.ToString("0.##"))</div>
                                    }
                                </div>
                            }
                        }
                    </div>
                }
            </div>
            @foreach (var (cat, before) in housing.CapAppliedByCategory)
            {
                var percent = Catalog?.Categories.FirstOrDefault(c => c.Name == cat)?.CapPercent ?? 0f;
                <div class="bp-excluded bp-caption">@LocalizationService.GetTranslation("BuildingPlanner.Housing.CategoryCapped", cat, housing.ByCategory.GetValueOrDefault(cat).ToString("0.00"), before.ToString("0.00"), percent.ToString("P0"), housing.UncappedTotal.ToString("0.00"))</div>
            }
        }
        else
        {
            <div class="bp-muted">@LocalizationService.GetTranslation("BuildingPlanner.Results.Pending")</div>
        }
        break;

    case "issues":
        @if (Analysis is null)
        {
            <div class="bp-muted">@LocalizationService.GetTranslation("BuildingPlanner.Results.Pending")</div>
        }
        else if (Analysis.Issues.Count == 0)
        {
            <span class="bp-chip ok"><MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small"/>@LocalizationService.GetTranslation("BuildingPlanner.Results.NoIssue")</span>
        }
        else
        {
            var shown = Analysis.Issues.Take(80).ToList();
            foreach (var theme in Themes)
            {
                var group = shown.Where(i => ThemeOf(i.Code) == theme).ToList();
                if (group.Count == 0) continue;
                <div class="bp-theme-title">@LocalizationService.GetTranslation($"BuildingPlanner.Results.Theme.{theme}")</div>
                foreach (var issue in group)
                {
                    <div class="@IssueClass(issue)" @onclick="@(() => OnFocusIssue.InvokeAsync(issue))">
                        <MudIcon Icon="@IssueIcon(issue.Severity)" Size="Size.Small"/>
                        <span class="bp-issue-text">@LocalizationService.GetTranslation($"BuildingPlanner.Issue.{issue.Code}", issue.Args)</span>
                        <MudIcon Icon="@Icons.Material.Filled.CenterFocusStrong" Size="Size.Small" Class="bp-issue-focus"/>
                    </div>
                }
            }
            @if (Analysis.Issues.Count > shown.Count)
            {
                <div class="bp-muted">… +@(Analysis.Issues.Count - shown.Count)</div>
            }
        }
        break;

    case "tables":
        @if (Analysis is { Tables.Count: > 0 })
        {
            <MudSimpleTable Dense="true" Hover="true" Class="bp-table">
                <thead>
                <tr>
                    <th></th>
                    <th>@LocalizationService.GetTranslation("CraftingTable")</th>
                    <th>@LocalizationService.GetTranslation("BuildingPlanner.Inspector.Room")</th>
                    <th style="text-align:right">@LocalizationService.GetTranslation("BuildingPlanner.Tables.Tier")</th>
                    <th style="text-align:right">@LocalizationService.GetTranslation("BuildingPlanner.Tables.Volume")</th>
                </tr>
                </thead>
                <tbody>
                @foreach (var t in Analysis.Tables)
                {
                    <tr>
                        <td><MudIcon Icon="@(t.Satisfied ? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.Error)" Color="@(t.Satisfied ? Color.Success : (t.TierOk && !t.ModulesOk ? Color.Warning : Color.Error))" Size="Size.Small"/></td>
                        <td>@(Catalog?.Objects.FirstOrDefault(o => o.Name == t.Type)?.Label ?? t.Type)</td>
                        <td>@(t.RoomId is null ? "—" : RoomLabel(t.RoomId))</td>
                        <td style="text-align:right; white-space: nowrap;">
                            <span style="@(t.TierOk ? "" : "color: var(--mud-palette-error)")">@t.RoomTier.ToString("0.00") / @(t.EffectiveTier?.ToString("0.00") ?? "—")</span>
                            @if (t.TierOk && !t.ModulesOk) { <MudIcon Icon="@Icons.Material.Filled.Extension" Color="Color.Warning" Size="Size.Small" Title="@LocalizationService.GetTranslation("BuildingPlanner.Tables.ModulesInactive")"/> }
                        </td>
                        <td style="text-align:right; white-space: nowrap; @(t.VolumeOk ? "" : "color: var(--mud-palette-error)")">@t.RoomVolumeUsed / @t.RoomVolume</td>
                    </tr>
                }
                </tbody>
            </MudSimpleTable>
        }
        else
        {
            <div class="bp-muted">@LocalizationService.GetTranslation("BuildingPlanner.Tables.None")</div>
        }
        break;

    case "materials":
        @if (Analysis is not null && Analysis.Materials.Count > 0)
        {
            <MudSimpleTable Dense="true" Hover="true" Class="bp-table">
                <thead>
                <tr>
                    <th>@LocalizationService.GetTranslation("BuildingPlanner.Material")</th>
                    <th style="text-align:right">@LocalizationService.GetTranslation("BuildingPlanner.Materials.Walls")</th>
                    <th style="text-align:right">@LocalizationService.GetTranslation("BuildingPlanner.Materials.Floors")</th>
                    <th style="text-align:right">@LocalizationService.GetTranslation("BuildingPlanner.Materials.Ceilings")</th>
                    <th style="text-align:right">@LocalizationService.GetTranslation("BuildingPlanner.Materials.Total")</th>
                </tr>
                </thead>
                <tbody>
                @foreach (var m in Analysis.Materials)
                {
                    <tr>
                        <td>@(Catalog?.Materials.FirstOrDefault(x => x.Name == m.Material)?.Label ?? m.Material)</td>
                        <td style="text-align:right">@m.Walls</td>
                        <td style="text-align:right">@m.Floors</td>
                        <td style="text-align:right">@m.Ceilings</td>
                        <td style="text-align:right"><b>@m.Total</b></td>
                    </tr>
                }
                </tbody>
            </MudSimpleTable>
        }
        else
        {
            <div class="bp-muted">@LocalizationService.GetTranslation("BuildingPlanner.Results.Pending")</div>
        }
        break;

    case "assumptions":
        <ul class="bp-assumptions">
            @foreach (var key in AssumptionKeys)
            {
                <li>@LocalizationService.GetTranslation($"BuildingPlanner.Assumptions.{key}")</li>
            }
        </ul>
        break;
}

@code {
    [Parameter] public string Panel { get; set; } = "housing";
    [Parameter] public PlanDocument? Document { get; set; }
    [Parameter] public AnalysisResult? Analysis { get; set; }
    [Parameter] public ClientCatalog? Catalog { get; set; }
    [Parameter] public string? SelectionKind { get; set; }
    [Parameter] public string? SelectionId { get; set; }
    [Parameter] public EventCallback<PlanIssue> OnFocusIssue { get; set; }
    [Parameter] public EventCallback<string> OnFocusRoom { get; set; }

    private readonly HashSet<string> _expandedRooms = [];

    private static readonly string[] AssumptionKeys =
    [
        "EmptyEdges", "Holes", "Levels", "Paint", "Pollution", "Culture", "Deed", "Efficiency", "Talents", "Modules", "Terrain", "Rotations", "Forms", "Tie",
    ];

    // Regroupement des avertissements par thème ; tout code absent tombe dans « Données » (validation, placement, références).
    private static readonly string[] Themes = ["Rooms", "Housing", "Tables", "Data"];

    private static readonly Dictionary<string, string> IssueTheme = new(StringComparer.Ordinal)
    {
        ["RoomSeedInWall"] = "Rooms", ["RoomNotEnclosed2D"] = "Rooms", ["RoomsShareSpace"] = "Rooms", ["MissingFloor"] = "Rooms", ["RoomTallerThanLevel"] = "Rooms",
        ["MissingCeilingMaterial"] = "Rooms", ["CeilingConflict"] = "Rooms", ["DiagonalGap"] = "Rooms", ["NoRoomDefined"] = "Rooms", ["NoSupportBelow"] = "Rooms",
        ["RoomTooBig"] = "Rooms", ["NoCeiling"] = "Rooms", ["VolumeTooSmall"] = "Rooms", ["RoomInvalid"] = "Rooms", ["EmptyEdges"] = "Rooms",
        ["BuildingTooHigh"] = "Rooms", ["TooManyRooms"] = "Rooms", ["SeedOutOfGrid"] = "Rooms",
        ["HousingNegated"] = "Housing", ["HousingObjectExcluded"] = "Housing", ["PrimaryCategoryTie"] = "Housing", ["HousingCapped"] = "Housing",
        ["HousingConfigMissing"] = "Housing", ["DefaultOccupancy"] = "Housing", ["UnknownHousingCategory"] = "Housing", ["UnknownLockCategory"] = "Housing",
        ["TableNotInRoom"] = "Tables", ["TableNotContained"] = "Tables", ["TableTierTooLow"] = "Tables", ["TableModulesInactive"] = "Tables", ["TableVolumeExceeded"] = "Tables",
    };

    private static string ThemeOf(string code) => IssueTheme.GetValueOrDefault(code, "Data");

    private string IssueClass(PlanIssue issue)
    {
        var selected = SelectionKind == "object" ? issue.ObjectId == SelectionId
            : SelectionKind == "room" && issue.ObjectId is null && issue.RoomId == SelectionId;
        return "bp-issue" + issue.Severity switch { IssueSeverity.Error => " error", IssueSeverity.Info => " info", _ => "" } + (selected ? " selected" : "");
    }

    private static string IssueIcon(IssueSeverity severity) => severity switch
    {
        IssueSeverity.Error => Icons.Material.Filled.Error,
        IssueSeverity.Info => Icons.Material.Filled.Info,
        _ => Icons.Material.Filled.Warning,
    };

    private void ToggleDetail(string roomId)
    {
        if (!_expandedRooms.Remove(roomId)) _expandedRooms.Add(roomId);
    }

    private string LevelLabel(int level)
    {
        var name = Document is not null && level < Document.Levels.Count ? Document.Levels[level].Name : "";
        return string.IsNullOrWhiteSpace(name) ? LocalizationService.GetTranslation("BuildingPlanner.Level.Default", Document?.DisplayNumber(level).ToString() ?? "") : name;
    }

    // Nom de pièce préfixé par son niveau dès qu'il y a plusieurs niveaux.
    private string RoomLabel(string roomId)
    {
        var entry = Document?.FindRoom(roomId);
        if (entry is null || Document is null) return roomId;
        if (Document.Levels.Count <= 1) return entry.Value.Room.Name;
        return $"{LevelLabel(entry.Value.Level)} · {entry.Value.Room.Name}";
    }
}
