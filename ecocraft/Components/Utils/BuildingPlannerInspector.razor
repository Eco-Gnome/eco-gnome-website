@using ecocraft.BuildingPlanner
@using ecocraft.BuildingPlanner.Model
@using ecocraft.Services
@inject LocalizationService LocalizationService
@inject ContextService ContextService

@* Fiche de sélection, même trame pour une pièce et un objet : identité + statut, tier, emplacement, réglages, puis lignes conditionnelles. *@
<div class="bp-insp">
    @if (SelectedRoom is { } roomEntry)
    {
        var room = roomEntry.Room;
        var analysis = Analysis?.Rooms.FirstOrDefault(r => r.RoomId == room.Id);
        <div class="bp-insp-row bp-insp-ident">
            <MudTextField T="string" Value="@room.Name" ValueChanged="@(v => RoomChanged(room, r => r.Name = v))" Dense="true" Margin="Margin.Dense" Variant="Variant.Outlined"
                          Label="@LocalizationService.GetTranslation("Name")" Class="bp-insp-namefield"/>
            @if (analysis is not null)
            {
                <MudTooltip Text="@(analysis.Contained ? null : LocalizationService.GetTranslation($"BuildingPlanner.Issue.{analysis.FailCode ?? "RoomInvalid"}", analysis.Name, analysis.FailHeight?.ToString() ?? ""))">
                    <MudChip T="string" Size="Size.Small" Color="@(analysis.Contained ? Color.Success : Color.Error)" Icon="@(analysis.Contained ? Icons.Material.Filled.Check : Icons.Material.Filled.Close)">
                        @LocalizationService.GetTranslation(analysis.Contained ? "BuildingPlanner.Inspector.Contained" : "BuildingPlanner.Inspector.NotContained")
                    </MudChip>
                </MudTooltip>
            }
        </div>
        @if (analysis is { Contained: true })
        {
            <div class="bp-insp-muted">
                @LocalizationService.GetTranslation("BuildingPlanner.Inspector.Tier") @analysis.AverageTier.ToString("0.00")
                · @string.Join(", ", analysis.WallTierComposition.OrderBy(k => k.Key).Select(k => $"T{k.Key:0.#} × {k.Value}"))
            </div>
        }
        <div class="bp-insp-muted">
            @LevelLabel(roomEntry.Level)
            @if (analysis?.Housing is { } cat) { <span> · @CategoryLabel(cat.PrimaryCategory)</span> }
            @if (analysis is { Contained: true }) { <span> · @analysis.RequiredVolumeTotal / @analysis.Volume m³</span> }
        </div>
        @if (analysis?.Housing is { } housing)
        {
            var steps = HousingBreakdown.RoomSteps(housing, Analysis?.Housing, room.Id, CapPercent);
            var effective = housing.Value * HousingBreakdown.RoomFactor(steps);
            <div class="bp-insp-muted">
                @LocalizationService.GetTranslation("BuildingPlanner.Results.Housing") : <b>@housing.Value.ToString("0.00")</b>
                @if (effective < housing.Value - 0.005f) { <span class="bp-insp-warn"> → @effective.ToString("0.00")</span> }
                <BuildingPlannerHousingInfos Steps="steps" Catalog="Catalog"/>
            </div>
        }
        <div class="bp-insp-row">
            <MudNumericField T="int?" Value="@room.Height" ValueChanged="@(v => RoomChanged(room, r => r.Height = v is { } h ? Math.Clamp(h, 1, 50) : null))" Min="1" Max="50" Clearable="true" Dense="true" Margin="Margin.Dense" Variant="Variant.Outlined"
                             Placeholder="@Document?.LevelHeight(roomEntry.Level).ToString()" Label="@LocalizationService.GetTranslation("BuildingPlanner.Inspector.Height")" Class="bp-insp-half"/>
            <MudSelect T="string" Value="@(room.CeilingMaterial ?? "")" ValueChanged="@(v => RoomChanged(room, r => r.CeilingMaterial = string.IsNullOrEmpty(v) ? null : v))" Dense="true" Margin="Margin.Dense" Variant="Variant.Outlined"
                       Label="@LocalizationService.GetTranslation("BuildingPlanner.Defaults.Ceiling")" Class="bp-insp-half">
                <MudSelectItem T="string" Value="@("")">@LocalizationService.GetTranslation("BuildingPlanner.Inspector.DefaultMaterial")</MudSelectItem>
                @foreach (var m in Catalog?.Materials ?? [])
                {
                    <MudSelectItem T="string" Value="@m.Name">
                        <MudStack Row AlignItems="AlignItems.Center" Spacing="1">
                            <MudImage Src="@($"/assets/eco-icons/{m.Name}.png?serverId={ContextService.CurrentServer?.Id}")" FallbackSrc="/assets/eco-icons/EmptyIcon.png" Width="20" Height="20"/>
                            <span>@m.Label</span>
                            <MudChip T="string" Size="Size.Small" Color="Color.Default" Class="ml-auto">T@(m.Tier)</MudChip>
                        </MudStack>
                    </MudSelectItem>
                }
            </MudSelect>
        </div>
        @if (analysis is { Contained: true, EmptyEdgeCount: > 0 })
        {
            <div class="bp-insp-warn">@LocalizationService.GetTranslation("BuildingPlanner.Issue.EmptyEdges", analysis.Name, analysis.EmptyEdgeCount.ToString(), analysis.AverageTierWithoutEmptyEdges.ToString("0.00"))</div>
        }
    }
    else if (SelectedObject is { } objectEntry)
    {
        var obj = objectEntry.Object;
        var info = Catalog?.Objects.FirstOrDefault(o => o.Name == obj.Type);
        var placed = Analysis?.Objects.FirstOrDefault(o => o.Id == obj.Id);
        var table = Analysis?.Tables.FirstOrDefault(t => t.ObjectId == obj.Id);
        // Hors de toute pièce, un objet housing compte dans la pièce « Extérieur » du deed.
        var outdoors = placed is { Placed: true, RoomId: null } && Analysis?.OutdoorHousing?.Objects.Any(l => l.ObjectId == obj.Id) == true;
        var housingRoomId = outdoors ? PlanAnalyzer.OutdoorRoomId : placed?.RoomId;
        var roomHousing = outdoors ? Analysis!.OutdoorHousing : placed?.RoomId is { } roomId ? Analysis?.Rooms.FirstOrDefault(r => r.RoomId == roomId)?.Housing : null;
        var housingLine = roomHousing?.Objects.FirstOrDefault(l => l.ObjectId == obj.Id);
        var roomName = outdoors ? LocalizationService.GetTranslation("BuildingPlanner.Housing.Outdoor") : placed?.RoomId is { } rid ? Document?.FindRoom(rid)?.Room.Name : null;
        <div class="bp-insp-row bp-insp-ident">
            <MudImage Src="@($"/assets/eco-icons/{obj.Type}.png?serverId={ContextService.CurrentServer?.Id}")" FallbackSrc="/assets/eco-icons/EmptyIcon.png" Width="32" Height="32"/>
            <span class="bp-insp-name">@(info?.Label ?? obj.Type)</span>
            @if (placed is not null)
            {
                <MudChip T="string" Size="Size.Small" Color="@(!placed.Placed ? Color.Error : outdoors || placed.RoomId is null ? Color.Warning : Color.Success)">
                    @LocalizationService.GetTranslation(!placed.Placed ? "BuildingPlanner.Inspector.NotPlaced" : outdoors ? "BuildingPlanner.Housing.Outdoor" : placed.RoomId is null ? "BuildingPlanner.Inspector.NoRoom" : "BuildingPlanner.Inspector.Placed")
                </MudChip>
            }
            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" Class="bp-insp-delete" OnClick="OnDeleteSelection"/>
        </div>
        @if (table is not null)
        {
            <div class="@(table.TierOk ? "bp-insp-ok" : "bp-insp-bad")">
                @LocalizationService.GetTranslation("BuildingPlanner.Tables.Tier") @table.RoomTier.ToString("0.00") / @(table.EffectiveTier?.ToString("0.00") ?? "-")
                @if (table.ModuleBump > 0) { <span> (@table.BaseTier?.ToString("0.##") + @table.ModuleBump.ToString("0.##"))</span> }
                @if (table.TierOk && !table.ModulesOk) { <span> — @LocalizationService.GetTranslation("BuildingPlanner.Tables.ModulesInactive")</span> }
            </div>
        }
        else if (info?.Tier is { } tier)
        {
            <div class="bp-insp-muted">@LocalizationService.GetTranslation("BuildingPlanner.Inspector.Tier") @tier</div>
        }
        <div class="bp-insp-muted">
            (@obj.X, @obj.Y) · @LevelLabel(objectEntry.Level)@(roomName is not null ? $" · {roomName}" : "")
            @if (table is { RoomId: not null }) { <span> · </span><span class="@(table.VolumeOk ? null : "bp-insp-bad")">@table.RoomVolumeUsed / @table.RoomVolume m³</span> }
        </div>
        <div class="bp-insp-row">
            @if (obj.AttachedTo is null)
            {
                <MudButton Size="Size.Small" Variant="Variant.Outlined" StartIcon="@MDIIcons.Filled.RotateRight" OnClick="@(() => ObjectChanged(obj, o => o.Rotation = (o.Rotation + 1) & 3))">r@(obj.Rotation)</MudButton>
                <MudNumericField T="int?" Value="@obj.Z" ValueChanged="@(v => ObjectChanged(obj, o => o.Z = v))" Min="0" Max="60" Dense="true" Margin="Margin.Dense" Variant="Variant.Outlined" Clearable="true"
                                 Label="@LocalizationService.GetTranslation("BuildingPlanner.Inspector.Z")" Class="bp-insp-z"/>
            }
            else
            {
                <MudChip T="string" Size="Size.Small" Color="Color.Secondary">@LocalizationService.GetTranslation("BuildingPlanner.Inspector.AttachedTo", ParentLabel(obj.AttachedTo))</MudChip>
            }
        </div>
        @if (info is null)
        {
            <MudChip T="string" Size="Size.Small" Color="Color.Warning">@LocalizationService.GetTranslation("BuildingPlanner.Inspector.UnknownType")</MudChip>
        }
        else if (info.HousingCategory is not null)
        {
            @* Chaîne de CET objet : valeur catalogue, puis « → valeur finale » orange dès que le jeu l'a réduite, un seul « i » listant
               chaque réduction (répétition, soutien, tier, rang, catégorie, ou ignoré) ; enfin la valeur de la pièce. *@
            var steps = roomHousing is null || housingRoomId is null ? [] : HousingBreakdown.RoomSteps(roomHousing, Analysis?.Housing, housingRoomId, CapPercent);
            <div class="bp-insp-muted">
                <span>@CategoryLabel(info.HousingCategory)&nbsp;</span>
                @if (housingLine is null) { <span> +@(info.HousingValue?.ToString("0.##") ?? "?")</span> }
                else
                {
                    var final = HousingBreakdown.ObjectFinal(housingLine, steps);
                    <span> <b>@housingLine.BaseValue.ToString("0.00")</b></span>
                    if (final < housingLine.BaseValue - 0.005f)
                    {
                        <span class="bp-insp-warn"> → @final.ToString("0.00")</span>
                        <BuildingPlannerHousingInfos Combined="true" Steps="@HousingBreakdown.ObjectSteps(housingLine, steps, roomHousing!.PrimaryCategory)" Catalog="Catalog"/>
                    }
                }
            </div>
            @if (roomHousing is not null)
            {
                var effective = roomHousing.Value * HousingBreakdown.RoomFactor(steps);
                <div class="bp-insp-muted">
                    @LocalizationService.GetTranslation("BuildingPlanner.Inspector.Room") : @CategoryLabel(roomHousing.PrimaryCategory) <b>@roomHousing.Value.ToString("0.00")</b>
                    @if (effective < roomHousing.Value - 0.005f) { <span class="bp-insp-warn"> → @effective.ToString("0.00")</span> }
                </div>
            }
        }
        @if (table is { RequiresContainment: true })
        {
            <div class="@(table.ContainmentOk ? "bp-insp-ok" : "bp-insp-bad")">@LocalizationService.GetTranslation("BuildingPlanner.Tables.Containment")</div>
        }
    }
    else if (SelectedOp is { } op)
    {
        @* Forme du mode architecture : type + ajout/soustraction, matériau, creux/épaisseur (+ axe du cylindre), boîte englobante A..B. *@
        var geometric = op.Kind is "box" or "sphere" or "cylinder";
        <div class="bp-insp-row bp-insp-ident">
            <MudIcon Icon="@KindIcon(op.Kind)" Size="Size.Small"/>
            <span class="bp-insp-name">@LocalizationService.GetTranslation($"BuildingPlanner.Shape.Kind.{op.Kind}")</span>
            <MudChip T="string" Size="Size.Small" Color="@(op.Subtract ? Color.Warning : Color.Primary)" Variant="Variant.Text">@LocalizationService.GetTranslation(op.Subtract ? "BuildingPlanner.Shape.Subtract" : "BuildingPlanner.Shape.Add")</MudChip>
            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" Class="bp-insp-delete" OnClick="OnDeleteSelection"/>
        </div>
        <div class="bp-insp-row">
            <MudToggleGroup T="bool" Value="@op.Subtract" ValueChanged="@(v => OpChanged(op, o => { o.Subtract = v; if (v) o.Material = null; else o.Material ??= Catalog?.Materials.FirstOrDefault()?.Name; }))" SelectionMode="SelectionMode.SingleSelection" Color="Color.Primary" Size="Size.Small" Outlined="true" CheckMark="false">
                <MudToggleItem T="bool" Value="false"><MudIcon Icon="@Icons.Material.Filled.Add" Size="Size.Small"/></MudToggleItem>
                <MudToggleItem T="bool" Value="true"><MudIcon Icon="@Icons.Material.Filled.Remove" Size="Size.Small"/></MudToggleItem>
            </MudToggleGroup>
            @if (!op.Subtract)
            {
                <MudSelect T="string" Value="@(op.Material ?? "")" ValueChanged="@(v => OpChanged(op, o => o.Material = string.IsNullOrEmpty(v) ? null : v))" Dense="true" Margin="Margin.Dense" Variant="Variant.Outlined"
                           Label="@LocalizationService.GetTranslation("BuildingPlanner.Material")" Class="bp-insp-half">
                    @foreach (var m in Catalog?.Materials ?? [])
                    {
                        <MudSelectItem T="string" Value="@m.Name">
                            <MudStack Row AlignItems="AlignItems.Center" Spacing="1">
                                <MudImage Src="@($"/assets/eco-icons/{m.Name}.png?serverId={ContextService.CurrentServer?.Id}")" FallbackSrc="/assets/eco-icons/EmptyIcon.png" Width="20" Height="20"/>
                                <span>@m.Label</span>
                                <MudChip T="string" Size="Size.Small" Color="Color.Default" Class="ml-auto">T@(m.Tier)</MudChip>
                            </MudStack>
                        </MudSelectItem>
                    }
                </MudSelect>
            }
        </div>
        @if (geometric)
        {
            <div class="bp-insp-row">
                <MudCheckBox T="bool" Value="@op.Hollow" ValueChanged="@(v => OpChanged(op, o => o.Hollow = v))" Dense="true" Size="Size.Small" Label="@LocalizationService.GetTranslation("BuildingPlanner.Shape.Hollow")"/>
                <MudNumericField T="int" Value="@op.Thickness" ValueChanged="@(v => OpChanged(op, o => o.Thickness = Math.Clamp(v, 1, 10)))" Min="1" Max="10" Disabled="!op.Hollow" Dense="true" Margin="Margin.Dense" Variant="Variant.Outlined"
                                 Label="@LocalizationService.GetTranslation("BuildingPlanner.Shape.Thickness")" Class="bp-insp-z"/>
                @if (op.Kind == "cylinder")
                {
                    <MudSelect T="string" Value="@(op.Axis ?? "z")" ValueChanged="@(v => OpChanged(op, o => o.Axis = v == "z" ? null : v))" Dense="true" Margin="Margin.Dense" Variant="Variant.Outlined"
                               Label="@LocalizationService.GetTranslation("BuildingPlanner.Shape.Axis")" Class="bp-insp-z">
                        <MudSelectItem T="string" Value="@("z")">z</MudSelectItem>
                        <MudSelectItem T="string" Value="@("x")">x</MudSelectItem>
                        <MudSelectItem T="string" Value="@("y")">y</MudSelectItem>
                    </MudSelect>
                }
            </div>
        }
        @if (op.Kind == "cells")
        {
            <div class="bp-insp-muted">@LocalizationService.GetTranslation("BuildingPlanner.Shape.Cells", ((op.Cells?.Length ?? 0) / 3).ToString())</div>
        }
        else if (op.A is { Length: 3 } && op.B is { Length: 3 })
        {
            <div class="bp-insp-geom">
                @for (var i = 0; i < 3; i++)
                {
                    var k = i;
                    <MudNumericField T="int" Value="@op.A[k]" ValueChanged="@(v => OpChanged(op, o => o.A![k] = v))" Dense="true" Margin="Margin.Dense" Variant="Variant.Outlined" Label="@($"{"xyz"[k]}0")"/>
                }
                @for (var i = 0; i < 3; i++)
                {
                    var k = i;
                    <MudNumericField T="int" Value="@op.B[k]" ValueChanged="@(v => OpChanged(op, o => o.B![k] = v))" Dense="true" Margin="Margin.Dense" Variant="Variant.Outlined" Label="@($"{"xyz"[k]}1")"/>
                }
            </div>
        }
    }
    else
    {
        <div class="bp-insp-empty">@LocalizationService.GetTranslation("BuildingPlanner.Inspector.NothingSelected")</div>
    }
</div>

@code {
    [Parameter] public PlanDocument? Document { get; set; }
    [Parameter] public AnalysisResult? Analysis { get; set; }
    [Parameter] public ClientCatalog? Catalog { get; set; }
    [Parameter] public string? SelectionKind { get; set; }
    [Parameter] public string? SelectionId { get; set; }
    [Parameter] public EventCallback<PlanRoom> OnRoomChanged { get; set; }
    [Parameter] public EventCallback<PlanObject> OnObjectChanged { get; set; }
    [Parameter] public EventCallback<ArchOp> OnOpChanged { get; set; }
    [Parameter] public EventCallback OnDeleteSelection { get; set; }

    private (int Level, PlanRoom Room)? SelectedRoom => SelectionKind == "room" ? Document?.FindRoom(SelectionId) : null;
    private (int Level, PlanObject Object)? SelectedObject => SelectionKind == "object" ? Document?.FindObject(SelectionId) : null;
    private ArchOp? SelectedOp => SelectionKind == "op" ? Document?.Architecture.Ops.FirstOrDefault(o => o.Id == SelectionId) : null;

    private static string KindIcon(string kind) => kind switch
    {
        "sphere" => MDIIcons.Filled.Sphere,
        "cylinder" => MDIIcons.Filled.Cylinder,
        "line" => MDIIcons.Filled.VectorLine,
        "cells" => MDIIcons.Filled.Pencil,
        _ => MDIIcons.Filled.Cube,
    };

    private async Task OpChanged(ArchOp op, Action<ArchOp> mutate)
    {
        var copy = new ArchOp { Id = op.Id, Kind = op.Kind, Subtract = op.Subtract, Material = op.Material, A = op.A?.ToArray(), B = op.B?.ToArray(), Axis = op.Axis, Hollow = op.Hollow, Thickness = op.Thickness, Cells = op.Cells };
        mutate(copy);
        await OnOpChanged.InvokeAsync(copy);
    }

    private string CategoryLabel(string name) => Catalog?.Categories.FirstOrDefault(c => c.Name == name)?.Label ?? name;
    private float CapPercent(string name) => Catalog?.Categories.FirstOrDefault(c => c.Name == name)?.CapPercent ?? 0f;

    private string LevelLabel(int level)
    {
        var name = Document is not null && level < Document.Levels.Count ? Document.Levels[level].Name : "";
        return string.IsNullOrWhiteSpace(name) ? LocalizationService.GetTranslation("BuildingPlanner.Level.Default", Document?.DisplayNumber(level).ToString() ?? "") : name;
    }

    private async Task RoomChanged(PlanRoom room, Action<PlanRoom> mutate)
    {
        var copy = new PlanRoom { Id = room.Id, Name = room.Name, Seed = new GridPoint { X = room.Seed.X, Y = room.Seed.Y }, Height = room.Height, CeilingMaterial = room.CeilingMaterial, LockCategory = room.LockCategory };
        mutate(copy);
        await OnRoomChanged.InvokeAsync(copy);
    }

    private async Task ObjectChanged(PlanObject obj, Action<PlanObject> mutate)
    {
        var copy = new PlanObject { Id = obj.Id, Type = obj.Type, X = obj.X, Y = obj.Y, Z = obj.Z, Rotation = obj.Rotation, AttachedTo = obj.AttachedTo };
        mutate(copy);
        await OnObjectChanged.InvokeAsync(copy);
    }

    private string ParentLabel(string parentId)
    {
        var parent = Document?.FindObject(parentId)?.Object;
        if (parent is null) return parentId;
        return Catalog?.Objects.FirstOrDefault(o => o.Name == parent.Type)?.Label ?? parent.Type;
    }
}
